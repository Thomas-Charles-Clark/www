@model BaseViewModel
@{
    var objMaster = Model.MasterDefinition;
    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;

    var tradeUser = objMaster.TradeAllowed;

    var isCheckoutPage = objMaster.UrlBreakdown.ContentId == (int)dgFixedPage.checkoutSinglePage && objMaster.UrlBreakdown.ContentType == dgContentType.landingPage;

}<div class="modal fade" tabindex="-1" id="back-in-stock-success-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @HtmlHelperExtra.Resource("BISRAnchorText", l, c, d)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    @HtmlHelperExtra.Resource("BISRSuccess1", l, c, d)
                </p>
                <p class="mb-0">
                    @HtmlHelperExtra.Resource("BISRSuccess2", l, c, d)
                </p>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" id="back-in-stock-login-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @HtmlHelperExtra.Resource("BISRHeader", l, c, d)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    @HtmlHelperExtra.Resource("BISRLoginMessage", l, c, d)
                </p>
                <div class="grid" style="--bs-columns: 2">
                    <div>
                        <p class="text-center">
                            @HtmlHelperExtra.Resource("BISRExistingCustomers", l, c, d)
                        </p>
                        <a class="btn btn-secondary w-100 text-center" rel="nofollow" href="@dgFramework.buildLoginRedirectToCurrentUrl(ci, objMaster.UrlBreakdown.ContentType, objMaster.UrlBreakdown.ContentId)">
                            @HtmlHelperExtra.Resource("BISRLogInToCreate", l, c, d)
                        </a>
                    </div>
                    <div>
                        <p class="text-center">
                            @HtmlHelperExtra.Resource("BISRNewCustomers", l, c, d)
                        </p>
                        <a class="btn btn-secondary w-100 text-center" rel="nofollow" href="@dgFramework.buildRegisterRedirectToCurrentUrl(ci, objMaster.UrlBreakdown.ContentType, objMaster.UrlBreakdown.ContentId)">
                            @HtmlHelperExtra.Resource("BISRRegisterToCreate", l, c, d)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" id="confirm-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button class="btn btn-dark" onclick="window.confirmModalInstance.confirmFn()">
                    @HtmlHelperExtra.Resource("Yes", l, c, d)
                </button>
                <button class="btn btn-light" onclick="window.confirmModalInstance.rejectFn()">
                    @HtmlHelperExtra.Resource("No", l, c, d)
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" id="info-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="window.infoModalInstance.closeFn()">
                    @HtmlHelperExtra.Resource("Ok", l, c, d)
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" id="error-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @HtmlHelperExtra.Resource("Error", l, c, d)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    @HtmlHelperExtra.Resource(isCheckoutPage ? "MajorErrorCheckout" : tradeUser ? "MajorErrorTrade" : "MajorError", l, c, d)
                </p>
                @if (isCheckoutPage)
                {
                    <button class="btn btn-secondary mt-3 w-100" onclick="window.location.reload();">
                        @HtmlHelperExtra.Resource("ReloadPage", l, c, d)
                    </button>
                }
            </div>
        </div>
    </div>
</div>
