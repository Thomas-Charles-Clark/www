@model BaseViewModel
@{
    Layout = null;

    var l = Model.MasterDefinition.UrlBreakdown.countryDetails.LanguageID;
    var c = Model.MasterDefinition.UrlBreakdown.countryDetails.CountryID;
    var d = Model.MasterDefinition.UrlBreakdown.ContentDate;
    var ci = Model.MasterDefinition.UrlBreakdown.countryDetails;

    var productionVersion = System.Convert.ToBoolean(System.Web.Configuration.WebConfigurationManager.AppSettings["productionVersion"]);
}
@* Facebook - excluded from Stockists Search 11/09/2024 *@
@if (productionVersion &&
        !(Model.MasterDefinition.UrlBreakdown.ContentType == dgContentType.landingPage && Model.MasterDefinition.UrlBreakdown.ContentId == (int)dgFixedPage.stockists)
    )
{
    <script type="text/javascript" defer>
        window.fbAsyncInit = function () {
            FB.init({
                appId: '126957360806775',
                autoLogAppEvents: true,
                xfbml: true,
                version: 'v14.0'
            });
            if (typeof window.onFBLoad === 'function') {
                window.onFBLoad();
            }
        };
        window.addFBLoadFunction = (fnc) => {
            let prevFn = window.onFBLoad;
            if (typeof prevFn != 'function') {
                window.onFBLoad = fnc;
            } else {
                window.onFBLoad = function () {
                    if (prevFn) {
                        prevFn();
                    }
                    fnc();
                }
            }
        }
        window.facebookShare = (href) => {
            if (typeof FB === 'object' && typeof FB.ui === 'function') {
                FB.ui({
                    method: 'share',
                    href: href,
                    display: 'popup'
                });
            } else {
                window.addFBLoadFunction(() => {
                    FB.ui({
                        method: 'share',
                        href: href,
                        display: 'popup'
                    });
                });
            }
        }
    </script>
    <script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js"></script>

    <!-- Facebook Pixel Code -->
    <script defer>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window,document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');

    fbq('init', '1799503006991805');

    @* Austraian FB Tracking *@
    @if(c == 16)
    {
        @:fbq('init', '1594649567334727');
    }

    @* NZ FB Tracking *@
    @if (c == 175)
    {
        @:fbq('init', '475096029795002');
    }

    fbq('track', 'PageView');
    </script>
    <!-- End Facebook Pixel Code -->
}

