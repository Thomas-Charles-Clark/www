<nav id="main-menu"
     class="navbar menu-navbar"
     role="navigation">
    <ul class="container px-0">
        @foreach (var group in objMenu.menuGroups.Where(p => p.MenuID != 0).OrderBy(p => p.SortOrder))
        {
            @BuildMenuGroup(Model, group)
        }
        <li class="underlay"></li>
    </ul>
</nav>
@Render.Script("~/bundles/js/menu-scripts")
@helper BuildMenuGroup(BaseViewModel model, menuGroup group) 
{
    var objMenu = model.MasterDefinition.Menu;

    var l = model.MasterDefinition.UrlBreakdown.countryDetails.LanguageID;
    var c = model.MasterDefinition.UrlBreakdown.countryDetails.CountryID;
    var d = model.MasterDefinition.UrlBreakdown.ContentDate;
    var ci = model.MasterDefinition.UrlBreakdown.countryDetails;

    var children = objMenu.menuItems.Where(p => p.MenuID == group.MenuID)
                                    .OrderBy(p => p.SortOrder)
                                    .ToList();
    
    if (!children.Any())
    {
        <li>
            @if (!String.IsNullOrEmpty(group.Name))
            {
                <a id="menu-@(group.MenuID)"
                   class="nav-link @group.FontClass"
                   aria-label="@(group.Name)"
                   href="@Framework.URLFixup((group.FontClass == "menu-spacer" ? "javascript:;" :
                    $"{group.FinalURL(ci.URL)}"))"
                   target="@(group.NewWindow ? "_blank" : "_self")"
                   onclick="@(group.TrackExternalURL ? "return trackOutbound(this);" : "")"
                   rel="@(group.NoFollow ? "nofollow noopener" : "")">
                    @(group.Name)
                </a>
            }
            else
            {
                <span id="menu-@(group.MenuID)" class="nav-link @group.FontClass"></span>
            }
        </li>
    }
    else
    {
        <li>
            <a  id="menu-@(group.MenuID)"
                class="nav-link @group.FontClass"
                href="@Framework.URLFixup(group.FinalURL(ci.URL) ?? "javascript:;")"
                target="@(group.NewWindow ? "_blank" : "_self")"
                onmouseenter="this.focus()"
                onmouseout="this.blur()"
                onclick="@(group.TrackExternalURL ? "return trackOutbound(this);" : "")"
                rel="@(group.NoFollow ? "nofollow noopener" : "")">
                @(group.Name)
            </a>
            <div>
                @{
                    var columns = children.GroupBy(ch => ch.Column).OrderBy(ch => ch.Key);
                }
                <div class="container grid sub-menu-grid px-0" style="--bs-columns: @(columns.Count())">
                   @foreach(var column in columns)
                    {
                        @BuildMenuColumn(model, column)
                    }
                </div>
                @if (group.HasMessageHTML)
                {
                    <div class="container">
                        <div class="menu-message mt-3">
                            @Html.Raw(group.MessageHTML)
                        </div>
                    </div>
                }
            </div>
        </li>
    }
}

@helper BuildMenuColumn(BaseViewModel model, IGrouping<byte, menuItem> column)
{
    <ul id="column-@(column.Key)">
        @foreach (var menuItem in column) 
        {
            @BuildMenuItem(model, menuItem)
        }
    </ul>
}

@helper BuildMenuItem(BaseViewModel model, menuItem item)
{
    var objMenu = model.MasterDefinition.Menu;

    var l = model.MasterDefinition.UrlBreakdown.countryDetails.LanguageID;
    var c = model.MasterDefinition.UrlBreakdown.countryDetails.CountryID;
    var d = model.MasterDefinition.UrlBreakdown.ContentDate;
    var ci = model.MasterDefinition.UrlBreakdown.countryDetails;

    if (item.BannerLocationID == null)
    {
        <li>
           @if (!String.IsNullOrEmpty(item.Name))
            {
                <a id="menu-item-@(item.MenuItemID)"
                   class="nav-link @item.FontClass d-flex align-items-center gap-2"
                   aria-label="@(item.Name)"
                   href="@Framework.URLFixup(item.FinalURL(ci.URL))"
                   target="@(item.NewWindow ? "_blank" : "_self")"
                   onclick="@(item.TrackExternalURL ? "return trackOutbound(this);" : "")"
                   rel="@(item.NoFollow ? "nofollow noopener" : "")"
                   @if (item.FontClass?.Contains("menu-spacer") == true) { <text>
                   tabindex="-1" ;
                   </text> }>
                    @if (item.Header)
                    {
                        <strong>
                            @Html.Raw(item.Name)
                        </strong>
                    }
                    else
                    {
                        @Html.Raw(item.Name)
                        if (item.QueryStringParameters?.Contains("product-type") == true && (item.MenuItemID == 11793 || item.MenuItemID == 11794))
                        {
                            @* Fabric and Wallpaper menu items only get the magnifying glass *@
                            <i class="bi bi-search"></i>
                        }
                    }
                </a>
            }
            else
            {
                <span id="menu-item-@(item.MenuItemID)" class="nav-link  @(item.FontClass)"></span>
            }
        </li>
    }
    else 
    {
        var banners = model
            .Banners
            .Where(bl => bl.id == item.BannerLocationID).SelectMany(bl => bl.banners)
            .Where(b => b.restrictions.menuIds == null || b.restrictions.menuIds.Contains(item.MenuID))
            .ToList();

        if (banners.Any())
        {
            <li>
               @if (banners.Count() == 1)
                {
                   var banner = banners.First();
                    <a  id="menu-item-@(item.MenuItemID)"
                        class="nav-link @item.FontClass"
                        aria-label="@(item.Name)"
                        href="@Framework.URLFixup(($"{(String.IsNullOrEmpty(banner.linkURL) ? "javascript:;" : banner.linkURL)}{item.QueryStringParameters}").TrimEnd(Framework.QueryStringTrim))"
                        target="@(banner.newWindow ? "_blank" : "_self")"
                        onclick="@(item.TrackExternalURL ? "return trackOutbound(this);" : "")"
                        rel="@(item.NoFollow ? "nofollow noopener" : "")">
                        <img width="256"
                             height="@(((float)banner.height / (float)banner.width) * 256)"
                             src="/imagebanner@(Framework.WebPFallback)/256/@(banner.bannerId)"
                             alt="@(banner.altText ?? banner.overlayText ?? item.Name)" 
                             title="@(banner.titleText ?? banner.overlayText ?? item.Name)" 
                             @HtmlHelperExtra.BannerImageSourceSetSizes((long)banner.bannerId, banner.version, ImageSize.Three) />
                       @if (!String.IsNullOrEmpty(banner.overlayText))
                        {
                            <h6>
                                @banner.overlayText.Replace(">", "").TrimEnd()
                            </h6>
                        }
                    </a>
                }
                else
                {
                    <div class="carousel slide carousel-fade carousel-dark"
                         data-bs-ride="carousel"
                         data-bs-interval="3000">
                        <div class="carousel-inner">
                           @foreach (var b in banners.Select((value, index) => new { value, index }))
                            {
                                var banner = b.value;
                                var index = b.index;
                                <div class="carousel-item @(index == 0 ? "active" : "")">
                                   @if (!String.IsNullOrEmpty(banner.linkURL))
                                    {
                                        <a href="@Framework.URLFixup(banner.linkURL.TrimEnd(Framework.QueryStringTrim))"
                                           target="@(banner.newWindow ? "_blank" : "_self")">
                                            <img src="/imagebanner@(Framework.WebPFallback)/256/@banner.bannerId?v=@banner.version"
                                                    class="d-block w-100 pointer"
                                                    alt="@(banner.altText ?? item.Name)"
                                                    width="256"
                                                    height="@(((float)banner.height / (float)banner.width) * 256)"
                                                    @HtmlHelperExtra.BannerImageSourceSetSizes(banner.bannerId, banner.version, ImageSize.Three)>
                                           @if (!String.IsNullOrEmpty(banner.overlayText))
                                            {
                                                <h6>
                                                    @banner.overlayText.Replace(">", "").TrimEnd()
                                                </h6>
                                            }
                                        </a>   
                                    }
                                    else
                                    {
                                        <img src="/imagebanner@(Framework.WebPFallback)/256/@banner.bannerId?v=@banner.version"
                                                class="d-block w-100 pointer"
                                                alt="@(banner.altText ?? item.Name)"
                                                width="256"
                                                height="@(((float)banner.height / (float)banner.width) * 256)"
                                                @HtmlHelperExtra.BannerImageSourceSetSizes(banner.bannerId, banner.version, ImageSize.Three)>
                                        if (!String.IsNullOrEmpty(banner.overlayText))
                                        {
                                            <h6>
                                                @banner.overlayText.Replace(">", "").TrimEnd()
                                            </h6>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </li>
        }
    }
}