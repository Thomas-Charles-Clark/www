@model BaseViewModel
@{
    var objMaster = Model.MasterDefinition;
    var cd = objMaster.UrlBreakdown.countryDetails;
    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;

    var tradeUser = objMaster.TradeAllowed;

    var objMenu = Model.MasterDefinition.Menu;
}
<nav id="shortcuts-navbar" class="navbar menu-navbar" role="navigation">
    <ul class="container">
        @if (!tradeUser)
        {
            if (Model.MasterDefinition.LoginStatus == dgLoginStatus.notLoggedIn)
            {
                <li>
                    <a href="javascript:;" onclick="ecommerceEmailCapturePopupModel.loadFetch()"
                       class="btn navbar-btn">
                        @HtmlHelperExtra.Resource("JoinOurMailingListSubmitButtonText", l, c, d)
                    </a>
                </li>
            }
        }
        @if (objMaster.LoginStatus == dgLoginStatus.notLoggedIn)
        {
            <li id="signin-menu">
                <a href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.memberLogin, cd)"
                   rel="nofollow"
                   class="btn navbar-btn">
                    @HtmlHelperExtra.Resource("Login", l, c, d) / @HtmlHelperExtra.Resource("Register", l, c, d)
                </a>
                <ul class="dropdown" aria-label="submenu">
                    <li>
                        <a class="btn btn-link"
                           rel="nofollow"
                           href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.memberLogin, cd)">
                            @HtmlHelperExtra.Resource("Login", l, c, d)
                        </a>
                    </li>
                    <li>
                        <a class="btn btn-link"
                           rel="nofollow"
                           href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.memberLogin, cd, null, null, new [] { new KeyValuePair<string, string>("t", "1") })">
                            @HtmlHelperExtra.Resource("TradeLogin", l, c, d)
                        </a>
                    </li>
                </ul>
            </li>
        }
        else
        {
            if (!tradeUser)
            {
                <li>
                    <a class="btn navbar-btn"
                       href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.memberMenu, cd)"
                       target="_self">
                        @HtmlHelperExtra.Resource("Hello", l, c, d)
                        <span id="topnav-name">
                            @Session["memberName"],
                        </span>
                        @HtmlHelperExtra.Resource("YourAccount", l, c, d)
                    </a>
                </li>
            }
            else
            {
                <li>
                    <a class="btn navbar-btn">
                        @HtmlHelperExtra.Resource("Hello", l, c, d)
                        <span id="topnav-name">
                            @Session["memberName"]
                        </span>
                    </a>
                </li>
            }
            <li>
                <a class="btn nav-link" href="javascript:;" onclick="logout()">
                    @HtmlHelperExtra.Resource("Logout", l, c, d)
                </a>
            </li>
        }
        <li id="trade-menu">
            <a class="btn navbar-btn" aria-haspopup="true" href="#">
                @HtmlHelperExtra.Resource("Trade", l, c, d)
            </a>
            <ul class="dropdown" aria-label="submenu">
                <li>
                    <a class="btn btn-link"
                       href="@(dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.tradeHomePage, cd, null, null, new[] { new KeyValuePair<string,string>("t", "1") }))">
                        @HtmlHelperExtra.Resource("NewTradeWebsite", l, c, d)
                    </a>
                </li>
                @if (!tradeUser)
                {
                    <li>
                        <a class="btn btn-link"
                           href="@(dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.tradeAccountRequest, cd))">
                            @HtmlHelperExtra.Resource("RequestTradeAccount", l, c, d)
                        </a>
                    </li>
                }
                <li class="dropdown-divider"></li>
                <li>
                    <a class="btn btn-link"
                       target="_blank"
                       rel="nofollow"
                       href="https://trade.designersguild.com">
                        @HtmlHelperExtra.Resource("ExistingTradeWebsite", l, c, d)
                    </a>
                </li>
                <li>
                    <a class="btn btn-link"
                       target="_blank"
                       rel="nofollow"
                       href="https://trade.designersguild.com">
                        @HtmlHelperExtra.Resource("ExistingTradeStatistics", l, c, d)
                    </a>
                </li>
            </ul>
        </li>
        @if (cd.ShopEnabled)
        {
            <li id="basket-menu"
                data-bind="event: {  mouseenter: showBasketSummary, mouseleave: hideBasketSummary }">
                <a id="basket-menu-inner"
                   class="btn navbar-btn"
                   href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.maintainBasket, cd)"
                   aria-haspopup="true"
                   target="_self">
                    <span>
                        @HtmlHelperExtra.Resource("ViewBasket", l, c, d)
                    </span>
                    <i class="bi bi-bag"></i>
                    <span class="badge rounded-pill bg-secondary" style="display: @(objMaster.ItemsInBasket > 0 ? "block" : "none")" data-bind="visible: +itemsInBasket()">
                        <span data-bind="init, text: itemsInBasket">
                            @($"{objMaster.ItemsInBasket:#.##}")
                        </span>
                        <span class="visually-hidden">
                            <span class="visually-hidden" data-bind="init, text: itemsInBasket">
                                @($"{objMaster.ItemsInBasket:#.##}")
                            </span>
                            @HtmlHelperExtra.Resource(objMaster.ItemsInBasket > 0 ? "ShoppingProductsInBasket" : "EmptyBasket", l, c, d)
                        </span>
                    </span>
                </a>
                <div id="basket-summary-dropdown"
                     class="dropdown"
                     aria-label="submenu">
                    <div id="basket-summary-blocker"
                         class="page-blocker"
                         data-bind="toggleOpacity: busy">
                        <div class="spinner-border" role="status"></div>
                        <h5>
                            @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                        </h5>
                    </div>
                    <div id="basket-summary-contents">
                        <!-- ko if: basketItems().length == 0 -->
                        <h6 class="text-center my-3">
                            @HtmlHelperExtra.Resource("EmptyBasket", l, c, d)
                        </h6>
                        <!-- /ko -->
                        <div id="basket-summary-items" data-bind="foreach: basketItems">
                            <div class="basket-summary-item">
                                <img width="90"
                                     height="90"
                                     data-bind="attr: { src: `/image@(Framework.WebPFallback)/90/${ImageID}`,
                                                        alt: Code,
                                                        title: Code,
                                                        srcset: window.imageAttributeSourceSet(ImageID, imageSizeIcon),
                                                        sizes: window.imageAttributeSizes(ImageID, imageSizeIcon) }" />
                                <p>
                                    <span data-bind="text: DisplayLine"></span>
                                    <span data-bind="text: `${ko.unwrap($parent.resources).Quantity}: ${Quantity}${StockMessaging.Unit}`"></span>
                                    @if (tradeUser)
                                    {
                                        <span data-bind="text: BasketLineType"></span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div id="basket-summary-controls">
                            <a class="btn btn-secondary" href="@dgFramework.buildUrl(dgContentType.landingPage, 201, ci)">
                                <span>
                                    @HtmlHelperExtra.Resource("ViewBasket", l, c, d)
                                </span>
                                <span data-bind="text: summaryMessage"></span>
                            </a>
                            <p class="message" data-bind="html: promotionalMessage"></p>
                            <a class="btn btn-secondary" href="@dgFramework.buildUrl(dgContentType.landingPage, 201, ci)">
                                @HtmlHelperExtra.Resource("BasketProceedCheckout", l, c, d)
                            </a>
                        </div>
                    </div>
                </div>
            </li>
        }
        <li class="underlay"></li>
    </ul>
</nav>
<div id="logo-search-container"
     class="container mt-4">
    <a href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.home, cd)">
       @if (tradeUser) 
        {
        <img id="navbar-logo" width="512" height="37" title="@HtmlHelperExtra.Resource("DesignersGuild", l, c, d)" alt="@HtmlHelperExtra.Resource("DesignersGuildLogo", l, c, d)" 
                src="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension)"
                srcset="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension) 1x,
                        /Content/images/logo/dg-logo-b2b-1340-73@(Framework.WebpOrPngExtension) 2x,
                        /Content/images/logo/dg-logo-b2b-2680-145@(Framework.WebpOrPngExtension) 4x"
                sizes="(max-width: 992px) 512px, (max-width: 1200px) 1024px, 2048px"/>
        }
        else
        {
        <img id="navbar-logo" width="512" height="37" title="@HtmlHelperExtra.Resource("DesignersGuild", l, c, d)" alt="@HtmlHelperExtra.Resource("DesignersGuildLogo", l, c, d)" 
                src="/Content/images/logo/dg-logo-512-37@(Framework.WebpOrPngExtension)"
                srcset="/Content/images/logo/dg-logo-512-37@(Framework.WebpOrPngExtension) 1x,
                        /Content/images/logo/dg-logo-1024-73@(Framework.WebpOrPngExtension) 2x,
                        /Content/images/logo/dg-logo-2048-145@(Framework.WebpOrPngExtension) 4x"
                sizes="(max-width: 992px) 512px, (max-width: 1200px) 1024px, 2048px"/>
        }
    </a>
    <div id="product-search-content"
         class="@((Model.ContentID == 76 ? "open" : ""))"
         data-bind="keepElement: searchTerm"> @* hold this guy open if on Search page *@
        <div id="product-search-form-wrapper" tabindex="0">
            <div id="product-search-advanced-dropdown" class="dropdown">
                <button id="product-search-advanced-btn"
                        type="button"
                        class="btn btn-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    @HtmlHelperExtra.Resource("AdvancedSearch", l, c, d)
                </button>
                <ul class="dropdown-menu"
                    aria-labelledby="dropdownMenuButton1">
                   @foreach (var pt in Model.MasterDefinition.ProductTypeDropDown.ProductTypes)
                    {
                        <li>
                            <a class="dropdown-item" href="/@(dgFramework.getUrlKeywordsForFixedPage(76, cd))/l76?product-type=@(pt.FormValue)">
                                @(pt.Name)
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <form id="product-search-form"
                  method="get"
                  action="/@(cd.URL)/@(dgFramework.getUrlKeywordsForFixedPage(76, cd))/l76"
                  autocomplete="off"
                  aria-label="@HtmlHelperExtra.Resource("ProductSearch", l, c, d)"
                  class="@((Model.ContentID == 76 ? "open" : ""))" @* this guy too *@
                  data-bind="submit: formSubmit">
                <div class="input-group"
                     data-bind="css: { 'busy': busy }">
                    <span class="d-none" data-bind="init: { convert: JSON.parse }, text: availableProductTypes, remove">
                        @Html.Raw(JsonConvert.SerializeObject(Model.MasterDefinition.ProductTypeDropDown.ProductTypes))
                    </span>
                   @if (!String.IsNullOrEmpty(Model.ProductType))
                    {
                        <span class="d-none" data-bind="init: { convert: parseString }, text: productType, remove">
                            @Model.ProductType
                        </span>
                    }
                    <select id="product-type-select" name="product-type" class="form-select" data-bind="value: productType">
                        <option value="" selected>
                            @HtmlHelperExtra.Resource("All", l, c, d)
                        </option>
                       @foreach (var pt in Model.MasterDefinition.ProductTypeDropDown.ProductTypes)
                        {
                            <option value="@(pt.FormValue)" @((pt.FormValue == Model.ProductType) ? "selected" : "")>
                                @(pt.Name)
                            </option>
                        }
                    </select>
                   @if (HtmlHelperExtra.IsNonProductionVersion)
                    {
                        if (!String.IsNullOrEmpty(Request.QueryString["dateOverride"]))
                        {
                            <input type="hidden" name="dateOverride" value="@(Request.QueryString["dateOverride"])" />
                        }
                        if (!String.IsNullOrEmpty(Request.QueryString["countryOverride"]))
                        {
                            <input type="hidden" name="countryOverride" value="@(Request.QueryString["countryOverride"])" />
                        }
                    }
                    <input id="product-search-input"
                        name="search-term"
                        type="text"
                        class="form-control"
                        aria-label="@HtmlHelperExtra.Resource("ProductSearch", l, c, d)"
                        value="@Model.SearchTerm"
                        data-bind="init: { convert: parseString }, textInput: searchTerm, downArrowKey: focusFirstDropdownItem, attr: {
                            placeholder: placeholder
                        }" />
                    <div class="dots-wrapper">
                        <div class="dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                    <button id="search-box-submit"
                            class="btn btn-outline-secondary"
                            type="submit"
                            aria-label="@HtmlHelperExtra.Resource("SubmitProperCase", l, c, d)">
                        @*<span class="visually-hidden">
                            @HtmlHelperExtra.Resource("EnterSearch", l, c, d)
                        </span>*@
                        <span class="search-button-label" data-bind="text: searchButtonLabel"></span>
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>
        <div id="search-overlay" role="button" onclick="document.querySelector('#product-search-input').focus()" ontouchstart="document.querySelector('#product-search-input').focus()" tabindex="1">
            <span>
                @HtmlHelperExtra.Resource("EnterSearch", l, c, d)
            </span>
             <i class="bi bi-search"></i>
        </div>
    </div>
</div>
