@model wwwDesignersGuild.Models.Classes.passSnippet
@using wwwDesignersGuild.Models.Classes;
@using wwwDesignersGuild.Models.Helper;
@{
    Layout = null;

    byte snippetLocationID = Model.SnippetLocationID;
    var masterData = Model.masterDefinition;
    var snippetContent = Model.snippetContent;

    String snippetId = String.Format("snippet-id-{0}", snippetLocationID);
    String snippetCloseId = String.Format("snippet-id-close-{0}", snippetLocationID);
    String snippetShowId = dgFramework.getSnippetId(snippetLocationID);
    String height = Model.height == null ? "360px;" : Model.height.ToString() + "px;";
    String width = Model.width == null ? "580px;" : Model.width.ToString() + "px;";
}

<div id="@snippetId" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.Raw(Model?.snippetContent?.HTMLContent)
            </div>
        </div>
    </div>
</div>