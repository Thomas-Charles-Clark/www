@model CarouselViewModel
@{
    var objMaster = Model.Base.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var tradeUser = objMaster.TradeAllowed;

    var width = dgFramework.IsMobileDevice() ? 380 : 1024;

    var height = (int)(width * (1.0m / Model.AspectRatio));

    var multiple = Model.Images.Count() > 1;

    var hotspotIndex = 0;
}
<div id="@(Model.CarouselID.Replace("#", ""))"
     class="@(Model.WrapperCSSClass) carousel slide carousel-fade carousel-dark"
     data-bs-ride="carousel"
     data-bs-interval="@(Model.Interval.HasValue ? $"{Model.Interval}" : "false")"
     data-bind="keepElement: images">
    <div class="carousel-inner" data-bind="foreachInit: { name: 'ko-blank-template', data: images, createElement: createImage }">
       @foreach (var i in Model.Images.Select((value, index) => new { value, index }))
        {
            var image = i.value;
            var index = i.index;
            var overlay = image.Overlay;
            <div class="carousel-item @(index == 0 ? "active" : "")">
                <div class="d-none" data-bind="init: { convert: JSON.parse }, text: data, remove">
                    @JsonConvert.SerializeObject(image)
                </div>
                @if (overlay != null && overlay.Visible)
                {
                    <div class="carousel-overlay @(overlay.AutoHide ? "auto-hide" : "")" style="
                        top: @(overlay.TopPercent);
                        left: @(overlay.LeftPercent);
                        width: @(overlay.WidthPercent);
                        opacity: @(overlay.Opacity);
                        background: @(overlay.Background);
                        color: @(overlay.FontColour);">
                        <h6>
                            <span>
                                @overlay.Heading
                            </span>
                            @if (!String.IsNullOrEmpty(overlay.Text))
                            {
                                <small>
                                    @overlay.Text
                                </small>
                            }
                        </h6>
                    </div>
                }
                <img src="/image@(Framework.WebPFallback)/@(width)/@image.ImageID"
                     class="d-block w-100"
                     alt="@(image.AltText ?? Model.Heading)"
                     width="@(width)"
                     height="@(height)"
                     data-bind="keepElement: data,
                            @(Model.DisplayThumbnails && Model.PermitLargeImageModal ? @"click: (data, event) => { window.largeImageModal.load($parent, event) }" : "")"
                     @if ((dgFramework.IsMobileDevice() && index > 0) || image.ForceLazyLoading) { <text>
                     loading="lazy"
                     </text>  }
                     @HtmlHelperExtra.ImageSourceSetSizes(image.ImageID, image.ImageSize, image.MaxWidth)>
                <button class="btn btn-link btn-scrapbook position-absolute"
                        aria-label="@HtmlHelperExtra.Resource("AddToScrapbook", l, c, d)"
                        data-bind="click: basketModel.toggleScrapbook">
                    <i class="bi @(Model.Base.IsImageInScrapbook(image.ImageID) ? "bi-bookmark-heart" : "bi-bookmark-plus")"></i>
                </button>
                @if (!dgFramework.IsMobileDevice() && image.Hotspots.Any())
                {
                    <div class="hotspot-products-btn-wrapper">
                        <button class="btn btn-link hotspot-products-btn"
                                data-bs-target="#image-@(image.ImageID)-hotspot-collapse"
                                data-bs-toggle="collapse"
                                data-bind="click: $parent.toggleCarousel">
                            @HtmlHelperExtra.Resource("ShowImageProducts", l, c, d)
                        </button>
                    </div>
                    <div class="collapse hotspot-collapse" id="image-@(image.ImageID)-hotspot-collapse">
                        <!-- ko foreachInit: { data: orderFormGroups, createElement: createOrderFormGroup } -->
                        @foreach (var hotspot in image.Hotspots)
                        {
                            ViewBag.OrderFormPrefix = $"-hotspot-{++hotspotIndex}";
                            <div class="hotspot-marker" style="left: @(hotspot.x); top: @(hotspot.y)"
                                 data-init>
                                <div class="hotspot-overlay">
                                    <div class="hotspot-overlay-inner">
                                        @*<div class="hotspot-pin"></div>*@
                                        <div class="order-form-group">
                                            @Html.Partial("~/Views-New/ProductPages/Shared/_Hotspot.cshtml", hotspot.Product)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <!-- /ko -->
                    </div>
                }
                @if ((Model.DisplayThumbnails == false) && (multiple == true) && (!dgFramework.IsMobileDevice()))
                {
                    <button class="carousel-control-prev" type="button" aria-controls="@(Model.CarouselID)" data-bs-target="@(Model.CarouselID)" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">
                            @HtmlHelperExtra.Resource("ArticleNext", l, c, d)
                        </span>
                    </button>
                    <button class="carousel-control-next" type="button" aria-controls="@(Model.CarouselID)" data-bs-target="@(Model.CarouselID)" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">
                            @HtmlHelperExtra.Resource("ArticleNext", l, c, d)
                        </span>
                    </button>
                }
            </div>
        }
       @if (!String.IsNullOrEmpty(Model.VideoURL))
        {
            <div class="carousel-item @(Model.Images.Count == 0 ? "active" : "") carousel-video-item">
                <iframe src="@(Model.VideoURL)" frameborder="0" allow="autoplay; fullscreen; picture-in-picture"></iframe>
            </div>
        }
    </div>
   @if ((Model.DisplayDashes == true) && (Model.DisplayThumbnails == false || dgFramework.IsMobileDevice() == true) && (multiple == true))
    {
        <div class="carousel-indicators">
           @foreach (var i in Model.Images.Select((value, index) => new { value, index }))
            {
                var image = i.value;
                var index = i.index;
                <button type="button"
                        data-bs-target="@(Model.CarouselID)"
                        data-bs-slide-to="@(index)"
                        class="@(index == 0 ? "active" : "")"
                        aria-current="@(index == 0 ? "true" : "")"
                        aria-label="@HtmlHelperExtra.Resource("ImageSlide", l, c, d) @(index + 1)"></button>
            }
           @if (!String.IsNullOrEmpty(Model.VideoURL))
            {
                <button data-bs-target="@(Model.CarouselID)"
                        data-bs-slide-to="@(Model.Images.Count)"
                        class="btn btn-link @(Model.Images.Count == 0 ? "active" : "")"
                        aria-current=""
                        aria-label="@HtmlHelperExtra.Resource("ImageSlide", l, c, d) @(Model.Images.Count + 1)">
                </button>
            }
        </div>
    }
</div>
@if (Model.DisplayThumbnails)
{   
@*<div class="d-flex justify-content-end align-items-center">
    @Html.Partial("~/Views-New/Shared/_SocialMediaDrop.cshtml", Model.SocialMediaViewModel)
    <button class="carousel-click-for-large btn btn-link"
            data-bind="click: window.largeImageModal.load">
        @HtmlHelperExtra.Resource("clickZoom", l, c, d)
    </button>
</div>*@
}
@if (Model.DisplayThumbnails && multiple && !dgFramework.IsMobileDevice())
{ 
    <div class="carousel-thumbnails">
        @foreach (var i in Model.Images.Select((value, index) => new { value, index }))
        {
            var image = i.value;
            var index = i.index;
            <div class="g-col-1">
                <button data-bs-target="@(Model.CarouselID)"
                        data-bs-slide-to="@(index)"
                        class="btn btn-link @(index == 0 ? "active" : "")"
                        aria-current="@(index == 0 ? "true" : "")"
                        aria-label="@HtmlHelperExtra.Resource("ImageSlide", l, c, d) @(index + 1)">
                    <img src="/image@(Framework.WebPFallback)/90/@(image.ImageID)"
                         alt="@(image.AltText ?? Model.Heading)"
                         width="90"
                         height="90"
                         srcset="/image@(Framework.WebPFallback)/90/@(image.ImageID) 90w, /image@(Framework.WebPFallback)/156/@(image.ImageID) 156w"
                         sizes="(max-width: 767px) 156px, 90px" />
                </button>
            </div>
        }
        @if (!String.IsNullOrEmpty(Model.VideoURL) && !String.IsNullOrEmpty(Model.VideoThumbnail))
        {
            <div class="g-col-1">
                <button data-bs-target="@(Model.CarouselID)"
                        data-bs-slide-to="@(Model.Images.Count)"
                        class="btn btn-link carousel-video-thumbnail-btn @(Model.Images.Count == 0 ? "active" : "")"
                        aria-current=""
                        aria-label="@HtmlHelperExtra.Resource("ImageSlide", l, c, d) @(Model.Images.Count + 1)">
                    <img src="@(Model.VideoThumbnail ?? "https://www.designersguild.com/image/239/")"
                         alt="@(Model.Heading)"
                         width="90"
                         height="90" />
                    <i class="material-icons">
                        play_circle
                    </i>
                </button>
            </div>
        }
    </div>
}