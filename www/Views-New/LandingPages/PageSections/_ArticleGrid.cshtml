@model PageSectionViewModel
@{
    var objMaster = Model.Base.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var tradeUser = objMaster.TradeAllowed;

    var grid = (ArticleGridPageSection)Model.Definition;
}
@if (!dgFramework.IsMobileDevice())
{
    <div class="my-3">
        <h2 class="text-uppercase my-4 trixie bold">
           @HtmlHelperExtra.Resource("WorldOfDGHeading", l, c, d)
        </h2>
       @if (grid.ArticleTypes.Any())
        { 
            <nav class="article-type-nav nav-justified" aria-label="@HtmlHelperExtra.Resource("ArticleTypes", l, c, d)">
                <ul class="nav">
               @foreach(var at in grid.ArticleTypes)
                {
                    <li class="nav-item @(grid.GridArticleType == at.ArticleTypeID ? "active" : "")">
                        <a class="nav-link" href="@Framework.URLFixup(at.URL)">
                            @(at.Name)
                           @if(grid.GridArticleType == at.ArticleTypeID)
                            {
                                <i class="bi bi-chevron-down"></i>
                            }
                        </a>
                    </li>
                }
                </ul>
            </nav>
        }
    </div>
    if (grid.ArticleSubTypes.Any())
    {
        <div class="my-3">
            <nav class="article-type-nav article-sub-type-nav nav-justified" aria-label="@HtmlHelperExtra.Resource("ArticleSubTypes", l, c, d)">
                <ul class="nav">
               @foreach(var ast in grid.ArticleSubTypes)
                {
                    <li class="nav-item @(Model.Base.ContentID == ast.PageID ? "active" : "")">
                        <a class="nav-link" href="@Framework.URLFixup(ast.URL)">
                            @(ast.Name)
                        </a>
                    </li>
                }
                </ul>
            </nav>
        </div>
    }
}
else
{
    <div class="my-3">
        <h2 class="text-uppercase my-4">
           @HtmlHelperExtra.Resource("WorldOfDGHeading", l, c, d)
        </h2>
        <!-- ko with: articleGrid -->
        <span class="d-none" data-bind="init: { convert: parseString }, text: articleTypeId, remove">
            @(grid.ArticleTypes.SingleOrDefault(ast => ast.ArticleTypeID == grid.GridArticleType)?.URL)
        </span>
        <select class="form-select my-2"
                data-bind="value: articleTypeId">
           @foreach(var at in grid.ArticleTypes)
            {
                <option value="@at.URL" @(grid.GridArticleType == at.ArticleTypeID ? "selected" : "")>
                    @(at.Name)
                </option>
            }
        </select> 
       @if (grid.ArticleSubTypes.Any())
        {
            <span class="d-none" data-bind="init: { convert: parseString }, text: articleSubTypeId, remove">
                @(grid.ArticleSubTypes.SingleOrDefault(ast => ast.PageID == Model.Base.ContentID)?.URL)
            </span>
            <select id="article-sub-type-select"
                    class="form-select my-2"
                    data-bind="value: articleSubTypeId">
           @foreach(var ast in grid.ArticleSubTypes)
            {
                <option value="@ast.URL" @(Model.Base.ContentID == ast.PageID ? "selected" : "")>
                    @(ast.Name)
                </option>
            }
            </select>
        }
        <!-- /ko -->
    </div>
}
<form id="page-section-@(Model.PageSection.PageSectionID)-form" action="@Request.Url" method="GET">
    <span class="d-none" data-bind="init: { convert: JSON.parse }, text: data, remove">
        @Html.Encode(Html.Raw(JsonConvert.SerializeObject(Model)))
    </span>
    @{ 
        grid.Index = 0;
        <!-- ko with: articleGrid -->
        @Html.Partial("~/Views-New/LandingPages/PageSections/_PageSectionPagerNav.cshtml", grid);
        <!-- /ko -->
    }
    <div class="my-3">
        <div class="article-grid grid" data-bind="foreachInit: { name: 'ko-article-pod-template', data: articleGrid.visibleArticles, createElement: articleGrid.createArticlePod, afterQueueFlush: window.lazyImages }">
           @if (Model.PageSection.Paging)
            {
                foreach (var a in grid.GetArticles(objMaster).Skip((grid.Page - 1) * grid.PageSize).Take(grid.PageSize))
                {
                    @Html.Partial("~/Views-New/LandingPages/PageSections/_ArticlePod.cshtml", a)
                }
            }
            else
            {
                foreach (var a in grid.GetArticles(objMaster))
                {
                    @Html.Partial("~/Views-New/LandingPages/PageSections/_ArticlePod.cshtml", a)
                }
            }
        </div>
        <div class="d-none" data-bind="foreachInit: { name: 'ko-blank-template', data: articleGrid.allArticles, createElement: articleGrid.createArticlePod }, css: { 'ready': articleGrid.allArticlesInitialised() }, remove">
           @foreach (var p in grid.Contents)
            {
                <span class="d-none" data-bind="init: { convert: JSON.parse }, text: data, remove">
                    @Html.Encode(Html.Raw(JsonConvert.SerializeObject(p)))
                </span>
            }
        </div>
    </div>
    @{ 
        grid.Index = 1;
        <!-- ko with: articleGrid -->
        @Html.Partial("~/Views-New/LandingPages/PageSections/_PageSectionPagerNav.cshtml", grid);
        <!-- /ko -->
    }
</form>