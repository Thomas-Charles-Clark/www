@if (Model.OnlyShowTrade == false)
{
    <script src="https://js.braintreegateway.com/web/3.68.0/js/client.min.js"></script>
    <script src="https://js.braintreegateway.com/web/3.68.0/js/paypal-checkout.min.js"></script>
    <script src="https://js.braintreegateway.com/web/3.68.0/js/apple-pay.min.js"></script>

    <script>
        braintree.client.create(
            {
                authorization: '@Model.BraintreeClientKey'
            },
            function (clientErr, clientInstance) {
                if (clientErr) {
                    notifyPaypalError(clientErr);
                    return;
                }
               @if (Model.PermitPayPal)
               {
                <text>
                braintree.paypalCheckout.create(
                    {
                        client: clientInstance
                    },
                    function (paypalCheckoutErr, paypalCheckoutInstance) {
                        if (paypalCheckoutErr) {
                            notifyPaypalError(paypalCheckoutErr);
                            return;
                        }

                        paypalCheckoutInstance.loadPayPalSDK({
                            intent: 'authorize',
                            currency: '@Model.Currency',
                            commit: false
                        }, function (loadPayPalSDKErr) {
                            if (loadPayPalSDKErr) {
                                notifyPayPalError(loadPayPalSDKErr);
                                return;
                            }

                            $("#paypal-button").empty();

                            paypal.Buttons({
                                fundingSource: paypal.FUNDING.PAYPAL,
                                commit: false,
                                createOrder: function () {
                                    return paypalCheckoutInstance.createPayment(
                                        {
                                            flow: 'checkout',
                                            intent: 'authorize',
                                            commit: false,
                                            amount: '@Model.SubTotal.ToString("N2", nfi)',
                                            currency: '@Model.Currency',
                                            enableShippingAddress: true
                                        }
                                    );
                                },
                                style: {
                                    label: 'paypal',
                                    color: 'gold',
                                    shape: 'rect',
                                    height: 50,
                                    tagline: true
                                },
                                onApprove: function (data) {
                                    return paypalCheckoutInstance.tokenizePayment(data, function (err, payload) {
                                        var details = payload.details;
                                        var ppAddress = details.shippingAddress;
                                        var address = {
                                            addressName: ppAddress.recipientName,
                                            addressLineOne: ppAddress.line1,
                                            addressLineTwo: ppAddress.line2,
                                            addressTown: ppAddress.city,
                                            addressCounty: ppAddress.state,
                                            addressPostCode: ppAddress.postalCode,
                                            addressCountryCode: ppAddress.countryCode,
                                            addressPhone: ""
                                        };
                                        proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Paypal)), details.email, payload.nonce, address);
                                    });
                                },
                                onCancel: function (data) {
                                },
                                onError: function (err) {
                                    notifyPaypalError(err);
                                }
                            }).render('#paypal-button');
                        });
                    });
                </text>
                }
                @if (Model.PermitApple)
                {
                <text>
                    braintree.applePay.create({
                        client: clientInstance
                    }, function (applePayErr, applePayInstance) {
                        if (applePayErr) {
                            console.error('applePay error', applePayErr);
                            window.showInfo('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("Sorry", l, c, d))', error);
                            return;
                        }

                        clm.applePay = new ApplePayViewModel(applePayInstance, clm);
                    });
                </text>
                }
            });

        function notifyPaypalError(error) {
            window.showError('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("PayPalGenericError", l, c, d))');
        }
    </script>
}

