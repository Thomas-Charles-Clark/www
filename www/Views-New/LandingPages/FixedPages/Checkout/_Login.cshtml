<script type="text/javascript">

    localStorage.removeItem('defaultToken'); @* Remove any previously saved card defaults *@
    localStorage.removeItem('selectedCard');

    $(document).ready(function () {

        if (getUrlParameter('a') == '0') {
            if (typeof (window.history.pushState) === 'function') {
                var url = [location.protocol, '//', location.host, location.pathname].join('');
                var stateObj = { path: url };
                history.pushState(stateObj, '', url);
            } else {
                window.location.href = url;
            }
            $("#amazon-failure-modal").modal('show');
        }

    });

    function getUrlParameter(name) {
        name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
        var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
        var results = regex.exec(location.search);
        return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
    };

    function jumpToSessionExpired() {
        window.location.href = '@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.checkoutSessionExpired, ci)';
    }

    function asyncCheckoutLog(type, detail) {
        $.ajax({
            url: '/api/checkout/asyncSaveCheckoutLog',
            type: 'POST',
            async: false,
            cache: false,
            data: {
                action: type,
                detail: detail || "no detail provided"
            },
            success: function (data) {
            },
            error: function (xhr, s, a) {
                console.log("braintree error logging failed");
            }
        });
    }

    function proceedToCheckout(checkoutType, email, token, shippingAddress) {

        if (document.querySelector('#guest-member-login-modal').style.display != 'block') {
            if (typeof window.pageModel === 'object' &&
                typeof window.pageModel.fixedPage === 'function' &&
                ko.unwrap(window.pageModel.fixedPage) != null) {
                window.pageModel.fixedPage().checkoutLoginModel.busy(true);
            } else {
                window.addFixedPageLoadFunction(() => {
                    window.pageModel.fixedPage().checkoutLoginModel.busy(true);
                });
            }
        }

        document.querySelectorAll('.proceed-btn').forEach(pb => {
            pb.setAttribute('disabled', true);
            pb.classList.add('disabled');
        });

        if (checkoutType == 5) {
            clm.applePay.init();
        }

        $.ajax({
            url: "/api/checkout/setCheckoutType",
            type: "Post",
            cache: false,
            async: true,
            data: JSON.stringify({
                checkoutType: checkoutType,
                guestEmail: email,
                token: token,
                basketCountry: getSiteCountry(),
                initialShippingAddress: shippingAddress
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                if (data.error) {
                    switch (data.message) {
                        case 'checkoutBasketExpired':
                            window.showInfo(window.pageModel.fixedPage().resources['Sorry'], window.pageModel.fixedPage().resources['CheckoutExpired']);
                            break;
                        case 'invalidDeliveryAddress':

                            let message = '';

                            let siteCorrector = document.getElementById('site-corrector');

                            let pClasses = 'mb-3';

                            if (siteCorrector) {

                                document.querySelector('#site-corrector p.d-flex').classList.add('flex-wrap');

                                document.querySelector('#site-corrector button.btn-close').remove();

                                siteCorrector.style.position = 'static';

                                siteCorrector.classList.add('mb-3');

                                ko.cleanNode(siteCorrector);

                                let siteCorrectorMarkup = siteCorrector.outerHTML;

                                document.querySelector('#body-inner').style['padding-top'] = 0;

                                siteCorrector.remove();

                                message += siteCorrectorMarkup;

                                pClasses = 'mt-5 mb-3';
                            }

                            message += `<p class="${pClasses}">${window.pageModel.fixedPage().resources['CheckoutLoginInvalidDeliveryAddress'].replace('{siteCulture}', getSiteCountry().toUpperCase())}</p>`;

                            message += `<ul class="undotted-list mb-3"><li>${JSON.parse(data.additionalInfo).flatMap(c => c.Name).join('</li><li>')}</li></ul>`;

                            message += `${window.pageModel.fixedPage().resources['CheckoutLoginInvalidDeliveryAddress2']}`;

                            window.showInfo(window.pageModel.fixedPage().resources['Sorry'], message);

                            if (siteCorrector) {
                                ko.applyBindings(window.siteCorrectorModel, siteCorrector)
                            }
                            break;
                        default:
                            window.showError();
                            break;
                    }
                    document.querySelectorAll('.proceed-btn').forEach(pb => {
                        pb.removeAttribute('disabled');
                        pb.classList.remove('disabled');
                    });

                    clm.busy(false);

                    if (clm.hasOwnProperty('activeApplePaySession')) {
                        clm.activeApplePaySession.abort();
                    }

                } else {
                    if (checkoutType != 5) {
                        @* Feels like this next line should have a bit more of a fanfare: into the checkout you go, dear customer! *@
                        window.location.href = data.redirect;
                        @* Ta-daaaa! *@
                    } else {
                        // Apple Pay remains on the Welcome screen
                        document.body.dispatchEvent(new Event('appleGo'));
                    }
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                window.pageModel.fixedPage().checkoutLoginModel.busy(false);
                document.querySelectorAll('.proceed-btn').forEach(pb => {
                    pb.removeAttribute('disabled');
                    pb.classList.remove('disabled');
                });
                console.log('dg-proceedToCheckout: ' + textStatus);
                window.showError();
            }
        });
    }

    function displayPaymentAddressError() {

        var message = '@Html.Raw(HtmlHelperExtra.Resource("PaypalInvalidAddress", l, c, d).ToString())';

        var countries = getValidCountries();
        var countryStr = '';

        $.each(countries, function (i, country) {
            if (countries.length > 1 && i == countries.length - 1)
                countryStr += ' & '
            else if (i > 0) {
                countryStr += ', '
            }
            countryStr += country;
        });

        var error = message.replace('{Countries}', countryStr);

        $('#address-failure-text').html(error);
        $('#address-failure-modal').modal('show');
    }

    function getValidCountries() {
        return @Html.Raw(Json.Encode(Model.CheckoutCountries));
    }
</script>