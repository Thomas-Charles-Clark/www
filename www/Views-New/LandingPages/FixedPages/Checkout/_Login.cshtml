@model FixedPageViewModel_CheckoutLogin
@{
    var objMaster = Model.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;

    var tradeUser = objMaster.TradeAllowed;

    var nfi = new System.Globalization.CultureInfo(Model.CountryItem.DotNetCulture).NumberFormat;

    var urlCheckoutDeliveryOptions = dgFramework.buildUrl(objMaster.UrlBreakdown.countryDetails,
                                            null,
                                            dgContentType.checkoutPart,
                                            (int)dgFixedPage.checkoutDispatch,
                                            Request.QueryString["dateOverride"], Request.QueryString["countryOverride"]);

    var urlCheckoutSummary = dgFramework.buildUrl(objMaster.UrlBreakdown.countryDetails,
                                    null,
                                    dgContentType.checkoutPart,
                                    (int)dgFixedPage.checkoutTotals,
                                    Request.QueryString["dateOverride"], Request.QueryString["countryOverride"]);

    //var forceBusy = Model.OnlyShowTrade && Model.MasterDefinition.LoginStatus == dgLoginStatus.currentLogin;
}

@* this fools Apple Pay into thinking the device is compatible so we can render the button,
    beyond that it doesn't help much
*@
@if (HtmlHelperExtra.Debug)
{
    <script>
        if (!window.ApplePaySession) {
            window.ApplePaySession = {
                constructor: () => {},

                canMakePayments: () => true
            }
        }
    </script>
}

<div class="container my-4">
    <div id="first-blocker"
         class="page-blocker"
         data-bind="
            flexVisible: checkoutLoginModel.busy,
            toggleOpacity: checkoutLoginModel.busy"
         @*style="display: @(forceBusy ? "flex" : "none");
                opacity: @(forceBusy ? "1.0" : "0.0")"*@>
        <div class="spinner-border"></div>
        <h4>
            @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
        </h4>
    </div>
    <h3 class="checkout-title text-center mb-4">
        @HtmlHelperExtra.Resource("TotalExcludingDelivery", l, c, d): @Model.SubTotal.ToString("C2", nfi)
    </h3>
    <p class="text-center my-3">
        @HtmlHelperExtra.Resource("HowWouldYouLikeToCheckout", l, c, d)
    </p>
    <div id="checkout-option-wrapper">
        @if (Model.OnlyShowTrade)
        {
            <div id="checkout-option-trade" class="checkout-option">
                <img width="512" height="37" title="@HtmlHelperExtra.Resource("DesignersGuild", l, c, d)" alt="@HtmlHelperExtra.Resource("DesignersGuildLogo", l, c, d)"
                     src="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension)"
                     srcset="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension) 1x,
                                /Content/images/logo/dg-logo-b2b-1340-73@(Framework.WebpOrPngExtension) 2x,
                                /Content/images/logo/dg-logo-b2b-2680-145@(Framework.WebpOrPngExtension) 4x"
                     sizes="(max-width: 992px) 512px, (max-width: 1200px) 1024px, 2048px" />
                <button class="btn btn-secondary proceed-btn" data-bind="click: checkoutLoginModel.invokeTradeLogin">
                    @HtmlHelperExtra.Resource("CheckoutTradeCheckout", l, c, d)
                </button>
            </div>
        }
        else
        {
            if (Model.PermitApple)
            {
                <div id="checkout-option-apple" class="checkout-option" style="display: none;" data-bind="visible: (window.ApplePaySession)">
                    <img width="84" height="54" class="apple-pay-mark" src="~/Content/images/checkout/apple-pay.svg" alt="@HtmlHelperExtra.Resource("PayWithApple", l, c, d)" />
                    <apple-pay-button class="proceed-btn" buttonstyle="black" type="buy" locale="@(Model.MasterDefinition.UrlBreakdown.countryDetails.DotNetCulture)" onclick="window.proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Apple)), null)"></apple-pay-button>
                </div>
            }
            if (Model.PermitPayPal)
            {
                <div id="checkout-option-paypal" class="checkout-option">
                    <img src="https://www.paypalobjects.com/webstatic/mktg/Logo/pp-logo-200px.png" border="0" width="200" height="51" alt="@HtmlHelperExtra.Resource("PayWithPayPal", l, c, d)">
                    <a id="paypal-button" class="btn proceed-btn p-0"></a>
                </div>
            }
            if (Model.PermitAmazon)
            {
                <div id="checkout-option-amazon" class="checkout-option">
                    <img src="~/Content/images/checkout/amazon-pay.png" alt="@HtmlHelperExtra.Resource("PayWithAmazon", l, c, d)" />
                    <div id="amazon-button" class="btn proceed-btn p-0"></div>
                </div>
            }
            if (Model.PermitGuest || Model.PermitMember)
            {
                <div id="checkout-option-normal" class="checkout-option">
                    <img width="512" height="37" title="@HtmlHelperExtra.Resource("DesignersGuild", l, c, d)" alt="@HtmlHelperExtra.Resource("DesignersGuildLogo", l, c, d)"
                         src="/Content/images/logo/dg-logo-512-37@(Framework.WebpOrPngExtension)"
                         srcset="/Content/images/logo/dg-logo-512-37@(Framework.WebpOrPngExtension) 1x,
                                /Content/images/logo/dg-logo-1024-73@(Framework.WebpOrPngExtension) 2x,
                                /Content/images/logo/dg-logo-2048-145@(Framework.WebpOrPngExtension) 4x"
                         sizes="(max-width: 992px) 512px, (max-width: 1200px) 1024px, 2048px" />
                    @if (Model.MasterDefinition.LoginStatus == dgLoginStatus.currentLogin)
                    {
                        <a class="btn btn-lg btn-secondary proceed-btn"
                           href="javascript:;"
                           onclick="window.proceedToCheckout('@(dgCheckoutType.Member)')"
                           target="_self">
                            @HtmlHelperExtra.Resource("MemberCheckout", l, c, d)
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-lg btn-secondary proceed-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#guest-member-login-modal">
                            @HtmlHelperExtra.Resource("CheckoutPayWithCard", l, c, d)
                        </button>
                    }
                </div>
            }
            if (Model.PermitTrade)
            {
                <div id="checkout-option-trade" class="checkout-option">
                    <img width="512" height="37" title="@HtmlHelperExtra.Resource("DesignersGuild", l, c, d)" alt="@HtmlHelperExtra.Resource("DesignersGuildLogo", l, c, d)"
                         src="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension)"
                         srcset="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension) 1x,
                                    /Content/images/logo/dg-logo-b2b-1340-73@(Framework.WebpOrPngExtension) 2x,
                                    /Content/images/logo/dg-logo-b2b-2680-145@(Framework.WebpOrPngExtension) 4x"
                         sizes="(max-width: 992px) 512px, (max-width: 1200px) 1024px, 2048px" />
                    <button class="btn btn-lg btn-secondary proceed-btn" data-bind="click: checkoutLoginModel.invokeTradeLogin">
                        @HtmlHelperExtra.Resource("CheckoutTradeCheckout", l, c, d)
                    </button>
                </div>
            }
        }
        @if (!String.IsNullOrEmpty(Model.CheckoutTypeNotice.AlertMessage))
        {
            <div id="checkout-option-alert-message" class="checkout-option" style="display: none" data-bind="visible: window.ApplePaySession">
                @Html.Raw(Model.CheckoutTypeNotice.AlertMessage)
            </div>
        }
    </div>
    <p class="text-center mt-8">
        @HtmlHelperExtra.Resource("IfYouHaveAGiftVoucher", l, c, d)
    </p>
</div>

