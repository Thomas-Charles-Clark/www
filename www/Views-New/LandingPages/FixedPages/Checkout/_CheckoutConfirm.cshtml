@model FixedPageViewModel_CheckoutConfirm
@using wwwDesignersGuild.Models.Classes;
@using wwwDesignersGuild.Models.Helper;
@{
    var objMaster = Model.PassCheckoutConfirm.masterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;

    var objReceipt = Model.PassCheckoutConfirm.checkoutReceipt;

    var objAddendum = objReceipt?.checkoutAddendum;

    String urlDate = "";

    if (Request.QueryString["dateOverride"] == null) { }
    else
    {
        urlDate = String.Format("?dateOverride={0}", Request.QueryString["dateOverride"].ToString());
    }

    Boolean tradeOrderingAllowed = Convert.ToBoolean(Session["tradeOrderingAllowed"]);

    String receiptThankyou = "";
    if (objReceipt.checkoutReceiptOrders.Count == 1)
    {
        receiptThankyou = HtmlHelperExtra.Resource("CheckoutReceiptThankyouSingle", l, c, d).ToString();

        if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) == true && tradeOrderingAllowed)
        {
            receiptThankyou = HtmlHelperExtra.Resource("TradeCheckoutReceiptThankyouSingle", l, c, d).ToString();
        }
    }
    else
    {
        receiptThankyou = HtmlHelperExtra.Resource("CheckoutReceiptThankyouMultiple", l, c, d).ToString();

        if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) == true && tradeOrderingAllowed)
        {
            receiptThankyou = HtmlHelperExtra.Resource("TradeCheckoutReceiptThankyouMultiple", l, c, d).ToString();
        }
    }

    String basketTotalExVat = "0.00";
    if (objReceipt.checkoutReceiptTotalExVats.Count > 0)
    {
        if (objReceipt.checkoutReceiptTotalExVats[0].TotalExVAT == null) { }
        else
        {
            basketTotalExVat = ((decimal)objReceipt.checkoutReceiptTotalExVats[0].TotalExVAT).ToString("0.00");
        }
    }

    string linesTotalExVAT = "0.00";
    if (objReceipt.checkoutReceiptOrderLines.Count > 0)
    {
        linesTotalExVAT = objReceipt.checkoutReceiptOrderLines.Select(p => p.PriceEx * p.Quantity).Sum().ToString("0.00");
    }

    decimal subTotal = objReceipt.checkoutReceiptTransactionDetails[0].Revenue.HasValue ? objReceipt.checkoutReceiptTransactionDetails[0].Revenue.Value : 0;

    decimal tax = objReceipt.checkoutReceiptTransactionDetails[0].Tax.HasValue ? objReceipt.checkoutReceiptTransactionDetails[0].Tax.Value : 0;
    
    var productTotal = objReceipt.checkoutReceiptTotalExVats[0].ProductTotal;

    var discount = objReceipt.checkoutReceiptTotalExVats[0].DiscountTotal;

    var shipping = objReceipt.checkoutReceiptTotalExVats[0].ShippingTotal;

    var grandTotal = objReceipt.checkoutReceiptTotalExVats[0].GrandTotal;
    
    var gbNFI = new System.Globalization.CultureInfo("en-GB").NumberFormat;

    gbNFI.NumberGroupSeparator = "";

    var coNFI = new System.Globalization.CultureInfo(objAddendum.CheckoutCulture);
}

<style type="text/css">
    #checkout-header {
        display: none;
    }
</style>

@Render.Script("~/bundles/js/checkout-confirm")

