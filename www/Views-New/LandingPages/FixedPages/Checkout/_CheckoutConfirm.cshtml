@model FixedPageViewModel_CheckoutConfirm
@using wwwDesignersGuild.Models.Classes;
@using wwwDesignersGuild.Models.Helper;
@{
    var objMaster = Model.PassCheckoutConfirm.masterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;

    var objReceipt = Model.PassCheckoutConfirm.checkoutReceipt;

    String urlDate = "";

    if (Request.QueryString["dateOverride"] == null) { }
    else
    {
        urlDate = String.Format("?dateOverride={0}", Request.QueryString["dateOverride"].ToString());
    }

    Boolean tradeOrderingAllowed = Convert.ToBoolean(Session["tradeOrderingAllowed"]);

    String receiptThankyou = "";
    if (objReceipt.checkoutReceiptOrders.Count == 1)
    {
        receiptThankyou = HtmlHelperExtra.Resource("CheckoutReceiptThankyouSingle", l, c, d).ToString();

        if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) == true && tradeOrderingAllowed)
        {
            receiptThankyou = HtmlHelperExtra.Resource("TradeCheckoutReceiptThankyouSingle", l, c, d).ToString();
        }
    }
    else
    {
        receiptThankyou = HtmlHelperExtra.Resource("CheckoutReceiptThankyouMultiple", l, c, d).ToString();

        if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) == true && tradeOrderingAllowed)
        {
            receiptThankyou = HtmlHelperExtra.Resource("TradeCheckoutReceiptThankyouMultiple", l, c, d).ToString();
        }
    }

    String basketTotalExVat = "0.00";
    if (objReceipt.checkoutReceiptTotalExVats.Count > 0)
    {
        if (objReceipt.checkoutReceiptTotalExVats[0].TotalExVAT == null) { }
        else
        {
            basketTotalExVat = ((decimal)objReceipt.checkoutReceiptTotalExVats[0].TotalExVAT).ToString("0.00");
        }
    }

    string linesTotalExVAT = "0.00";
    if (objReceipt.checkoutReceiptOrderLines.Count > 0)
    {
        linesTotalExVAT = objReceipt.checkoutReceiptOrderLines.Select(p => p.PriceEx * p.Quantity).Sum().ToString("0.00");
    }

    decimal grandTotal = objReceipt.checkoutReceiptTransactionDetails[0].Revenue.HasValue ? objReceipt.checkoutReceiptTransactionDetails[0].Revenue.Value : 0;
    
    grandTotal += objReceipt.checkoutReceiptTransactionDetails[0].Shipping.HasValue ? objReceipt.checkoutReceiptTransactionDetails[0].Shipping.Value : 0;

    var gbNFI = new System.Globalization.CultureInfo("en-GB").NumberFormat;

    gbNFI.NumberGroupSeparator = "";
}

<div id="ko-wrapper">
    <div class="mt-2 mb-5">
        <h4 class="mb-3">
            @receiptThankyou
        </h4>
        @if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) == true && tradeOrderingAllowed)
        {
            <p>
                @HtmlHelperExtra.Resource("TradeCheckoutReceiptEmailNotification", l, c, d)
            </p>
        }
        else
        {
            <p>
                @HtmlHelperExtra.Resource("CheckoutReceiptEmailNotification", l, c, d)
            </p>
        }
    </div>
    <div class="mb-5">
        @foreach (checkoutReceiptOrder objOrder in objReceipt.checkoutReceiptOrders)
        {
            var order = String.Format("{0} {1}", HtmlHelperExtra.Resource("CheckoutReceiptOrderNumber", l, c, d), objOrder.OrderNumber.ToString());

            var delivery = "";

            if (objOrder.TotalQuantity == 1)
            {
                delivery = String.Format("{0} {1} {2}", String.Format("{0:0.##}", objOrder.TotalQuantity), HtmlHelperExtra.Resource("CheckoutReceiptOrderDelivery", l, c, d), objOrder.displayAddress);
            }
            else
            {
                delivery = String.Format("{0} {1} {2}", String.Format("{0:0.##}", objOrder.TotalQuantity), HtmlHelperExtra.Resource("CheckoutReceiptOrderDelivies", l, c, d), objOrder.displayAddress);
            }

            var estimate = String.Format("{0} {1}", HtmlHelperExtra.Resource("CheckoutReceiptOrderEstimate", l, c, d), objOrder.displayEstimatedDelivery);

            <text>
                <h4 class="mb-3">
                    @Html.Raw(order)
                </h4>
                <p>
                    @Html.Raw(delivery)
                </p>
                <p class="mb-5">
                    @Html.Raw(estimate)
                </p>
            </text>
        }
    </div>
    <a class="btn btn-lg btn-dark" href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.home, ci)">
        @HtmlHelperExtra.Resource("ContinueShopping", l, c, d)
    </a>
</div>

<script>

    Number.prototype.formatCurrency = function () {
        return this.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
    }

    function getCountryDetail() {
        return '@Model.PassCheckoutConfirm.masterDefinition.UrlBreakdown.countryDetails.URL';
    }

    function getUrlDate() {
        return '@urlDate';
    }

    function getResource(resourceKey) {
        var resourceText = '';

        switch (resourceKey) {
            case 'currency':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("currencySymbol", l, c, d))';
                break;

            case 'productCode':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("BasketProductCode", l, c, d))';
                break;

            case 'giftWrappingAvailable':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("BasketGiftWrappingAvailable", l, c, d))';
                break;

            case 'giftWrappingUnavailable':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("BasketGiftWrappingUnavailable", l, c, d))';
                break;

            case 'thankYou':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ThankYou", l, c, d))'
                break;

            case 'majorError':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("MajorError", l, c, d))';
                break;
        }

        return resourceText;
    }

</script>

@{
    System.Threading.Thread.CurrentThread.CurrentCulture = new System.Globalization.CultureInfo("en-GB");
}

