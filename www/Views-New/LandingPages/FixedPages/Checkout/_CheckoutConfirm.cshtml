    <!-- Begin Google Analytics eCommerce Code -->
    <script type="text/javascript" defer>
        console.log('calling window.addLoadFunction for google');
        window.addLoadFunction(() => {
            console.log('window.gtag', window.gtag);
            if (typeof gtag === 'function') {
                let purchaseEvent = {
                    'transaction_id': '@(objReceipt.checkoutReceiptTransactionDetails[0].TransactionID)',
                    'value': @($"{objReceipt.checkoutReceiptTransactionDetails[0].Revenue:F}"),
                    'affiliation': '@(objReceipt.checkoutReceiptTransactionDetails[0].Affiliation)',
                    'shipping': @($"{objReceipt.checkoutReceiptTransactionDetails[0].Shipping:F}"),
                    'tax': @($"{objReceipt.checkoutReceiptTransactionDetails[0].Tax:F}"),
                    'currency': '@(objReceipt.checkoutReceiptTransactionDetails[0].CurrencyCode)',
                    'items': [
                        @foreach (var ol in objReceipt.checkoutReceiptOrderLines)
                        {
                            <text>
                        {
                            'item_id': '@(ol.SKU)',
                            'item_name': '@(ol.ProductName)',
                            'item_category': '@(ol.Category)',
                            'quantity': @($"{ol.Quantity:F}"),
                            'price': @($"{ol.PriceInc:F}")
                        },
                            </text>
                        }
                    ],
                    @if (objReceipt.checkoutReceiptTransactionDetails[0].PromotionCode != null)
                    {
                        <text>
                    'coupon': '@objReceipt.checkoutReceiptTransactionDetails[0].PromotionCode'
                        </text>
                    }
                }

                @switch(Model.CountryID)
                {
                    case 16:
                        @:purchaseEvent['send_to'] = ['default', 'aus'];
                        break;
                    case 175:
                        @:purchaseEvent['send_to'] = ['default', 'nz'];
                        break;
                    default:
                        @:purchaseEvent['send_to'] = ['default'];
                        break;
                }

                console.log('gtag is pushing purchase', purchaseEvent);

                gtag('event', 'purchase', purchaseEvent);

                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

                let googleEnhancedData = {
                    'email': '@(objReceipt.checkoutReceiptOrders[0].Email)'
                }

                let googleEnhancedAddress = {

                };

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].PhoneNumber))
                {
                    @:googleEnhancedData['phone_number'] = '@(objReceipt.checkoutReceiptOrders[0].PhoneNumber)';
                }

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].FullName))
                {
                    var nameSplit = objReceipt.checkoutReceiptOrders[0].FullName.Split(new char[] { ' ' });

                    if (nameSplit.Length == 1)
                    {
                        @:googleEnhancedAddress['first_name'] = '@(nameSplit[0])';
                    }
                    else if (nameSplit.Length >= 2)
                    {
                        @:googleEnhancedAddress['first_name'] = '@(nameSplit[0])';
                        @:googleEnhancedAddress['last_name'] = '@(nameSplit[1])';
                    }
                }

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].AddressLine1))
                {
                    @:googleEnhancedAddress['street'] = '@(objReceipt.checkoutReceiptOrders[0].AddressLine1)';
                }

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].Town))
                {
                    @:googleEnhancedAddress['city'] = '@(objReceipt.checkoutReceiptOrders[0].Town)';
                }

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].County))
                {
                    @:googleEnhancedAddress['region'] = '@(objReceipt.checkoutReceiptOrders[0].County)';
                }

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].PostCode))
                {
                    @:googleEnhancedAddress['postal_code'] = '@(objReceipt.checkoutReceiptOrders[0].PostCode)';
                }

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].CountryCode))
                {
                    @:googleEnhancedAddress['country'] = '@(objReceipt.checkoutReceiptOrders[0].CountryCode)';
                }

                if (Object.keys(googleEnhancedAddress).length) {
                    googleEnhancedData['address'] = googleEnhancedAddress;
                }

                console.log('gtag is setting user_data with', googleEnhancedData);

                gtag('set', 'user_data', googleEnhancedData);

                let awConversionEvent = {
                    'send_to': ['AW-1030129884/bi-ZCMCxvgEQ3JGa6wM'],
                    'value': purchaseEvent.value,
                    'currency': purchaseEvent.currency,
                    'transction_id': '@(objReceipt.checkoutReceiptTransactionDetails[0].TransactionID)'
                }

                console.log('gtag is pushing conversion to AW-1030129884/bi-ZCMCxvgEQ3JGa6wM', awConversionEvent);

                gtag('event', 'conversion', awConversionEvent);
            } else {
                console.log('gtag events were not pushed: gtag was not defined')
            }
        });
    </script>
    <!-- End Google Analytics eCommerce Code -->
    <div id="order-complete-phase" style="display: none;"></div>
    <script type="text/javascript">
        window.addLoadFunction(() => {
            if(typeof fbq === 'function') {
                fbq('track', 'Purchase', {
                    value: @(grandTotal.ToString("N2", gbNFI)),
                    currency: "@(objReceipt.checkoutReceiptTransactionDetails[0].CurrencyCode)"
                });
            }
        })
    </script>
    <script type="text/javascript">
        var brontoCart = {
            "phase": "ORDER_COMPLETE",
            "customerOrderId": @(objReceipt.checkoutReceiptTransactionDetails[0].TransactionID),
            "currency": "@(objReceipt.checkoutReceiptTransactionDetails[0].CurrencyCode)",
            "grandTotal": @(grandTotal.ToString("N2", gbNFI)),
            "taxAmount": @(objReceipt.checkoutReceiptTransactionDetails[0].Tax.HasValue ? objReceipt.checkoutReceiptTransactionDetails[0].Tax.Value.ToString("N2", gbNFI) : "0"),
            "emailAddress": "@(objReceipt.checkoutReceiptOrders[0].Email)",
            "cartUrl": "@(Request.Url.OriginalString)",
            "lineItems": [
               @foreach (var line in objReceipt.checkoutReceiptBrontoLines)
               {
                    <text> {
                    "sku": "@(line.SKU)",
                    "name": "@HtmlHelperExtra.EscapeForJS(line.Name.Replace("\"", ""))",
                    "description": "@HtmlHelperExtra.EscapeForJS(line.Description.Replace("\"", ""))",
                    "category": "@HtmlHelperExtra.EscapeForJS(line.Category.Replace("\"", ""))",
                    "unitPrice": @(line.UnitPrice?.ToString("N2", gbNFI)),
                   @if (line.SalePrice.HasValue)
                    {
                        <text>"salePrice": @(line.SalePrice.Value.ToString("N2", gbNFI)),</text>
                    }
                    "quantity": @(line.Quantity.ToString("N2", gbNFI)),
                    "totalPrice": @(line.TotalPrice?.ToString("N2", gbNFI)),
                    "imageUrl": "@(line.ImageURL)",
                    "productUrl": "@(line.ProductURL)"
                    },
                    </text>
                }
            ]
        };

        window.addLoadFunction(function () {
           if (typeof bronto === 'function') {
                console.log('bronto is pushing cart:send with', brontoCart);
                bronto('cart:send', brontoCart);
            }
            if (typeof _dmTrack != 'undefined') {

               @foreach (var line in objReceipt.checkoutReceiptOrderLines)
               {
                    <text>

                    _dmTrack('productId', '@(line.ProductID)');
                    _dmTrack('productSku', '@(line.SKU)');
                    _dmTrack('productName', '@(HtmlHelperExtra.EscapeForJS(line.ProductName.Replace("'", "")))');
                    _dmTrack('productCategory', '@(HtmlHelperExtra.EscapeForJS(line.Category.Replace("'", "")))');
                    _dmTrack('productPriceEx', '@(line.PriceEx.ToString("N2", gbNFI))');
                    _dmTrack('productPriceInc', '@(line.PriceInc.ToString("N2", gbNFI))');
                    _dmTrack('productQuantity', '@(line.Quantity.ToString("N2", gbNFI))');
                    _dmTrack('productTotalPriceEx', '@((line.PriceEx * line.Quantity).ToString("N2", gbNFI))');
                    _dmTrack('productTotalPriceInc', '@((line.PriceInc * line.Quantity).ToString("N2", gbNFI))');

                    </text>
               }

                _dmTrack('transactionId', '@(objReceipt.checkoutReceiptTransactionDetails[0].TransactionID)');
                _dmTrack('currency', '@(objReceipt.checkoutReceiptTransactionDetails[0].CurrencyCode)');
                _dmTrack('grandTotal', '@(grandTotal.ToString("N2", gbNFI))');
                _dmTrack('taxAmount', '@(objReceipt.checkoutReceiptTransactionDetails[0].Tax.HasValue ? objReceipt.checkoutReceiptTransactionDetails[0].Tax.Value.ToString("N2", gbNFI) : "0")');
                _dmTrack('shipping', '@(objReceipt.checkoutReceiptTransactionDetails[0].Shipping.HasValue ? objReceipt.checkoutReceiptTransactionDetails[0].Shipping.Value.ToString("N2", gbNFI) : "0")');
                _dmTrack('emailAddress', '@(objReceipt.checkoutReceiptOrders[0].Email)');
                _dmTrack('cartUrl', '@(Request.Url.OriginalString)')
            }
        });
    </script>

    <script>
        window.uetq = window.uetq || [];
        window.uetq.push({ 'gv': @(grandTotal.ToString("N2", gbNFI)), 'gc': '@(objReceipt.checkoutReceiptTransactionDetails[0].CurrencyCode)'});
    </script>
}

