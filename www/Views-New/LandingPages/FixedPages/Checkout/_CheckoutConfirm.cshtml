                @switch(Model.CountryID)
                {
                    case 16:
                        @:purchaseEvent['send_to'] = ['default', 'aus'];
                        break;
                    case 175:
                        @:purchaseEvent['send_to'] = ['default', 'nz'];
                        break;
                    default:
                        @:purchaseEvent['send_to'] = ['default'];
                        break;
                }

                console.log('gtag is pushing purchase', purchaseEvent);

                gtag('event', 'purchase', purchaseEvent);

                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

                let googleEnhancedData = {
                    'email': '@(objReceipt.checkoutReceiptOrders[0].Email)'
                }

                let googleEnhancedAddress = {

                };

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].PhoneNumber))
                {
                    @:googleEnhancedData['phone_number'] = '@(objReceipt.checkoutReceiptOrders[0].PhoneNumber)';
                }

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].FullName))
                {
                    var nameSplit = objReceipt.checkoutReceiptOrders[0].FullName.Split(new char[] { ' ' });

                    if (nameSplit.Length == 1)
                    {
                        @:googleEnhancedAddress['first_name'] = '@(nameSplit[0])';
                    }
                    else if (nameSplit.Length >= 2)
                    {
                        @:googleEnhancedAddress['first_name'] = '@(nameSplit[0])';
                        @:googleEnhancedAddress['last_name'] = '@(nameSplit[1])';
                    }
                }

               @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].AddressLine1))
                {
                    @:googleEnhancedAddress['street'] = '@(objReceipt.checkoutReceiptOrders[0].AddressLine1)';
