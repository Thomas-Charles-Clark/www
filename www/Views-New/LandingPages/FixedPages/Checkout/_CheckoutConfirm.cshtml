<div id="ko-wrapper">
    @if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) == true && tradeOrderingAllowed)
    {
        <div class="mt-2 mb-5">
            <h4 class="mb-3">
                @receiptThankyou
            </h4>
            <p>
                @HtmlHelperExtra.Resource("TradeCheckoutReceiptEmailNotification", l, c, d)
            </p>
        </div>
    }
    @*else
        {
            <p>
                @HtmlHelperExtra.Resource("CheckoutReceiptEmailNotification", l, c, d)
            </p>
        }*@
    @if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) == true && tradeOrderingAllowed)
    {
        <div class="mb-5">
            @foreach (checkoutReceiptOrder objOrder in objReceipt.checkoutReceiptOrders)
            {
                var order = String.Format("{0} {1}", HtmlHelperExtra.Resource("CheckoutReceiptOrderNumber", l, c, d), objOrder.OrderNumber.ToString());

                var delivery = "";

                if (objOrder.TotalQuantity == 1)
                {
                    delivery = String.Format("{0} {1} {2}", String.Format("{0:0.##}", objOrder.TotalQuantity), HtmlHelperExtra.Resource("CheckoutReceiptOrderDelivery", l, c, d), objOrder.displayAddress);
                }
                else
                {
                    delivery = String.Format("{0} {1} {2}", String.Format("{0:0.##}", objOrder.TotalQuantity), HtmlHelperExtra.Resource("CheckoutReceiptOrderDelivies", l, c, d), objOrder.displayAddress);
                }

                var estimate = String.Format("{0} {1}", HtmlHelperExtra.Resource("CheckoutReceiptOrderEstimate", l, c, d), objOrder.displayEstimatedDelivery);

                <text>
                    <h4 class="mb-3">
                        @Html.Raw(order)
                    </h4>
                    <p>
                        @Html.Raw(delivery)
                    </p>
                    <p class="mb-5">
                        @Html.Raw(estimate)
                    </p>
                </text>
            }
        </div>
    }
    else
    {
        <div id="checkout-receipt-panels">
            <div class="receipt-panel">
                <div>
                    <h1 id="order-confirmation-title">
                        @HtmlHelperExtra.Resource("OrderConfirmation", l, c, d)
                    </h1>
                    <div id="order-confirmation-hero">
                        <h2 id="order-confirmation-subtitle">
                            @(objReceipt.checkoutReceiptOrders[0].FullName), @HtmlHelperExtra.Resource("ThankYouForYourOrder", l, c, d)
                        </h2>
                        <p class="mb-0">
                            @HtmlHelperExtra.Resource(objReceipt.checkoutReceiptOrders.Count > 1 ? "YourOrderNumbersAre" : "YourOrderNumberIs", l, c, d): <b>@(String.Join(", ", objReceipt.checkoutReceiptOrders.Select(p => p.OrderNumber)))</b>.
                            @HtmlHelperExtra.Resource("WeShallSendConfirmation", l, c, d) @(objReceipt.checkoutReceiptOrders[0].Email).
                        </p>
                    </div>
                    <div id="order-confirmation-breakdown">
                        <h3 id="order-total-title">
                            @HtmlHelperExtra.Resource("OrderTotal", l, c, d)
                        </h3>
                        <ul class="list-unstyled">
                            <li>
                                <span class="order-confirmation-breakdown-row">
                                    <span>
                                        @HtmlHelperExtra.Resource("Subtotal", l, c, d)
                                    </span>
                                    <span>
                                        @((productTotal ?? 0m).ToString("C2", coNFI))
                                    </span>
                                </span>
                            </li>
                            <li>
                                <span class="order-confirmation-breakdown-row">
                                    <span>
                                        @HtmlHelperExtra.Resource("Shipping", l, c, d)
                                    </span>
                                    <span>
                                        @((shipping ?? 0.0m).ToString("C2", coNFI))
                                    </span>
                                </span>
                            </li>
                            @if (discount.HasValue)
                            {
                                <li>
                                    <span class="order-confirmation-breakdown-row">
                                        <span>
                                            @HtmlHelperExtra.Resource("Discount", l, c, d)
                                        </span>
                                        <span class="discount">
                                            -@(discount.Value.ToString("C2", coNFI))
                                        </span>
                                    </span>
                                </li>
                            }
                            <li>
                                <div class="hr"></div>
                            </li>
                            <li>
                                <span class="order-confirmation-breakdown-row total-row">
                                    <span>
                                        @HtmlHelperExtra.Resource("Total", l, c, d)
                                    </span>
                                    <span>
                                        @((grandTotal ?? 0m).ToString("C2", coNFI))
                                    </span>
                                </span>
                            </li>
                        </ul>
                    </div>
                </div>
                <div id="order-confirmation-shipping-wrapper">
                    @if (objAddendum.Longitude.HasValue && objAddendum.Latitude.HasValue)
                    {
                        <div id="map"></div>
                    }
                    <div id="order-confirmation-shipping-details">
                        <div>
                            <h4 class="shipping-address">
                                @HtmlHelperExtra.Resource("ShippingAddress", l, c, d)
                            </h4>
                            <div class="address-lines">
                                <span class="fullname">
                                    @(objReceipt.checkoutReceiptOrders[0].FullName)
                                </span>
                                <span>
                                    @Html.Raw(objReceipt.checkoutReceiptOrders[0].AddressLine1)
                                </span>
                                @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].AddressLine2))
                                {
                                    <span>
                                        @Html.Raw(objReceipt.checkoutReceiptOrders[0].AddressLine2)
                                    </span>
                                }
                                @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].Town))
                                {
                                    <span>
                                        @Html.Raw(objReceipt.checkoutReceiptOrders[0].Town)
                                    </span>
                                }
                                @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].County))
                                {
                                    <span>
                                        @Html.Raw(objReceipt.checkoutReceiptOrders[0].County)
                                    </span>
                                }
                                @if (!String.IsNullOrEmpty(objReceipt.checkoutReceiptOrders[0].PostCode))
                                {
                                    <span>
                                        @Html.Raw(objReceipt.checkoutReceiptOrders[0].PostCode)
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="receipt-panel">
                <div class="ratio ratio-1x1">
                    <img class="card-img-top"
                         width="1024"
                         height="1024"
                         width="@HtmlHelperExtra.InitialImageFolderSize(ImageSize.Twelve)"
                         height="@HtmlHelperExtra.InitialImageFolderSize(ImageSize.Twelve)"
                         alt="Checkout Total"
                         src="/image@(Framework.WebPFallback)/@HtmlHelperExtra.InitialImageFolderSize(ImageSize.Twelve)/@(objReceipt.checkoutAddendum.BackgroundImageID)"
                         @HtmlHelperExtra.ImageSourceSetSizes(objAddendum.BackgroundImageID, ImageSize.Twelve) />
                   @if (!String.IsNullOrEmpty(objAddendum.HeroSectionHTML))
                    {
                        <div id="checkout-hero">
                            @Html.Raw(objAddendum.HeroSectionHTML)
                           @if (objAddendum.ClickForPromoCode)
                            {
                                <div class="page-blocker" style="display: none" data-bind="flexFadeVisible: checkoutConfirmViewModel.busy">
                                    <div class="spinner-border"></div>
                                    <h3 class="text-white">
                                        Please Wait
                                    </h3>
                                </div>
                                <a class="btn btn-lg btn-dark w-100" href="#" data-bind="click: checkoutConfirmViewModel.submitSignup">
                                    @HtmlHelperExtra.Resource("NewsletterSignUp", l, c, d)
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
        <a class="btn btn-lg btn-dark px-4 gap-3" href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.home, ci)">
            @HtmlHelperExtra.Resource("ContinueShopping", l, c, d)
        </a>
    </div>
</div>

<script>

    initMap();

    Number.prototype.formatCurrency = function () {
        return this.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
    }

    function getCountryDetail() {
        return '@Model.PassCheckoutConfirm.masterDefinition.UrlBreakdown.countryDetails.URL';
    }

    function getUrlDate() {
        return '@urlDate';
    }

    function getResource(resourceKey) {
        var resourceText = '';

        switch (resourceKey) {
            case 'currency':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("currencySymbol", l, c, d))';
                break;

            case 'productCode':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("BasketProductCode", l, c, d))';
                break;

            case 'giftWrappingAvailable':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("BasketGiftWrappingAvailable", l, c, d))';
                break;

            case 'giftWrappingUnavailable':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("BasketGiftWrappingUnavailable", l, c, d))';
                break;

            case 'thankYou':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ThankYou", l, c, d))'
                break;

            case 'majorError':
                resourceText = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("MajorError", l, c, d))';
                break;
        }

        return resourceText;
    }

</script>

