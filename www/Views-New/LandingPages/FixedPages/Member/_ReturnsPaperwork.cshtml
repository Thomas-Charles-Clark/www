@model FixedPageViewModel_ReturnsPaperwork
@{
    var objMaster = Model.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;
}
@Render.StylesPreload("~/bundles/css/member-order-history")
@if (dgFramework.IsMobileDevice())
{
    @Render.StylesPreload("~/bundles/css/member-order-history-mobile")
}
@Html.Partial("~/Views-New/LandingPages/Shared/_KnockoutKendoComponents.cshtml", Model.BaseViewModel)
@Render.Script("~/bundles/js/order-history")
<div class="member-wrapper">
    <div class="page-blocker" style="display: flex; opacity: 1.0" data-bind="remove">
        <div class="spinner-border"></div>
        <h4>
            @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
        </h4>
    </div>
    <div style="display: none" data-bind="visible: true, with: memberOrderHistoryModel">
        <div class="page-blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
            <div class="spinner-border"></div>
            <h4>
                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
            </h4>
        </div>
        <h4 class="mb-3">
            @HtmlHelperExtra.Resource("GenerateReturnsPaperwork", l, c, d)
        </h4>
        @*<div class="search-controls">
            <div>
                <div class="select-group">
                    <select id="statuses" class="form-select" data-bind="options: displayStatuses, optionsText: 'Name', value: selectedStatus"></select>
                    <select id="history" class="form-select" data-bind="options: displayDateRanges, optionsText: 'Name', value: selectedDateRange"></select>
                </div>
            </div>
            <div>
                <div class="input-group">
                    <input type="text" class="form-control" data-bind="enterKey: fetchOrderHistory, textInput: searchTerm,
                            attr: { placeholder: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("EnterSearch", l, c, d))' }" />
                    <button class="btn btn-outline-secondary" data-bind="click: fetchOrderHistory">
                        <span class="visually-hidden">
                            @HtmlHelperExtra.Resource("EnterSearch", l, c, d)
                        </span>
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>*@
        <!-- ko if: orders().length == 0 -->
        <h4 class="mt-3">
            @HtmlHelperExtra.Resource("orderHistoryNoOrdersFound", l, c, d)
        </h4>
        <!-- /ko -->
        <div class="order-history-grid grid mt-3">
            <!-- ko foreach: orders -->
            <div class="order">
                <div class="dates-totals">
                    <span data-bind="text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("Order", l, c, d)) #: ' + OrderHeadID"></span>
                    <span data-bind="text: displayStatus"></span>
                    <span data-bind="text: DisplayOrderDate"></span>
                    <span data-bind="text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("Total", l, c, d)): ' + DisplayOrderTotal"></span>
                </div>
                <div class="order-items">
                    <div class="order-items-header">
                        <span class="display-block">
                            @HtmlHelperExtra.Resource("DeliveryEstimate", l, c, d):
                            <span data-bind="text: DisplayDelivery"></span>
                        </span>
                        <span class="display-block">
                            @HtmlHelperExtra.Resource("DispatchTo", l, c, d)
                            <span data-bind="text: FullName ? FullName + ', ' : ''"></span>
                            <span data-bind="text: AddressLine1 ? AddressLine1 + ', ' : ''"></span>
                            <span data-bind="text: AddressLine2 ? AddressLine2 + ', ' : ''"></span>
                            <span data-bind="text: County ? County + ', ' : ''"></span>
                            <span data-bind="text: PostCode ? PostCode + ', ' : ''"></span>
                            <span data-bind="text: Country ? Country : ''"></span>
                        </span>
                    </div>
                    <div class="order-items-body grid">
                        <!-- ko foreach: items -->
                        <div class="order-item">
                            <div class="order-item-header">
                                <!-- ko if: DisplayURL -->
                                <a data-bind="attr: { href: DisplayURL }">
                                    <img class="thumb" data-bind="attr: { src: '/image@(Framework.WebPFallback)/322/' + ImageID }" />
                                </a>
                                <!-- /ko -->
                                <!-- ko ifnot: DisplayURL -->
                                <img class="thumb" data-bind="attr: { src: '/image@(Framework.WebPFallback)/322/' + ImageID }" />
                                <!-- /ko -->
                            </div>
                            <div class="order-item-body">
                                <span class="display-block text-bold" data-bind="text: Name"></span>
                                <span class="display-block text-bold" data-bind="text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("Quantity", l, c, d)): ' + Quantity"></span>
                                <!-- ko ifnot: AllowReturns -->
                                <span class="display-block text-bold previous-return-orange">
                                    @HtmlHelperExtra.Resource("orderHistoryNotPossibleToReturn", l, c, d)
                                </span>
                                <!-- /ko -->
                                <!-- ko if: returnedQuantity() -->
                                <span class="display-block text-bold previous-return-orange" data-bind="text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("orderHistoryPreviouslyReturned", l, c, d)): ' + returnedQuantity()"></span>
                                <!-- /ko -->
                                <span class="display-block" data-bind="text: Code"></span>
                                <!-- ko if: trackingInfo().length == 0 -->
                                <span class="display-block order-status" data-bind="text: displayStatus"></span>
                                <!-- /ko -->
                                <!-- ko if: trackingInfo().length -->
                                <span class="display-block order-status">
                                    @HtmlHelperExtra.Resource("orderHistoryTrackingDispatchedIn", l, c, d)
                                    <span class="text-bold" data-bind="text: trackingInfo().length"></span>
                                    <span class="text-bold" data-bind="text: resources.Parcel + (trackingInfo().length > 1 ? 's' : '')"></span>
                                </span>
                                <!-- ko foreach: trackingInfo() -->
                                <!-- ko if: ParcelTrackingURL.indexOf('http') === 0 -->
                                <a class="tracking-url" data-bind="attr: { href: ParcelTrackingURL, target: '_blank'}">
                                    @HtmlHelperExtra.Resource("Track", l, c, d)
                                    -
                                    @HtmlHelperExtra.Resource("orderHistoryTrackingDispatchedOn", l, c, d):
                                    <span data-bind="text: DisplayDispatchedDate"></span>
                                </a>
                                <!-- /ko -->
                                <!-- /ko -->
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="order-controls">
                    <button class="btn btn-dark" data-bind="click: $parent.showReturnModal">
                        @HtmlHelperExtra.Resource("orderHistoryReturnReplaceItems", l, c, d)
                    </button>
                    @*<button class="btn btn-secondary" data-bind="click: $parent.displayReceiptPdf">
                        @HtmlHelperExtra.Resource("orderHistoryViewReceipt", l, c, d)
                    </button>*@
                </div>
            </div>
            <!-- /ko -->
        </div>
    </div>
</div>
<div id="return-modal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="container">
        <div class="modal-dialog modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title dates-totals">
                        @HtmlHelperExtra.Resource("Returns", l, c, d)
                    </h4>
                    <button class="btn-close" data-bind="click: memberOrderHistoryModel.hideReturnModal"></button>
                </div>
                <div class="modal-body" data-bind="with: memberOrderHistoryModel">
                    <ul class="nav nav-pills">
                        <li class="nav-item"
                            role="presentation">
                            <button type="button"
                                    class="nav-link active"
                                    data-bs-toggle="tab"
                                    data-bs-target="#return-items"
                                    role="tab">
                                @HtmlHelperExtra.Resource("orderHistoryReturnItems", l, c, d)
                            </button>
                        </li>
                        <li class="nav-item"
                            role="presentation">
                            <button type="button"
                                    class="nav-link"
                                    data-bs-toggle="tab"
                                    data-bs-target="#previous-returns"
                                    role="tab">
                                <!-- ko with: inspectingOrder -->
                                <span data-bind="text: $parent.resources.orderHistoryPreviousReturns + ' (' + returnedItems().length + ')'"></span>
                                <!-- /ko -->
                            </button>
                        </li>
                        <li class="nav-item"
                            role="presentation">
                            <button type="button"
                                    class="nav-link"
                                    data-bs-toggle="tab"
                                    data-bs-target="#returns-policy"
                                    role="tab">
                                @HtmlHelperExtra.Resource("orderHistoryReturnsPolicyHeader", l, c, d)
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div id="return-items" class="tab-pane fade show active" data-bind="with: inspectingOrder">
                            <h4 class="mb-0">
                                @HtmlHelperExtra.Resource("orderHistoryReturnItemsInfo", l, c, d)
                            </h4>
                            <div class="order-history-grid grid mt-3">
                                <div class="order">
                                    <div class="dates-totals">
                                        <span data-bind="text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("Order", l, c, d)) #: ' + OrderHeadID"></span>
                                        <span data-bind="text: displayStatus"></span>
                                        <span data-bind="text: DisplayOrderDate"></span>
                                        <span data-bind="text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("Total", l, c, d)): ' + DisplayOrderTotal"></span>
                                    </div>
                                    <div class="order-items">
                                        <div class="order-items-header">
                                            <span class="display-block">
                                                @HtmlHelperExtra.Resource("DeliveryEstimate", l, c, d):
                                                <span data-bind="text: DisplayDelivery"></span>
                                            </span>
                                            <span class="display-block">
                                                @HtmlHelperExtra.Resource("DispatchTo", l, c, d)
                                                <span data-bind="text: FullName ? FullName + ', ' : ''"></span>
                                                <span data-bind="text: AddressLine1 ? AddressLine1 + ', ' : ''"></span>
                                                <span data-bind="text: AddressLine2 ? AddressLine2 + ', ' : ''"></span>
                                                <span data-bind="text: County ? County + ', ' : ''"></span>
                                                <span data-bind="text: PostCode ? PostCode + ', ' : ''"></span>
                                                <span data-bind="text: Country ? Country : ''"></span>
                                            </span>
                                        </div>
                                        <div class="order-items-body grid">
                                            <!-- ko foreach: items -->
                                            <div class="order-item">
                                                <div class="order-item-header">
                                                    <!-- ko if: DisplayURL -->
                                                    <a data-bind="attr: { href: DisplayURL }">
                                                        <img class="thumb" data-bind="attr: { src: '/image@(Framework.WebPFallback)/322/' + ImageID }" />
                                                    </a>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: DisplayURL -->
                                                    <img class="thumb" data-bind="attr: { src: '/image@(Framework.WebPFallback)/322/' + ImageID }" />
                                                    <!-- /ko -->
                                                </div>
                                                <div class="order-item-body">
                                                    <span class="display-block text-bold" data-bind="text: Name"></span>
                                                    <span class="display-block text-bold" data-bind="text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("Quantity", l, c, d)): ' + Quantity"></span>
                                                    <!-- ko if: returnedQuantity() -->
                                                    <span class="display-block text-bold previous-return-orange" data-bind="text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("orderHistoryPreviouslyReturned", l, c, d)): ' + returnedQuantity()"></span>
                                                    <!-- /ko -->
                                                    <span class="display-block" data-bind="text: Code"></span>
                                                    <span class="display-block orderStat" data-bind="text: displayStatus"></span>
                                                </div>
                                                <div class="order-item-return">
                                                    <!-- ko ifnot: AllowReturns -->
                                                    <h4 class="previous-return-orange">
                                                        @HtmlHelperExtra.Resource("orderHistoryNotPossibleToReturn", l, c, d)
                                                    </h4>
                                                    <!-- /ko -->
                                                    <!-- ko if: AllowReturns -->
                                                    <div class="return-quantity" data-bind="visible: returnable">
                                                        <div class="input-group" data-bind="validationOptions: { insertMessages: false }">
                                                            <button class="btn btn-secondary progress-btn"
                                                                    data-bind="css: { 'validation-element': !quantityReturning.isValid() },
                                                                                click: decreaseQuantity">
                                                                <i class="bi bi-dash-lg"></i>
                                                            </button>
                                                            <input type="number"
                                                                   class="form-control progress-btn"
                                                                   aria-invalid="false"
                                                                   autocomplete="off"
                                                                   data-bind="selectOnFocus,
                                                                                keepElement: quantityReturning,
                                                                                validationOptions: { insertMessages: false },
                                                                                validationElement: quantityReturning,
                                                                                numeric: quantityReturning,
                                                                                value: quantityReturning,
                                                                                attr: {
                                                                                    'aria-invalid': !quantityReturning.isValid(),
                                                                                    'min': 1,
                                                                                    'max': unreturnedQuantity,
                                                                                    'step': 1
                                                                                }" />
                                                            <button class="btn btn-secondary progress-btn"
                                                                    data-bind="css: { 'validation-element': !quantityReturning.isValid() },
                                                                                click: increaseQuantity">
                                                                <i class="bi bi-plus-lg"></i>
                                                            </button>
                                                        </div>
                                                        <div class="reason-label">
                                                            <select class="form-select" data-bind="options: $parentContext.$parent.returnReasons(),
                                                                    optionsText: 'Name',
                                                                    optionsCaption: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("orderHistoryReturnReasonPlaceholder", l, c, d))',
                                                                    value: returnReason"></select>
                                                        </div>
                                                        <span class="validation-message" data-bind="attr: {
                                                                    id: `quantity-${OrderLineID}-quantity-error`
                                                                },
                                                                validationMessage: quantityReturning"></span>
                                                    </div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end">
                                <button class="btn btn-secondary" data-bind="enable: returningAnything, click: $parent.saveReturn">
                                    @HtmlHelperExtra.Resource("Proceed", l, c, d)
                                </button>
                            </div>
                        </div>
                        <div id="previous-returns" class="tab-pane fade" data-bind="with: inspectingOrder">
                            <!-- ko if: returnedItems().length == 0 -->
                            <h4 class="mb-3">
                                @HtmlHelperExtra.Resource("orderHistoryNoPreviousReturns", l, c, d)
                            </h4>
                            <!-- /ko -->
                            <!-- ko foreach: returnedItems -->
                            <div class="previous-return">
                                <h4 class="display-block text-bold">
                                    @HtmlHelperExtra.Resource("orderHistoryReturnId", l, c, d):
                                    <span data-bind="text: ReturnHeadID"></span>
                                </h4>
                                <span class="display-block text-bold">
                                    @HtmlHelperExtra.Resource("orderHistoryReturnedOn", l, c, d):
                                    <span data-bind="text: DisplayCreatedDT"></span>
                                </span>
                                <button class="btn btn-secondary" data-bind="click: $parentContext.$parent.displayReturnPdf, attr: { href: 'javascript:;' }">
                                    @HtmlHelperExtra.Resource("orderHistoryViewReturnsPaperwork", l, c, d)
                                </button>
                            </div>
                            <!-- /ko -->
                        </div>
                        <div id="returns-policy" class="tab-pane fade">
                            @Html.Action("_displaySnippetTextOnly", "Section", new passSnippet
                            {
                                masterDefinition = Model.MasterDefinition,
                                SnippetLocationID = (byte)snippetDefinitions.shopReturn
                            })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function getOrderHeads() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.OrderHistory.OrderHeads));
    }
    function getOrderLines() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.OrderHistory.OrderLines));
    }
    function getReturnedItems() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.OrderHistory.PreviousReturns));
    }
    function getTrackingLines() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.OrderHistory.OrderLineTracking));
    }
    function getStatuses() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.OrderHistory.OrderStatuses));
    }
    function getReturnReasons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.OrderHistory.ReturnReasons));
    }
    function getDisplayStatuses() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.OrderHistory.OrderStatusList.Where(p => p.OrderStatusID != 5).ToList())); @* Excludes "Dispatched - Invoiced" *@
    }
    function getDisplayDateRanges() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.OrderHistory.DateRangeList));
    }
</script>