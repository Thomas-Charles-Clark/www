@model wwwDesignersGuild.ViewModels.Trade.TradeAccountRequestViewModel
@using wwwDesignersGuild.Models.Classes;
@using wwwDesignersGuild.Models.Helper;

@{
    var tradeOrderingAllowed = Convert.ToBoolean(Session["tradeOrderingAllowed"]);
    var objMaster = Model.BaseViewModel.MasterDefinition;

    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var d = objMaster.UrlBreakdown.ContentDate;
}
<script src='https://www.google.com/recaptcha/api.js?hl=@(objMaster.UrlBreakdown.countryDetails.LanguageCode)' async="async" defer="defer"></script>

@Render.StylesPreload("~/bundles/css/trade")
@if (dgFramework.IsMobileDevice())
{
    @Render.StylesPreload("~/bundles/css/trade-mobile")
}
@Html.Partial("~/Views-New/LandingPages/Shared/_KnockoutKendoComponents.cshtml", Model.BaseViewModel)

<div class="row">
    <div class="col-full header">
        <h1>@(Model.heading)</h1>
        <span>@(Model.subHeading)</span>
    </div>
</div>

<div data-bind="stopBinding">
    <div id="trade-wrapper">
        <div class="page-blocker" style="display: flex; opacity: 1.0" data-bind="remove">
            <div class="spinner-border"></div>
            <h4>
                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
            </h4>
        </div>
        <div id="trade-account-request" style="display: none" data-bind="visible: true">
            <form id="tarf-form" class="address-form" onsubmit="return false;">
                <div class="page-blocker" data-bind="flexVisible: submitBusy, toggleOpacity: submitBusy">
                    <div class="spinner-border"></div>
                    <h4>
                        @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                    </h4>
                </div>
                <div style="display: none;"
                     class="alert alert-success"
                     data-bind="visible: success()">
                    <h3 class="alert-heading">
                        @HtmlHelperExtra.Resource("ThankYou", l, c, d)
                    </h3>
                    <p>
                        @HtmlHelperExtra.Resource("TradeAccountRequestSuccess2", l, c, d)
                    </p>
                    @if (Model.immediateOrderRequested) { }
                    else
                    {
                        <p style="display: none" data-bind="visible: !immediateOrderRequested()">
                            @HtmlHelperExtra.Resource("TradeAccountRequestSuccess3a", l, c, d)
                            <a href="javascript:;" data-bind="click: function() { setImmediateOrderRequest() }">
                                @HtmlHelperExtra.Resource("checkoutTradeAccountRegistrationMessage2", l, c, d)
                            </a>
                        </p>
                        <p style="display: none" data-bind="visible: immediateOrderRequested()">
                            @HtmlHelperExtra.Resource("TradeAccountRequestSuccess3b", l, c, d)
                        </p>
                    }
                    <p class="mb-0">
                        @HtmlHelperExtra.Resource("TradeAccountRequestSuccess4", l, c, d)
                    </p>
                </div>
                <div data-bind="visible: !success()">
                    <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: companyNameParams }"></div>
                    <div class="mb-3" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: businessTypeDropDownList }"></div>
                    <div class="mb-3" data-bind="visible: channelId() === 0, component: { name: 'mdc-text-field-component', params: businessTypeOtherParams }"></div>
                    <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: companyRegistrationParams }"></div>
                    @* Only the Swiss have this separate *@
                    <div class="mb-3" data-bind="visible: invoiceAddress.countryId() === 46">
                        <div data-bind="component: { name: 'mdc-text-field-component', params: taxIdParams }"></div>
                    </div>
                    <div class="mb-3" data-bind="visible: vatRegisteredVisible, component: { name: 'mdc-checkbox-component', params: areYouVATRegisteredParams }"></div>
                    @* But anyone could have a VAT Number *@
                    <div class="mb-3" data-bind="visible: vatRegistered">
                        <!-- ko if: invoiceAddress.countryId() != 238 -->
                        <div class="hstack gap-0 address-search-wrapper mb-3">
                            <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: vatCountryDropDownListParams }"></div>
                            <div data-bind="component: { name: 'mdc-text-field-component', params: vatNumberParams }"></div>
                        </div>
                        <div data-bind="component: { name: 'mdc-text-field-component', params: vatNumberDisplayParams }"></div>
                        <!-- /ko -->
                        <!-- ko if: invoiceAddress.countryId() === 238 -->
                        <div data-bind="component: { name: 'mdc-text-field-component', params: vatNumberParams }"></div>

                        <div class="mb-3">
                            <label class="mt-3 mb-2" data-bind="text: resources.PleaseProvideExemptionCertificate"></label>
                            <div data-bind="component: { name: 'mdc-file-field-component', params: usSalesTaxExemptionCertificateParams }"></div>
                            @*<div class="mdc-validating-field" data-bind="with: usSalesTaxExemptionCertificateParams">
                    <input type="file" name="us-sales-tax-exemption-upload" class="form-control" accept="application/pdf, image/jpg, image/jpeg" data-bind="value: observable, css: { 'mdc-text-field--invalid': observable.isValid }" />
                    <div class="btn-close" data-bind="click: clearFunction, css: { 'disabled':  typeof disabled == 'undefined' ? false : disabled }"></div>
                </div>*@
                            @*<div data-bind="component: { name: 'mdc-text-field-component', params: usSalesTaxExemptionCertificateParams }"></div>*@
                        </div>
                        <!-- /ko -->
                    </div>
                    @* Don't need to be trying to gather EORI numbers for US applications - confirmed with SW 11/02/2025 *@
