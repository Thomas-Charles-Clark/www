                    {
                        <div class="mb-3" data-bind="component: { name: 'mdc-checkbox-component', params: doYouHaveEORIParams }"></div>
                    }
                    <div class="mb-3" data-bind="visible: eoriRegistered, component: { name: 'mdc-text-field-component', params: eoriNumberParams }"></div>
                    <div class="mb-3" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: companyTypeDropDownList }"></div>
                    <div class="mb-3" data-bind="component: { name: 'mdc-checkbox-component', params: doYouSellOnlineParams }"></div>
                    <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: websiteParams }"></div>
