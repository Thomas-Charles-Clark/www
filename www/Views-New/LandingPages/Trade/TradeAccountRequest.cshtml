        </div>*@
                    <div class="mb-3" data-bind="component: { name: 'mdc-text-area-component', params: brandsCurrentlyWorkedWithParams }"></div>
                    <div class="mb-3" data-bind="component: { name: 'mdc-text-area-component', params: whyWorkWithDGParams }"></div>
                    <!-- ko if: availableProductTypeGroups().length -->
                    <h5 class="field-label mt-5 mb-4">
                        @HtmlHelperExtra.Resource("WhichBrandsInterestedIn", l, c, d)
                        <sup>*</sup>
                    </h5>
                    <div id="interest-wrapper" class="form-group">
                        <table id="lead-interest-table"
                               data-bind="validationElement: leadInterests">
                            <thead>
                                <tr>
                                    <th></th>
                                    <!-- ko foreach: availableBrandGroups -->
                                    <th data-bind="html: Key().Name"></th>
                                    <!-- /ko -->
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- ko foreach: availableProductTypeGroups -->
                                <tr>
                                    <th>
                                        <span data-bind="text: Key().Name"></span>
                                    </th>
                                    <!-- ko foreach: Enumerable.From($data.source).OrderBy('$.BrandSortOrder').ToArray() -->
                                    <!-- ko if: Available -->
                                    <td>
                                        <label class="col-form-label pointer" data-bind="validationOptions: { insertMessages: false }">
