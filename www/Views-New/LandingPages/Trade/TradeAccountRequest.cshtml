                        </h4>
                        <button class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">
                            @HtmlHelperExtra.Resource("TradeAccountRequestSuccess3b", l, c, d)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div id="warning-modal"
             class="modal fade">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">
                            @HtmlHelperExtra.Resource("Warning", l, c, d)
                        </h4>
                        <button class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>
                            @HtmlHelperExtra.Resource("TradeAccountFormWeNoticed1", l, c, d)
                        </p>
                        <!-- ko ifnot: companyRegistration -->
                        <p class="absent-field">
                            @HtmlHelperExtra.Resource("CompanyRegistrationNumber", l, c, d)
                        </p>
                        <!-- /ko -->
                        <!-- ko ifnot: companyVATNumber -->
                        <p class="absent-field">
                            @HtmlHelperExtra.Resource("VATNumber", l, c, d)
                        </p>
                        <!-- /ko -->
                        <!-- ko ifnot: companyEORINumber -->
                        <p class="absent-field">
                            @HtmlHelperExtra.Resource("EORINumber", l, c, d)
                        </p>
                        <!-- /ko -->
                        <!-- ko ifnot: website -->
                        <p class="absent-field">
                            @HtmlHelperExtra.Resource("Website", l, c, d)
                        </p>
                        <!-- /ko -->
                        <p>
                            @HtmlHelperExtra.Resource("TradeAccountFormWeNoticed2", l, c, d)
                        </p>
                        <div class="vstack gap-3">
                            <button class="btn btn-secondary" data-bind="click: ignoreWarningModal">
                                @HtmlHelperExtra.Resource("TradeAccountFormWontProvide", l, c, d)
                                <br />
                                (@HtmlHelperExtra.Resource("TradeAccountFormSubmitWithout", l, c, d))
                            </button>
                            <button class="btn btn-dark" data-bind="click: closeWarningModal">
                                @HtmlHelperExtra.Resource("TradeAccountFormWillProvide", l, c, d)
                                <br />
                                (@HtmlHelperExtra.Resource("ReturnToForm", l, c, d))
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function getAvailableCountries() {
        return @(Html.Raw(Json.Encode(Model.availableCountries.OrderBy(p => p.Name))));
    }

    function getAvailableCounties(value) {
        var initial = @Html.Raw(Json.Encode(Model.availableCounties));
        var r = Enumerable.From(initial).Where(function (x) { return x.CountryCode === value }).ToArray();
        return r;
    }

    function getAvailableTitles() {
        return @Html.Raw(Json.Encode(Model.availableTitles));
    }

    function getAvailableCompanyTypes() {
        return @Html.Raw(Json.Encode(Model.companyTypes));
    }

    function getAvailableBusinessTypes() {
        return [
            { BusinessTypeID: 1, Name: getResource('businessTypeInteriorDesigner') },
            { BusinessTypeID: 2, Name: getResource('businessTypeRetailStore') },
            { BusinessTypeID: 3, Name: getResource('businessTypeOther') }
        ];
    }

    function getAvailableTradingForOptions() {
        return @Html.Raw(Json.Encode(Model.tradingForOptions));
    }

    function getAvailableProductTypeGroupBrands() {
        return @Html.Raw(Json.Encode(Model.productTypeGroups));
    }

    function getAvailableLanguages() {
        return @Html.Raw(Json.Encode(Model.availableLanguages));
    }

    function getContactTypes() {
        return @Html.Raw(Json.Encode(Model.contactTypes));
    }

    function getChannels() {
        return @Html.Raw(Json.Encode(Model.channels));
    }

    function getImmediateOrderState() {
        return @(Model.immediateOrderRequested ? 1 : 0);
    }

    function getLeadId() {
        return @Model.leadId
    }

    ko.validation.rules['minArrayLength'] = {
        validator: function (obj, params) {
            return obj.length >= params.minLength;
        },
        message: "Must have at least {0} {1}"
    };

    ko.validation.registerExtenders();
</script>

@Render.Script("~/bundles/js/trade-account-request")