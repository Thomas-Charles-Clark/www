                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: $parent.countryDropDownList() }"></div>
                                    <div class="flex-grow-1" data-bind="component: { name: 'mdc-text-field-pca-component', params: $parent.pcaLookup, descendantsComplete: $parent.descendantsComplete }"></div>
                                </div>
                                <hr class="me-5" />
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: name }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: companyName }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: addressLine1 }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: addressLine2 }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: town }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: county }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: postcode }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: countryDropDownList() }"></div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="flex-heading my-4">
                            <h5 class="field-label">
                                @HtmlHelperExtra.Resource("TradeAccountDeliveryAddress", l, c, d)
                                <sup>*</sup>
                            </h5>
                            <div data-bind="component: { name: 'mdc-checkbox-component', params: deliverySameAsInvoiceParams }"></div>
                        </div>
                        <div data-bind="visible: !deliverySameAsInvoice(), with: deliveryAddressSearch">
                            <div data-bind="with: addressObject">
                                <div class="hstack gap-0 address-search-wrapper mb-3">
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: $parent.countryDropDownList() }"></div>
                                    <div class="flex-grow-1" data-bind="component: { name: 'mdc-text-field-pca-component', params: $parent.pcaLookup, descendantsComplete: $parent.descendantsComplete }"></div>
                                </div>
                                <hr class="me-5" />
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: name }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: companyName }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: addressLine1 }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: addressLine2 }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: town }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: county }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-text-field-component', params: postcode }"></div>
                                <div class="mb-3" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: countryDropDownList() }"></div>
                            </div>
                        </div>
                    </div>
                    @*<div class="form-group">
            <div class="flex-heading my-4">
                <h5 class="field-label">
                    @HtmlHelperExtra.Resource("TradeAccountVisitAddress", l, c, d)
                    <sup>*</sup>
                </h5>
                <div data-bind="component: { name: 'mdc-checkbox-component', params: visitSameAsInvoiceParams }"></div>
