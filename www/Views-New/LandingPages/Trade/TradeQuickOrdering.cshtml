                            <!-- /ko -->
                            <!-- ko if: target == "ContactCS" -->
                            <a class="order-form-stock-message pointer" href="javascript:;" data-bind="html: stockMessage, click: () => { window.showContactCustomerServices(); }"></a>
                            <!-- /ko -->
                            <!-- ko if: target == "POBreakdown" -->
                            <a class="order-form-stock-message pointer" href="javascript:;" data-bind="html: stockMessage, click: () => { window.quickOrderingViewModel.stockInfoModel.showStockInfo($parentContext.$parent, 1) }"></a>
                            <!-- /ko -->
                            <!-- /ko -->
                            <!-- ko if: typeof target == "undefined" -->
                            <span class="order-form-stock-message" data-bind="html: stockMessage"></span>
                            <!-- /ko -->
                            <!-- /ko -->
                            <!-- /ko -->
                            <!-- ko if: stockMessage.allowBackInStockReminder -->
                            <a href="javascript:;" class="order-form-stock-message" data-bind="click: window.basketModel.backInStockReminder">
                                @HtmlHelperExtra.Resource("BISRAnchorText", l, c, d)
                            </a>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                @*<div class="flex-grow-0 text-end product-price" data-bind="html: priceMessage"></div>*@
            </div>
            <!-- ko if: controls.allowOrder -->
            <!-- ko with: getProductByBasketLineType(productId, @(OrderFormItemType.Order.GetAttributeOfType<BasketLineTypeAttribute>().BasketLineTypeID)) -->
            <!-- ko template: { name: 'ko-order-form-item-button-template', data: Object.assign($data, { enable: !$parent.controls.disableOrder }), afterRender: buildPopover } --><!-- /ko -->
            <!-- /ko -->
            <!-- /ko -->
            <!-- ko if: controls.allowReserve -->
            <!-- ko with: getProductByBasketLineType(productId, @(OrderFormItemType.Reserve.GetAttributeOfType<BasketLineTypeAttribute>().BasketLineTypeID)) -->
            <!-- ko template: { name: 'ko-order-form-item-button-template', data: Object.assign($data, { enable: !$parent.controls.disableOrder }), afterRender: buildPopover } --><!-- /ko -->
            <!-- /ko -->
            <!-- /ko -->
            <!-- ko if: controls.allowReserveWithBatchSample -->
            <!-- ko with: getProductByBasketLineType(productId, @(OrderFormItemType.ReserveWithBatchCutting.GetAttributeOfType<BasketLineTypeAttribute>().BasketLineTypeID)) -->
            <!-- ko template: { name: 'ko-order-form-item-button-template', data: Object.assign($data, { enable: !$parent.controls.disableOrder }), afterRender: buildPopover } --><!-- /ko -->
            <!-- /ko -->
            <!-- /ko -->
            <!-- ko if: controls.allowSample -->
            <!-- ko with: getProductByBasketLineType(sample.productId, @(OrderFormItemType.Sample.GetAttributeOfType<BasketLineTypeAttribute>().BasketLineTypeID)) -->
            <!-- ko template: { name: 'ko-order-form-item-button-template', data: Object.assign($data, { enable: !$parent.controls.disableSample }), afterRender: buildPopover } --><!-- /ko -->
            <!-- /ko -->
            <!-- /ko -->
            <!-- ko if: controls.allowLargeSample -->
            <!-- ko with: getProductByBasketLineType(largeSample.productId, @(OrderFormItemType.LargeSample.GetAttributeOfType<BasketLineTypeAttribute>().BasketLineTypeID)) -->
            <!-- ko template: { name: 'ko-order-form-item-button-template', data: Object.assign($data, { enable: !$parent.controls.disableSample }), afterRender: buildPopover } --><!-- /ko -->
            <!-- /ko -->
            <!-- /ko -->
        </div>
    </div>
</script>
<script id="ko-order-form-item-button-template" type="text/html">
    <span class="d-none" data-bind="init: { field: enabled, value: enable },  remove"></span>
    <div class="order-form-item trade relative" data-bind="css: { 'mt-0': [2,3].indexOf(basketLineTypeId) > -1 }" onclick="() => { }" onmouseover="() => { }" onmouseout="() => { }">
        <!-- ko if: (orderFormTypeId == 3 || orderFormTypeId == 4) && stockMessage.reserveDisabledText != null -->
        <a class="reserve-overlay pointer"
           role="button"
           tabindex="1"
           data-bs-toggle="popover"
           data-bs-trigger="@(dgFramework.IsMobileDevice() ? "focus blur" : "click hover focus blur")"
           data-bs-custom-class="reserve-popover"
           title="@HtmlHelperExtra.Resource("Information", l, c, d)"
           data-bind="attr: {
                'data-bs-content': stockMessage.reserveDisabledText
            }">
        </a>
        <!-- /ko -->
        <div class="order-form-controls">
            <label for="-quantity" data-bind="attr: {  for: `product-${productId}-order-form-type-${basketLineTypeId}-qty` }">
                @HtmlHelperExtra.Resource("QuantityAbbreviated", l, c, d)
            </label>
            <input type="text" class="form-control"
                   autocomplete="off"
                   data-bind="keepElement: quantity,
                                            selectOnFocus,
                                            validationOptions: { insertMessages: false },
                                            validationElement: quantity,
                                            numeric: quantity,
                                            value: quantity.formatted,
                                            attr: {
                                                id: `product-${productId}-order-form-type-${basketLineTypeId}-qty`,
                                                'aria-invalid': !quantity.isValid(),
                                                'disabled': !enabled(),
                                                'min': stockMessage.quantityMinimum,
                                                'max': stockMessage.quantityMaximum,
                                                'step': stockMessage.quantityIncrement
                                            }" />
            <button class="btn btn-secondary" data-bind="enable: enabled,
                    click: basketModel.addToBasket">
                <!-- ko if: orderFormTypeId == 0 -->
                <span data-bind="text: orderButtonText"></span>
                <!-- /ko -->
                <!-- ko if: orderFormTypeId == 1 -->
                <span data-bind="text: orderButtonText"></span>
                <!-- /ko -->
                <!-- ko if: orderFormTypeId == 2 -->
                <span data-bind="text: orderButtonText"></span>
                <!-- /ko -->
                <!-- ko if: orderFormTypeId == 3 -->
                <span data-bind="text: reserveButtonText"></span>
                <!-- /ko -->
                <!-- ko if: orderFormTypeId == 4 -->
                <span data-bind="text: reserveWithBatchSampleButtonText"></span>
                <!-- /ko -->
            </button>
        </div>
        <span style="display: none;" class="validation-message" data-bind="validationMessage: quantity"></span>
    </div>
</script>

@if (!String.IsNullOrEmpty(Model.Heading))
{
    <div class="row">
        <div class="col-full header check">
            <h2>@(Model.Heading)</h2>
        </div>
    </div>
}
@if (!Model.OverallPermission)
{
    <div class="alert alert-danger trade-message-warning">
        <h4>
            @HtmlHelperExtra.Resource("tradeLoginPermissionFailure1", l, c, d)
            @(Model.TradeAccountModel.AccountDetails.Code) - @(Model.TradeAccountModel.AccountDetails.Name)
        </h4>
        <p>
            @HtmlHelperExtra.Resource("tradeLoginPermissionFailure2", l, c, d)
        </p>
        @foreach (var a in Model.TradeAccountModel.Administrators)
        {
            <p>
                @(a.FullName) <a href="mailto:@a.Email">@a.Email</a>
            </p>
        }
    </div>
}
else
{
    <div data-bind="stopBinding">
        <div id="trade-wrapper">
            <div id="quick-ordering"
                 class="grid">
                <div id="quick-search-container">
                    <div class="basket-title py-4">
                        <h1 class="text-uppercase">
                            @HtmlHelperExtra.Resource("tradeQuickOrder", l, c, d)
                        </h1>
                    </div>
                    <div class="product-search-content">
                        <div class="input-group">
                            <select class="form-select product-type-select"
                                    data-bind="value: productTypeId">
                                <option value="" selected>
                                    @HtmlHelperExtra.Resource("All", l, c, d)
                                </option>
                                @foreach (var pt in Model.ProductTypes)
                                {
                                    <option value="@pt.ProductTypeID">
                                        @pt.Name
                                    </option>
                                }
                            </select>
                            <input type="text"
                                   class="form-control product-search-input"
                                   data-bind="init: { parseString },
                                                enterKey: search,
                                                textInput: searchTerm,
                                                attr: {
                                                    placeholder: resources.EnterSearch
                                                }"
                                   placeholder="@HtmlHelperExtra.Resource("EnterSearch", l, c, d)" />
                            <button class="btn btn-outline-secondary" data-bind="click: search">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="results-pane">
                        <h5 class="no-search-results"
                            style="display: none"
                            data-bind="visible: haveSearched() && !busy() && results().length == 0">
                            @HtmlHelperExtra.Resource("tradeQuickSearchNoResults", l, c, d)
                        </h5>
                        <div class="page-blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
                            <div class="spinner-border"></div>
                            <h4>
                                @HtmlHelperExtra.Resource("Searching", l, c, d)
                            </h4>
                        </div>
                        <!-- ko foreachInit: { name: 'ko-order-form-item-template', data: results, afterQueueFlush: window.lazyImages } --><!-- /ko -->
                    </div>
                </div>
                <div id="quick-basket-container">
                    @Html.Action("Basket", "NewSection", Model.BaseViewModel)
                </div>
            </div>
        </div>
    </div>
}
@Render.Script("~/bundles/js/trade-quick-ordering")