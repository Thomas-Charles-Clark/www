@model OrderFormGroupViewModel
@{
    var l = Model.MasterDefinition.UrlBreakdown.countryDetails.LanguageID;
    var c = Model.MasterDefinition.UrlBreakdown.countryDetails.CountryID;
    var d = Model.MasterDefinition.UrlBreakdown.ContentDate;
    var cd = Model.MasterDefinition.UrlBreakdown.countryDetails;

    int? indexToOpen = null;

    if (Model.AutoOpenFirstSize == true)
    {
        indexToOpen = 0;
    }

    if (!String.IsNullOrEmpty(Model.AutoOpenPartNumber))
    {
        var match = Model.Items.FirstOrDefault(i => i.ProductCode == Model.AutoOpenPartNumber);

        if (match != null)
        {
            indexToOpen = Model.Items.OrderBy(p => p.SortOrder).ToList().IndexOf(match);
        }
    }
}
<div data-init 
     class="order-form-group">
   @if (!String.IsNullOrEmpty(Model.Name))
    {
        <h5 class="text-uppercase pb-3">
            @Model.Name
        </h5>
    }
   @if (Model.UseSizeButtons)
    {
    <span class="d-block mb-2 select-a-size"
          data-bs-parent="#@Model.OrderFormCarouselID">
        @HtmlHelperExtra.Resource("SelectASize", l, c, d)
    </span>
    <div class="grid justify-content-between align-items-center">
       @foreach (var obj in Model.Items.OrderBy(p => p.SortOrder).Select((value, index) => new { value, index }))
       {
           var item = obj.value;
           var index = obj.index;
            <button class="btn btn-light size-button g-col-1 @(indexToOpen != null && obj.index == indexToOpen ? "active" : "")"
                    type="button"
                    aria-controls="@(item.OrderFormCarouselID.Replace("#", ""))"
                    data-bs-target="#@(Model.OrderFormCarouselID)"
                    data-bs-slide-to="@(index + 1)">
                @item.OrderFormName
            </button>
        }
    </div>
    <div id="@(Model.OrderFormCarouselID)" class="pt-2 carousel slide carousel-fade order-form-group-carousel" data-bs-interval="false" data-bs-touch="false">
        <div class="carousel-inner">
            <div class="order-form-product carousel-item mt-0 mb-4 placeholder @(indexToOpen == null ? "active" : "")">
            </div>
            <!-- ko foreachInit: { name: 'ko-blank-template', data: sizeGroups, createElement: createSizeGroup } -->
            @foreach (var value in Model.Items.OrderBy(p => p.SortOrder).Select((item, i) => new { item, i }))
            {
                var item = value.item;
                var index = value.i;

                <div id="@(item.OrderFormCarouselID.Replace("#", ""))"
                     class="order-form-product carousel-item @(indexToOpen != null && index == indexToOpen ? "active" : "")"
                     data-init>
                    @Html.Partial("~/Views-New/ProductPages/Shared/_OrderFormItem.cshtml", item)
                </div>
            }
            <!-- /ko -->
        </div>
    </div>
    <script type="text/javascript">
        document.querySelector('#@(Model.OrderFormCarouselID)').addEventListener('slide.bs.carousel', (event) => {
            
            let selectSizeElement = event.target.parentElement.querySelector('.select-a-size');

            if (selectSizeElement) {
                selectSizeElement.remove();
            }
        });
    </script>
    }
    else
    {
        foreach (var item in Model.Items)
        {
            @Html.Partial("~/Views-New/ProductPages/Shared/_OrderFormItem.cshtml", item)
        }
    }
</div>