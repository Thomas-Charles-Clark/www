@model ProductPageViewModel
@{
    var objMaster = Model.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;

    var tradeUser = objMaster.TradeAllowed;

    var paintPage = Model.PrefetchedSnippets.Any(s => s.SnippetLocationID == 85);
}
<script src='https://www.google.com/recaptcha/api.js?hl=@(ci.LanguageCode)'></script>
@if (paintPage)
{
<div class="modal" tabindex="-1" id="finishes-explained-modal-alt" data-bind="event: { 'hide.bs.modal': () => { bootstrap.Modal.getOrCreateInstance(document.querySelector('#coverage-calculator-modal')).show(); return true; } }">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @HtmlHelperExtra.Resource("FinishesExplained", l, c, d)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.Raw(Model.PrefetchedSnippets.Single(s => s.SnippetLocationID == 85).HTMLContent)
            </div>
        </div>
    </div>
</div>
}
<div class="modal fade" id="coverage-calculator-modal" data-bind="keepElement: coverageCalculator.domElement, with: coverageCalculator">
    <div class="modal-dialog">
        <div class="page-blocker" style="display: flex; opacity: 1.0" data-bind="flexVisible: busy, toggleOpacity: busy">
            <div class="spinner-border" role="status"></div>
            <h4>
                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
            </h4>
        </div>
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    @HtmlHelperExtra.Resource("CoverageCalculator", l, c, d)
                </h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div>
                    <label for="choose-unit" class="form-label d-flex justify-content-between align-items-center">
                        @HtmlHelperExtra.Resource("PleaseSelectUnitOfMeasurement", l, c, d)
                    </label>
                    <select id="choose-unit"
                            class="form-select"
                            data-bind="keepElement: unit,
                                       value: unit">
                        <option selected value="">
                            @HtmlHelperExtra.Resource("PleaseSelect", l, c, d)
                        </option>
                        <option value="cm">
                            @HtmlHelperExtra.Resource("Centimetres", l, c, d)
                        </option>
                        <option value="m">
                            @HtmlHelperExtra.Resource("Metres", l, c, d)
                        </option>
                        <option value="&quot;">
                            @HtmlHelperExtra.Resource("Inches", l, c, d)
                        </option>
                        <option value="ft">
                            @HtmlHelperExtra.Resource("Feet", l, c, d)
                        </option>
                        <option value="yd">
                            @HtmlHelperExtra.Resource("Yards", l, c, d)
                        </option>
                    </select>
                </div>
                <div style="display: none" data-bind="visible: unit">
                   @if (paintPage)
                    {
                    <div class="mt-3">
                        <label for="choose-finish-modal" class="form-label d-flex justify-content-between align-items-center">
                            <span>
                                @HtmlHelperExtra.Resource("SelectAFinish", l, c, d)
                            </span>
                            <a class="small"
                               href="#finishes-explained-modal"
                               data-bs-target="#finishes-explained-modal-alt"
                               data-bs-toggle="modal">
                                @HtmlHelperExtra.Resource("FinishesExplained", l, c, d)
                            </a>
                        </label>
                        <select id="choose-finish-modal"
                                class="form-select"
                                data-bind="keepElement: finish,
                                           options: availableFinishes,
                                           optionsText: 'name',
                                           optionsValue: 'attributeId',
                                           optionsCaption: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("PleaseSelect", l, c, d))',
                                           value: finish">
                        </select>
                    </div>
                    }
                    <ul style="display: none" class="nav nav-tabs nav-fill mt-3" data-bind="visible: @(paintPage ? "finish" : "unit")">
                        <li class="nav-item" role="presentation">
                            <button id="rooms-tab-btn" 
                                    class="nav-link active" 
                                    type="button"
                                    data-bs-toggle="tab"
                                    data-bs-target="#rooms-tab" 
                                    role="tab"
                                    aria-controls="rooms-tab"
                                    aria-selected="true">
                                @HtmlHelperExtra.Resource("Rooms", l, c, d)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button id="walls-tab-btn" 
                                    class="nav-link" 
                                    type="button"
                                    data-bs-toggle="tab"
                                    data-bs-target="#walls-tab" 
                                    role="tab"
                                    aria-controls="walls-tab"
                                    aria-selected="false">
                                @HtmlHelperExtra.Resource("Walls", l, c, d)
                            </button>
                        </li>
                    </ul>
                    <div style="display: none" class="tab-content p-3" data-bind="visible: @(paintPage ? "finish" : "unit")">
                        <div id="rooms-tab" 
                            class="tab-pane fade show active"
                            role="tabpanel"
                            aria-labelledby="rooms-tab-btn">
                            <div class="empty" data-bind="css: { 'empty': rooms().length == 0 }, template: { name: 'ko-measurement-template', foreach: rooms }"></div>
                            <div class="add-feature-wrapper field-wrapper">
                                <button class="btn btn-light w-100" data-bind="click: addRoom">
                                    @HtmlHelperExtra.Resource("AddRoom", l, c, d)
                                </button>
                            </div>
                        </div>
                        <div id="walls-tab" 
                            class="tab-pane fade"
                            role="tabpanel"
                            aria-labelledby="walls-tab-btn">
                            <div class="empty" data-bind="css: { 'empty': walls().length == 0 }, template: { name: 'ko-measurement-template', foreach: walls }"></div>
                            <div class="add-feature-wrapper field-wrapper">
                                <button class="btn btn-light w-100" data-bind="click: addWall">
                                    @HtmlHelperExtra.Resource("AddWall", l, c, d)
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="display: none" data-bind="visible: (rooms().length || walls().length) && (errors().length == 0)">
                <!-- ko if: parent.Definition.json.productTypeId == 8 -->
                <div class="d-flex justify-content-center align-items-center gap-3">
                    <label class="field-label" for="coats">
                        @HtmlHelperExtra.Resource("Coats", l, c, d)
                    </label>
                    <select id="coats"
                            class="form-select"
                            data-bind="keepElement: coats,
                                        value: coats">
                        <option value="1">
                            1
                        </option>
                        <option value="2" selected>
                            2 (@(@HtmlHelperExtra.Resource("Recommended", l, c, d)))
                        </option>
                        <option value="3">
                            3
                        </option>
                        <option value="4">
                            4
                        </option>
                    </select>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="wastage-checkbox"
                               data-bind="checked: includeWastage" />
                        <label class="form-check-label" for="wastage-checkbox">
                            @HtmlHelperExtra.Resource("Include10PercentWastage", l, c, d)
                        </label>
                    </div>
                </div>
                <!-- /ko -->
                <button type="button" class="btn btn-secondary w-100 m-0 mt-2" data-bind="click: () => { calculate(false) }">
                    @HtmlHelperExtra.Resource("Calculate", l, c, d)
                </button>
                <div style="display: none" data-bind="visible: coverageResult, with: coverageResult">
                    <div class="p-3" data-bind="html: RequirementsExplanation"></div>
                   @if (!Model.IsLifestyle && Model.OtherProducts.Any(op => !String.IsNullOrEmpty(op.ClientProductViewModels)))
                    {
                        <!-- ko if: ShoppingList.length -->
                        <p class="mb-3 pt-3 bold">
                            @HtmlHelperExtra.Resource("AddEstimatedQuantity", l, c, d)
                        </p>
                        <div class="hstack gap-3 mb-3">
                            <button type="button" class="btn btn-secondary" data-bind="click: $parent.addEstimateToBasket">
                                @HtmlHelperExtra.Resource("YesPlease", l, c, d)
                            </button>
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                                @HtmlHelperExtra.Resource("NoThanks", l, c, d)
                            </button>
                        </div>
                        <!-- /ko -->
                    }
                    <!-- ko ifnot: Errored -->
                    <button type="button" class="btn btn-light w-100" data-bs-toggle="collapse" data-bs-target="#email-calc-collapse">
                        @HtmlHelperExtra.Resource("EmailCalculatorResults", l, c, d)
                    </button>
                    <div id="email-calc-collapse" class="collapse" data-bind="with: $parent, event: { 'show.bs.collapse': $parent.initCaptcha }">
                        <div class="px-3 pt-5"
                             data-bind="validationOptions: { insertMessages: false }">
                            <div class="d-flex gap-3 align-items-center">
                                <label for="email" class="form-label">
                                    @HtmlHelperExtra.Resource("FormsEmail", l, c, d)
                                </label>
                                <input id="email"
                                       name="email"
                                       class="form-control"
                                       type="text"
                                       aria-errormessage="email-error"
                                       autocomplete="email"
                                       data-bind="keepElement: email,
                                                  textInput: email,
                                                  attr:{
                                                    'aria-invalid': !email.isValid()
                                                  }"
                                       />
                                <span id="email-error" class="validation-message" data-bind="validationMessage: email"></span>
                            </div>
                            <div id="g-recaptcha" class="py-3"></div>
                            <div id="g-recaptcha-tip"
                                    style="display: none"
                                    class="alert alert-danger text-center"
                                    data-bind="visible: captchaFailed">
                                <span class="validation-message">
                                    @HtmlHelperExtra.Resource("FormsErrorCaptchaCompare", l, c, d)
                                </span>
                            </div>
                            <button type="button"
                                    class="btn btn-secondary w-100"
                                    data-bind="click: () => { calculate(true) }">
                                @HtmlHelperExtra.Resource("MoodboardShareSendEmail", l, c, d)
                            </button>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/html" id="ko-measurement-template">
    <div class="measurement-wrapper">
        <div class="relative">
            <div class="field-wrapper">
                <label class="field-label"
                        data-bind="attr: { 'for': widthId }">
                    @HtmlHelperExtra.Resource("Width", l, c, d)
                </label>
                <input type="number"
                        class="form-control"
                        value="1"
                        min="1"
                        max="99"
                        step="1"
                        autocomplete="off"
                        data-bind="init: { convert: parseFloat },
                                    selectOnFocus,
                                    keepElement: width,
                                    validationOptions: { insertMessages: false },
                                    validationElement: width,
                                    numeric: width,
                                    textInput: width,
                                    attr: {
                                        'id': widthId,
                                        'aria-invalid': !width.isValid(),
                                        'aria-errormessage': `${widthId}-error`
                                    }" title="@HtmlHelperExtra.Resource("Width", l, c, d)">
                <label class="unit-display" data-bind="text: $parent.unit"></label>
                <span class="validation-message"
                        data-bind="attr: {
                                    'id': `${widthId}-error`
                                },
                                validationMessage: width"></span>
            </div>
            <!-- ko if: $data.hasOwnProperty('length') -->
            <div class="field-wrapper">
                <label class="field-label"
                        data-bind="attr: { 'for': lengthId }">
                    @HtmlHelperExtra.Resource("Length", l, c, d)
                </label>
                <input type="number"
                        class="form-control"
                        value="1"
                        min="1"
                        max="99"
                        step="1"
                        autocomplete="off"
                        data-bind="init: { convert: parseFloat },
                                    selectOnFocus,
                                    keepElement: length, 
                                    validationOptions: { insertMessages: false },
                                    validationElement: length,
                                    numeric: length, 
                                    textInput: length,
                                    attr: {
                                    'id': lengthId,
                                    'aria-invalid': !length.isValid(),
                                    'aria-errormessage': `${lengthId}-error`
                                    }" title="@HtmlHelperExtra.Resource("Length", l, c, d)">
                <label class="unit-display" data-bind="text: $parent.unit"></label>
                <span class="validation-message"
                        data-bind="attr: {
                                    'id': `${lengthId}-error`
                                },
                                validationMessage: length"></span>
            </div>
            <!-- /ko -->
            <div class="field-wrapper">
                <label class="field-label"
                        data-bind="attr: { 'for': heightId }">
                    @HtmlHelperExtra.Resource("Height", l, c, d)
                </label>
                <input type="number"
                        class="form-control"
                        value="1"
                        min="1"
                        max="99"
                        step="1"
                        autocomplete="off"
                        data-bind="init: { convert: parseFloat },
                                    selectOnFocus,
                                    keepElement: height, 
                                    validationOptions: { insertMessages: false },
                                    validationElement: height,
                                    numeric: height, 
                                    textInput: height,
                                    attr: {
                                    'id': heightId,
                                    'aria-invalid': !height.isValid(),
                                    'aria-errormessage': `${heightId}-error`
                                    }" title="@HtmlHelperExtra.Resource("Height", l, c, d)">
                <label class="unit-display" data-bind="text: $parent.unit"></label>
                <span class="validation-message"
                        data-bind="attr: {
                                    'id': `${heightId}-error`
                                },
                                validationMessage: height"></span>
            </div>
            <button class="btn-close" title="@HtmlHelperExtra.Resource("MoodboardRemove", l, c, d)" data-bind="click: remove">
                <i class="material-icons">
                    delete_forever
                </i>
            </button>
        </div>
        <!-- ko if: $data.hasOwnProperty('exclusions') -->
        <div class="exclusions-wrapper" data-bind="template: { name: 'ko-measurement-template', foreach: exclusions }"></div>
        <button class="btn btn-light w-100 mt-3" data-bind="click: addExclusion">
            @HtmlHelperExtra.Resource("AddExclusion", l, c, d)
        </button>
        <!-- /ko -->
    </div>
</script>