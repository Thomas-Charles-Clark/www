@model ProductPageViewModel_Paint
@{
    var objMaster = Model.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var tradeUser = false;

    if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) &&
        Convert.ToBoolean(Session["tradeOrderingAllowed"]))
    {
        tradeUser = true;
    }

    // we need to get the attributes of the product to select
    // then go through surface, finish and then size in order to force our pre-rendering to be maintained

    var autoOpen = Model.AllProducts.SingleOrDefault(p => p.ProductCode == Model.AutoOpenPartNumber);

    var surfaces = Model.AttributeGroups.SingleOrDefault(ag => ag.AttributeGroupID == 71) ?? new AttributeGroup() { Attributes = new List<AttributeDetail>() };

    var finishes = Model.AttributeGroups.SingleOrDefault(ag => ag.AttributeGroupID == 72) ?? new AttributeGroup() { Attributes = new List<AttributeDetail>() };

    var sizes = Model.AttributeGroups.SingleOrDefault(ag => ag.AttributeGroupID == 73) ?? new AttributeGroup() { Attributes = new List<AttributeDetail>() };

    wwwDesignersGuild.Models.Classes.Attribute autoSurface = null;
    wwwDesignersGuild.Models.Classes.Attribute autoFinish = null;
    wwwDesignersGuild.Models.Classes.Attribute autoSize = null;

    if (autoOpen != null)
    {
        autoSurface = autoOpen.Attributes.FirstOrDefault(a => surfaces.Attributes.Select(at => (int)at.AttributeID).ToList().Contains(a.AttributeID));
        autoFinish = autoOpen.Attributes.FirstOrDefault(a => finishes.Attributes.Select(at => (int)at.AttributeID).ToList().Contains(a.AttributeID));
        autoSize = autoOpen.Attributes.FirstOrDefault(a => sizes.Attributes.Select(at => (int)at.AttributeID).ToList().Contains(a.AttributeID));
    }
}
@section LateTemplateScripts {
    @Render.Script("~/bundles/js/product-page")
    @if (autoOpen != null)
    {
        <script type="text/javascript">
        @if (autoSurface != null)
        {
            @:window.productPageModel.surface(@(autoSurface.AttributeID));
        }
        @if (autoFinish != null)
        {
            @:window.productPageModel.finish(@(autoFinish.AttributeID));
        }
        @if (autoSize != null)
        {
            @:window.productPageModel.size(@(autoSize.AttributeID));
        }
        </script>
    }
}
@Html.Partial("~/Views-New/ProductPages/Shared/_Templates.cshtml")
<div id="ko-wrapper">
    @if ((Model.IsLifestyle == false) && (Model.Definition.Banners?.Where(b => b.BannerLocationID == 71).Any() == true))
    {
        var banner = Model.Definition.Banners.Where(b => b.BannerLocationID == 71).First();

        <div class="product-page-header-banner" data-banner-location-id="71">
            <a href="@banner.LinkURL"
               target="@(banner.NewWindow ? "_blank" : "_self")"
               title="@(banner.TitleText)"
               alt="@(banner.AltText)"
               class="header-banner @(banner.FontClass)"
               style="color: @(String.IsNullOrEmpty(banner.ForegroundColour) ? "inherit" : banner.ForegroundColour);
          background-color: @(String.IsNullOrEmpty(banner.BackgroundColour) ? "inherit" : banner.BackgroundColour)">

                @if (!String.IsNullOrEmpty(banner.OverlayText))
                {
                    <h3 class="banner-overlay-text pb-1 ps-3 pt-1 pe-3">
                        @(banner.OverlayText?.Replace(">", "").Trim())
                    </h3>
                }
                else
                {
                    <img src="/imagebanner@(Framework.WebPFallback)/1024/@(banner.BannerID)?v=@(banner.Version)"
                         alt="@banner.AltText"
                         title="@banner.TitleText"
                         @HtmlHelperExtra.BannerImageSourceSetSizes((long)banner.BannerID, banner.Version, ImageSize.Twelve) />
                }
            </a>
        </div>
    }
    @if (Model.AllProductsUnavailable)
    {
        <div class="d-none" data-bind="init: { convert: JSON.parse }, text: data, remove">
            @JsonConvert.SerializeObject(new ProductPageViewModel_Empty())
        </div>
    }
    else
    {
        <div class="d-none" data-bind="init: { convert: JSON.parse }, text: data, remove">
            @JsonConvert.SerializeObject(Model)
        </div>
    }
    <span class="d-none" data-bind="foreachInit: { name: 'ko-blank-template', data: allSurfaces, createElement: miniAttribute }, remove">
        @{
            foreach (var attribute in surfaces.Attributes)
            {
                <span>
                    <span data-bind="init: { convert: parseInt }, text: attributeId">
                        @attribute.AttributeID
                    </span>
                    <span data-bind="init, text: name">
                        @attribute.Name
                    </span>
                </span>
            }
        }
    </span>
    <span class="d-none" data-bind="foreachInit: { name: 'ko-blank-template', data: allFinishes, createElement: miniAttribute }, remove">
        @{
            foreach (var attribute in finishes.Attributes)
            {
                <span>
                    <span data-bind="init: { convert: parseInt }, text: attributeId">
                        @attribute.AttributeID
                    </span>
                    <span data-bind="init, text: name">
                        @attribute.Name
                    </span>
                </span>
            }
        }
    </span>
    <span class="d-none" data-bind="foreachInit: { name: 'ko-blank-template', data: allSizes, createElement: miniAttribute }, remove">
        @{
            foreach (var attribute in sizes.Attributes)
            {
                <span>
                    <span data-bind="init: { convert: parseInt }, text: attributeId">
                        @attribute.AttributeID
                    </span>
                    <span data-bind="init, text: name">
                        @attribute.Name
                    </span>
                </span>
            }
        }
    </span>
    <div id="product-page-main" class="grid">
        <div id="product-page-carousel-wrapper">
            <div class="mb-3">
                @Html.Partial("~/Views-New/LandingPages/PageSections/_Carousel.cshtml", Model.Carousel)
            </div>
        </div>
        <div id="product-page-order-form-wrapper">
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-top">
                    <div>
                        <h4 class="text-uppercase">
                            @Model.Definition.heading
                            @if (Model.Definition.isNew)
                            {
                                <sup class="heading-new">
                                    @HtmlHelperExtra.Resource("PodNew", l, c, d)
                                </sup>
                            }
                        </h4>
                        @if (!String.IsNullOrEmpty(Model.Definition.aka))
                        {
                            <h6 class="text-uppercase">
                                @Model.Definition.aka
                            </h6>
                        }
                        <h6 class="text-uppercase">
                            @Model.Definition.brand
                        </h6>
                        <h6>
                            @Model.Definition.subHeading
                        </h6>
                        @Model.ReviewStarsDisplay()
                    </div>
                    @if (Model.Prices != null &&
                        Model.ProductPagePrice != null &&
                        JObject.FromObject(Model.ProductPagePrice)["discountMessage"] != null)
                    {
                        <div class="text-end">
                            <h4 class="discount">
                                @JObject.FromObject(Model.ProductPagePrice).SelectToken("discountMessage")
                            </h4>
                        </div>
                    }
                </div>
            </div>
            <div class="my-4">
                <hr />
            </div>
            @Html.Partial("~/Views-New/ProductPages/Shared/_AlternateColourways.cshtml")
            @if (Model.AllProductsUnavailable)
            {
                <h3>
                    @HtmlHelperExtra.Resource("AllProductsUnavailable", l, c, d)
                </h3>
            }
            else
            {
                if (autoOpen == null && Model.SamplePot != null)
                {
                    <div data-bind="foreachInit: { data: samplePotOrderFormGroups, createElement: createOrderFormGroup }">
                        <div data-init
                             class="order-form-group">
                            @Html.Partial("~/Views-New/ProductPages/Shared/_OrderFormItem.cshtml", Model.SamplePot)
                        </div>
                    </div>
                }
                if (Model.LanguageID == 1)
                {
                    <button type="button" class="btn btn-light w-100 mb-3"
                            data-bs-target="#coverage-calculator-modal"
                            data-bs-toggle="modal">
                        @HtmlHelperExtra.Resource("CoverageCalculator", l, c, d)
                    </button>
                }
                if (Model.OtherProducts.Any())
                {
                    <div class="paint-order-form mb-4">
                        <h5 class="mb-4">
                            @HtmlHelperExtra.Resource("ChooseYourPaint", l, c, d)
                        </h5>
                        <div class="mb-4">
                            <label for="choose-surface" class="form-label">
                                @HtmlHelperExtra.Resource("SelectASurface", l, c, d)
                            </label>
                            <select id="choose-surface"
                                    class="form-select"
                                    data-bind="keepElement: surface,
                                               options: availableSurfaces,
                                               optionsText: 'name',
                                               optionsValue: 'attributeId',
                                               optionsCaption: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("PleaseSelect", l, c, d))',
                                               value: surface,
                                               enable: true"
                                    disabled>
                                <option selected>
                                    @HtmlHelperExtra.Resource("PleaseSelect", l, c, d)
                                </option>
                                @foreach (var attribute in surfaces.Attributes)
                                {
                                    <option value="@(attribute.AttributeID)">
                                        @attribute.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="choose-finish" class="form-label d-flex justify-content-between align-items-center">
                                <span>
                                    @HtmlHelperExtra.Resource("SelectAFinish", l, c, d)
                                </span>
                                <a class="small"
                                   href="#finishes-explained-modal"
                                   data-bs-target="#finishes-explained-modal"
                                   data-bs-toggle="modal">
                                    @HtmlHelperExtra.Resource("FinishesExplained", l, c, d)
                                </a>
                            </label>
                            <select id="choose-finish"
                                    class="form-select"
                                    data-bind="keepElement: finish,
                                               options: availableFinishes,
                                               optionsText: 'name',
                                               optionsValue: 'attributeId',
                                               optionsCaption: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("PleaseSelect", l, c, d))',
                                               value: finish,
                                               enable: finishEnabled"
                                    disabled>
                                <option selected>
                                    @HtmlHelperExtra.Resource("PleaseSelect", l, c, d)
                                </option>
                                @foreach (var attribute in finishes.Attributes)
                                {
                                    <option value="@(attribute.AttributeID)">
                                        @attribute.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="choose-size" class="form-label d-flex justify-content-between align-items-center">
                                <span>
                                    @HtmlHelperExtra.Resource("SelectASize", l, c, d)
                                </span>
                            </label>
                            <select id="choose-size"
                                    class="form-select"
                                    data-bind="keepElement: size,
                                               options: availableSizes,
                                               optionsText: 'name',
                                               optionsValue: 'attributeId',
                                               optionsCaption: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("PleaseSelect", l, c, d))',
                                               value: size,
                                               enable: sizeEnabled"
                                    disabled>
                                <option selected>
                                    @HtmlHelperExtra.Resource("PleaseSelect", l, c, d)
                                </option>
                                @foreach (var attribute in sizes.Attributes)
                                {
                                    <option value="@(attribute.AttributeID)">
                                        @attribute.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    if (!Model.AllProductsUnavailable)
                    {
                        if (!Model.UseOrderFormGrouping)
                        {
                            <div data-bind="foreachInit: { data: orderFormGroups, createElement: createOrderFormGroup }">
                                <div data-init
                                     style="@(Model.AutoOpenPartNumber != Model.MainProduct.ProductCode ? "display: none" : "" )"
                                     class="order-form-group"
                                     data-bind="visible: $parent.visiblePaintProductIds().some(x => x === primaryProductId())">
                                    <span data-bind="init: { convert: parseInt }, text: primaryProductId, remove">
                                        @Model.MainProduct.ProductID
                                    </span>
                                    @Html.Partial("~/Views-New/ProductPages/Shared/_OrderFormItem.cshtml", Model.MainProduct)
                                </div>
                                @foreach (var op in Model.OtherProducts)
                                {
                                    <div data-init
                                         style="display: none"
                                         class="order-form-group"
                                         data-bind="visible: $parent.visiblePaintProductIds().some(x => x === primaryProductId())">
                                        <span data-bind="init: { convert: parseInt }, text: primaryProductId, remove">
                                            @op.ProductID
                                        </span>
                                        @Html.Partial("~/Views-New/ProductPages/Shared/_OrderFormItem.cshtml", op)
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            foreach (var ofg in Model.OrderFormGroups)
                            {
                                @Html.Partial("~/Views-New/ProductPages/Shared/_OrderFormGroup.cshtml", ofg)
                            }
                        }
                        if (autoOpen != null && Model.SamplePot != null)
                        {
                            <div data-bind="foreachInit: { data: samplePotOrderFormGroups, createElement: createOrderFormGroup }">
                                <div data-init
                                     class="order-form-group">
                                    @Html.Partial("~/Views-New/ProductPages/Shared/_OrderFormItem.cshtml", Model.SamplePot)
                                </div>
                            </div>
                        }
                    }
                }
            }
            <div id="product-page-accordion" class="my-3 accordion accordion-flush">
                <div class="accordion-item">
                    <h6 class="accordion-header" id="description-panel-heading">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#description-panel" aria-expanded="true" aria-controls="description-panel">
                            @HtmlHelperExtra.Resource("Description", l, c, d)
                        </button>
                    </h6>
                    <div id="description-panel" class="accordion-collapse collapse show" aria-labelledby="description-panel" data-bs-parent="#product-page-accordion">
                        <div class="accordion-body">
                            @Html.Raw(JObject.FromObject(Model.Definition.json).SelectToken("description"))
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h6 class="accordion-header" id="information-panel-heading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#information-panel" aria-expanded="false" aria-controls="information-panel">
                            @HtmlHelperExtra.Resource("Information", l, c, d)
                        </button>
                    </h6>
                    <div id="information-panel" class="accordion-collapse collapse" aria-labelledby="information-panel" data-bs-parent="#product-page-accordion">
                        <div class="accordion-body">
                            @if (JObject.FromObject(Model.Definition.json).SelectToken("attributes").Type != JTokenType.Null)
                            {
                                <dl class="grid">
                                    @foreach (var attribute in JObject.FromObject(Model.Definition.json).SelectToken("attributes").Children())
                                    {
                                        <dt>
                                            @(attribute.SelectToken("attributeGroup"))
                                        </dt>
                                        <dd>
                                            @(attribute.SelectToken("attribute"))
                                        </dd>
                                    }
                                </dl>
                            }
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h6 class="accordion-header" id="reviews-panel-heading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#reviews-panel" aria-expanded="false" aria-controls="reviews-panel">
                            @HtmlHelperExtra.Resource("Reviews", l, c, d)
                        </button>
                    </h6>
                    <div id="reviews-panel" class="accordion-collapse collapse" aria-labelledby="reviews-panel" data-bs-parent="#product-page-accordion">
                        <div class="accordion-body">
                            @if (!Model.Reviews.Any())
                            {
                                @HtmlHelperExtra.Resource("NoReviewsYet", l, c, d)
                            }
                            else
                            {
                                foreach (var r in Model.Reviews)
                                {
                                    <div class="card">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                @r.Date
                                            </h5>
                                            <h6 class="card-subtitle my-2">
                                                @r.ReviewStarsDisplay()
                                            </h6>
                                            <p class="card-text">
                                                @Html.Raw(r.Review)
                                            </p>
                                            <a href="@r.ReadMoreURL" target="_blank" rel="nofollow">
                                                @r.ReadMoreURL
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                @if (!String.IsNullOrEmpty(Model.Definition.delivery))
                {
                    <div class="accordion-item">
                        <h6 class="accordion-header" id="delivery-panel-heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#delivery-panel" aria-expanded="false" aria-controls="delivery-panel">
                                @HtmlHelperExtra.Resource("Delivery", l, c, d)
                            </button>
                        </h6>
                        <div id="delivery-panel" class="accordion-collapse collapse" aria-labelledby="delivery-panel" data-bs-parent="#product-page-accordion">
                            <div class="accordion-body">
                                @Html.Raw(Model.Definition.delivery)
                            </div>
                        </div>
                    </div>
                }
                @if (!String.IsNullOrEmpty(Model.Definition.deliveryHTMLSection))
                {
                    <div class="accordion-item">
                        <h6 class="accordion-header" id="delivery-html-section-panel-heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#delivery-panel" aria-expanded="false" aria-controls="delivery-panel">
                                @HtmlHelperExtra.Resource("Delivery", l, c, d)
                            </button>
                        </h6>
                        <div id="delivery-panel" class="accordion-collapse collapse" aria-labelledby="delivery-panel" data-bs-parent="#product-page-accordion">
                            <div class="accordion-body">
                                <div class="page-section html-section">
                                    @Html.Raw(Model.Definition.deliveryHTMLSection)
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <div class="accordion-item">
                    <h6 class="accordion-header" id="returns-panel-heading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#returns-panel" aria-expanded="false" aria-controls="returns-panel">
                            @HtmlHelperExtra.Resource("Returns", l, c, d)
                        </button>
                    </h6>
                    <div id="returns-panel" class="accordion-collapse collapse" aria-labelledby="returns-panel" data-bs-parent="#product-page-accordion">
                        <div class="accordion-body">
                            @Html.Raw(JObject.FromObject(Model.Definition.json).SelectToken("returns"))
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("~/Views-New/ProductPages/Shared/_CoverageCalculatorModal.cshtml", Model)
</div>
@if (!ViewBag.Partial && Model.RelatedProductPages.Any())
{
    @Html.Partial("~/Views-New/ProductPages/Shared/_RelatedProductPages.cshtml")
}
<div class="modal" tabindex="-1" id="finishes-explained-modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @HtmlHelperExtra.Resource("FinishesExplained", l, c, d)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.Raw(Model.PrefetchedSnippets.Single(s => s.SnippetLocationID == 85).HTMLContent)
            </div>
        </div>
    </div>
</div>
@if (Model.Definition.productTypeHtmlSection != null)
{
    <div class="page-section">
        <div class="html-section">
            @HtmlHelperExtra.ProcessHTMLSection(Model.Definition.productTypeHtmlSection, Model, Model.Definition.productTypeHtmlSectionImageHotspots)
        </div>
    </div>
}
@if (Model.ShowRecentlyViewed)
{
    @Html.Partial("~/Views-New/Shared/_RecentlyViewed.cshtml")
}
@if (Model.RelatedSearches.Any())
{
    @Html.Partial("~/Views-New/ProductPages/Shared/_RelatedSearches.cshtml", Model)
}