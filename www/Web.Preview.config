<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="FlockConnectionString"
      connectionString="Data Source=vm-sql;Initial Catalog=Flock;Persist Security Info=True;User ID=App_Flock-Preview;Password=4BB8BF42-158A-4C6F-A074-4835335C1D4C"
      xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    <add name="FlockIntegratedConnectionString"
      connectionString="Data Source=vm-sql;Initial Catalog=Flock;Integrated Security=SSPI;"
      xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
  </connectionStrings>
  <appSettings>
    <add key="productionVersion" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="logPageViews" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="enableProfiler" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="bannerCacheEnabled" value="false"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="bannerCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="landingCacheEnabled" value="false"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="landingCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="menuCacheEnabled" value="false"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="menuCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="resourceCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="resourceCacheDuration" value="5"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="productPageCacheEnabled" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="productPageCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="productPageGridCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="productPageGridCacheDuration" value="5" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="collectionProductPageGridCacheEnabled" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="collectionProductPageGridCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="contactDetailsCacheEnabled" value="false"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="contactDetailsCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="dotDigitalBehaviourProfileCacheEnabled" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="dotDigitalBehaviourProfileCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="scrapbookCacheEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="scrapbookCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="redirectCacheEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="redirectCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="hotspotsEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="hotspotCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="hotspotCacheDuration" value="15" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="searchCacheEnabled" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="searchCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="orderFormCacheEnabled" value="false"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="orderFormCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<sessionState xdt:Transform="Replace" mode="InProc" timeout="60" />
  </system.web>
    <system.webServer>
	    <handlers>
		    <!-- Ensure this line is present and NOT wrapped in a debug-only transform -->
		    <add name="MiniProfiler" path="profiler/*" verb="*" type="StackExchange.Profiling.MiniProfilerHandler, StackExchange.Profiling" preCondition="integratedMode" />
	    </handlers>
		<httpCompression>
			<scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
			<dynamicTypes>
				<add mimeType="text/*" enabled="true" />
				<add mimeType="application/json" enabled="true" />
			</dynamicTypes>
		</httpCompression>
    </system.webServer>
</configuration>