<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- 
  See https://github.com/nlog/nlog/wiki/Configuration-file 
  for information on customizing logging rules and outputs.
   -->
  <targets>
    <target xsi:type="File" name="MertexLoginChecksInfoTarget"
            fileName="${basedir}/Logs/MertexLoginChecks/Info/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Info_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/MertexLoginChecks/Info/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="MertexLoginChecksErrorTarget"
            fileName="${basedir}/Logs/MertexLoginChecks/Errors/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/MertexLoginChecks/Errors/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="MertexCheckoutChecksInfoTarget"
            fileName="${basedir}/Logs/MertexCheckoutChecks/Info/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Info_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/MertexCheckoutChecks/Info/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="MertexCheckoutChecksErrorTarget"
            fileName="${basedir}/Logs/MertexCheckoutChecks/Errors/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/MertexCheckoutChecks/Errors/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="upsInfoTarget"
            fileName="${basedir}/Logs/UPS/Info/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Info_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/UPS/Info/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="upsErrorTarget"
            fileName="${basedir}/Logs/UPS/Errors/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/UPS/Errors/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="infoTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Info_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="traceTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Trace_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="debugTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Debug_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}       ${message}${newline}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="warnTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Warnings_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}       ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="errorTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}       ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="fatalFileTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/${date:format=dd}/Fatalities_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target name="MertexLoginChecksFatalTarget" xsi:type="Mail"
      smtpServer="smtp.office365.com"
      smtpPort="587"
      smtpAuthentication="Basic"
      smtpUserName="portal.noreply@designersguild.com"
      smtpPassword="TheCakeIsALi3"
      enableSsl="true"
      from="portal.noreply@designersguild.com"
      to="tclark@designersguild.com"
      cc="mchristie@designersguild.com"
      subject="Mertex Login Check Fatal Error"
      body="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
    />
    <target name="MertexCheckoutChecksFatalTarget" xsi:type="Mail"
      smtpServer="smtp.office365.com"
      smtpPort="587"
      smtpAuthentication="Basic"
      smtpUserName="portal.noreply@designersguild.com"
      smtpPassword="TheCakeIsALi3"
      enableSsl="true"
      from="portal.noreply@designersguild.com"
      to="tclark@designersguild.com"
      cc="mchristie@designersguild.com"
      subject="Mertex Checkout Check Fatal Error"
      body="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
    />
    <target name="upsFatalTarget" xsi:type="Mail"
      smtpServer="smtp.office365.com"
      smtpPort="587"
      smtpAuthentication="Basic"
      smtpUserName="portal.noreply@designersguild.com"
      smtpPassword="TheCakeIsALi3"
      enableSsl="true"
      from="portal.noreply@designersguild.com"
      to="itsupport@designersguild.com"
      subject="Returns Error"
      body="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
    />
    <target name="braintreeTarget" xsi:type="Mail"
      smtpServer="smtp.office365.com"
      smtpPort="587"
      smtpAuthentication="Basic"
      smtpUserName="portal.noreply@designersguild.com"
      smtpPassword="TheCakeIsALi3"
      enableSsl="true"
      from="portal.noreply@designersguild.com"
      to="itsupport@designersguild.com"
      cc="tclark@designersguild.com;mchristie@designersguild.com"
      subject="URGENT: Website Error"
      body="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
    />
    <target name="checkoutEmailTarget" xsi:type="Mail"
      smtpServer="smtp.office365.com"
      smtpPort="587"
      smtpAuthentication="Basic"
      smtpUserName="portal.noreply@designersguild.com"
      smtpPassword="TheCakeIsALi3"
      enableSsl="true"
      from="portal.noreply@designersguild.com"
      to="itsupport@designersguild.com"
      cc="tclark@designersguild.com;mchristie@designersguild.com"
      subject="URGENT: Payment Taken, ORDER NOT GENERATED"
      body="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
    />
  </targets>

  <rules>
    <!-- add your logging rules here -->
    <logger name="MertexLoginChecks" level="Info" writeTo="MertexLoginChecksInfoTarget"/>
    <logger name="MertexLoginChecks" level="Error" writeTo="MertexLoginChecksErrorTarget"/>
    <logger name="MertexLoginChecks" level="Fatal" writeTo="MertexLoginChecksFatalTarget" final="true"/>
    <logger name="MertexCheckoutChecks" level="Info" writeTo="MertexCheckoutChecksInfoTarget"/>
    <logger name="MertexCheckoutChecks" level="Error" writeTo="MertexCheckoutChecksErrorTarget"/>
    <logger name="MertexCheckoutChecks" level="Fatal" writeTo="MertexCheckoutChecksFatalTarget" final="true"/>
    <logger name="UPSLogger" level="Info" writeTo="upsInfoTarget"/>
    <logger name="UPSLogger" level="Error" writeTo="upsErrorTarget"/>
    <logger name="UPSLogger" level="Fatal" writeTo="upsFatalTarget" final="true"/>
    <logger name="CheckoutLogger" level="Fatal" writeTo="checkoutEmailTarget" />
    <logger name="*" level="Info" writeTo="infoTarget" />
    <logger name="*" level="Trace" writeTo="traceTarget" />
    <logger name="*" level="Debug" writeTo="debugTarget" />
    <logger name="*" level="Warn" writeTo="warnTarget" />
    <logger name="*" level="Error" writeTo="errorTarget" />
    <logger name="*" level="Fatal" writeTo="fatalFileTarget" />
  </rules>
</nlog>