<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    In the example below, the "SetAttributes" transform will change the value of 
    "connectionString" to use "ReleaseSQLServer" only when the "Match" locator 
    finds an attribute "name" that has a value of "MyDB".
  -->
  <connectionStrings>
    <add name="FlockConnectionString"
      connectionString="Data Source=vm-sql1;Initial Catalog=Flock;Persist Security Info=True;User ID=WebServer;Password=B912DD5E-8821-40AA-B0E7-FB430783799C"
      xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    <add name="FlockIntegratedConnectionString"
      connectionString="Data Source=vm-sql1;Initial Catalog=Flock;Integrated Security=SSPI;"
      xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
  </connectionStrings>
  <appSettings>
    <add key="productionVersion" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="logPageViews" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="enableProfiler" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="enableNLogLogging" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="bannerCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="bannerCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="landingCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="landingCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="menuCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="menuCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="resourceCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="resourceCacheDuration" value="120"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="productPageCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="productPageCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="productPageGridCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="productPageGridCacheDuration" value="120" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="collectionProductPageGridCacheEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="collectionProductPageGridCacheDuration" value="120" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="contactDetailsCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="contactDetailsCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="dotDigitalBehaviourProfileCacheEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="dotDigitalBehaviourProfileCacheDuration" value="midnight"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="scrapbookCacheEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="scrapbookCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="redirectCacheEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="redirectCacheDuration" value="midnight" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="hotspotsEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="hotspotCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="hotspotCacheDuration" value="30" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="searchCacheEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="searchCacheDuration" value="60" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="orderFormCacheEnabled" value="true"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="orderFormCacheDuration" value="15" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      In the example below, the "Replace" transform will replace the entire 
      <customErrors> section of your web.config file.
      Note that because there is only one customErrors section under the 
      <system.web> node, there is no need to use the "xdt:Locator" attribute.
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>