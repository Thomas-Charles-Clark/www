@model ProductPageViewModel
@{
    var objMaster = Model.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var tradeUser = false;

    if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) &&
        Convert.ToBoolean(Session["tradeOrderingAllowed"]))
    {
        tradeUser = true;
    }
}
@if(Model.AlternateColourways.Count() > 1)
{
    <div class="my-3">
        <h5 class="text-uppercase pb-3">
            @HtmlHelperExtra.Resource("Colours", l, c, d) (@(Model.AlternateColourways.Count))
        </h5>
        <div class="grid alternate-colourway-grid mb-2">
            @foreach (var alternateColourway in Model.AlternateColourways

                .Skip(0).Take(8)
                .Select((value, index) => new { value, index }))
            {
                var ac = alternateColourway.value;
                var index = alternateColourway.index;
                <div class="@(ac.productPageId == Model.Definition.productPageId ? "active" : "")">
                    <a class="alternate-colourway-card ripple" href="@(Framework.URLFixup(ac.url))">
                        <div class="card">
                            <img class="card-img-top"
                                    width="156"
                                    height="156"
                                    alt="@(ac.heading)"
                                    title="@(ac.heading)"
                                    src="/image@(Framework.WebPFallback)/156/@(ac.imageId)"
                                    @HtmlHelperExtra.ImageSourceSetSizes(ac.imageId, ImageSize.One) />
                        </div>
                        <span class="visually-hidden">
                            @(ac.heading)
                            @(Model.Definition.subHeading)
                        </span>
                    </a>
                </div>
            }
        </div>
       @if (Model.AlternateColourways.Count > 8)
        {
            <div id="more-colourways" class="grid alternate-colourway-grid mb-2 collapse">
               @foreach (var alternateColourway in Model.AlternateColourways
                    .Skip(8)
                    .Select((value, index) => new { value, index }))
                {
                    var ac = alternateColourway.value;
                    var index = alternateColourway.index;
                    <div class="@(ac.productPageId == Model.Definition.productPageId ? "active" : "")">
                        <a class="alternate-colourway-card ripple" href="@(ac.url)">
                            <div class="card">
                                <img class="card-img-top"
                                        width="488"
                                        height="488"
                                        alt="@(ac.heading)"
                                        title="@(ac.heading)"
                                        src="/image@(Framework.WebPFallback)/488/@(ac.imageId)"
                                        @HtmlHelperExtra.ImageSourceSetSizes(ac.imageId, ImageSize.Two)
                                        loading="lazy"/>
                            </div>
                            <span class="visually-hidden">
                                @(ac.heading)
                                @(Model.Definition.subHeading)
                            </span>
                        </a>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-end">
                <button id="more-colourways-btn" class="btn btn-link" data-bs-toggle="collapse" data-bs-target="#more-colourways">
                    @HtmlHelperExtra.Resource("ShowAllColourways", l, c, d)
                </button>
            </div>
            <script>
                let colourwayPanel = document.getElementById('more-colourways');
                let colourwayButton = document.getElementById('more-colourways-btn');
                colourwayPanel.addEventListener('show.bs.collapse', () => {
                    colourwayButton.innerHTML = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ShowFewerColourways", l, c, d))';
                });
                colourwayPanel.addEventListener('hide.bs.collapse', () => {
                    colourwayButton.innerHTML = '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ShowAllColourways", l, c, d))';
                });
            </script>
        }
    </div>
    <div class="my-4">
        <hr />
    </div>
}