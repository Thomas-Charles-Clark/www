@model OrderFormItemViewModel
@{
    var l = Model.MasterDefinition.UrlBreakdown.countryDetails.LanguageID;
    var c = Model.MasterDefinition.UrlBreakdown.countryDetails.CountryID;
    var d = Model.MasterDefinition.UrlBreakdown.ContentDate;
    var cd = Model.MasterDefinition.UrlBreakdown.countryDetails;

    var tradeUser = Model.MasterDefinition.TradeAllowed;

    Model.IsHotspot = true;
}
<h5 class="hotspot-heading bg-light">
    @Model.BasketName
    @if (!String.IsNullOrEmpty(Model.AKAName))
    {
        <span class="fs-6 d-block mt-2">
            @(Model.AKAName)
        </span>
    }
    else
    {
        <span class="fs-6 d-block mt-2">
            Previously: @(Model.BasketName)
        </span>
    }
</h5>
@Html.Partial("~/Views-New/ProductPages/Shared/_OrderFormItem.cshtml", Model)