@if (!dgFramework.isPagePartOfCheckOutProcess(dgContentType.landingPage, Model.ContentID))
{
    <script>
        window.permittedMessageSources = [
            '@($"https://{Request.Url.Host}")',
            '@($"https://{Request.Url.Host}:{Request.Url.Port}")',
            'https://www.google.com',
            'https://checkout.paypal.com',
            'https://www.paypal.com',
            'https://assets.pinterest.com',
            'https://www.facebook.com',
            'https://www.youtube.com',
            'https://player.vimeo.com'
        ];
        window.addEventListener('message', (event) => {
            if (window.permittedMessageSources.indexOf(event.origin) == -1) {
                console.error(`window.message event rejected, origin did not exist in window.permittedMessageSources (saw "${event.origin})"`);
            } else {
                //console.trace(event.data);
                if (event.data.hasOwnProperty('hide')) {
                    let modalElement = document.getElementById(event.data.hide);
                    let modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modal.hide();
                    window.setTimeout(() => {
                        window.location.href = event.data.navigateTo;
                    }, 150);
                }
            }
        }, false);
    </script>
}