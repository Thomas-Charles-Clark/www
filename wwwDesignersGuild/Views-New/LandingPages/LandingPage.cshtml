<div id="ko-wrapper">
    @if (Model.ContentID != (int)dgFixedPage.checkoutSinglePage)
    {
        <div class="d-none" data-bind="remove, init: { convert: JSON.parse }, text: data">
            @Html.Encode(Html.Raw(JsonConvert.SerializeObject(Model)))
        </div>
        if (String.IsNullOrEmpty(Model.Definition.PageDetails.Heading))
        {
            <h4>
                @Model.Definition.PageDetails.Heading
            </h4>
        }
    }
    @if (Model.PageSections.Any())
    {
        <div class="page-section-grid grid">
            <!-- ko init: { field: pageSections, value: [@Html.Raw(String.Join(",", (Model.PageSections.Select(p => $"pageSectionViewModel('{p.PageSectionType}', resources, {(int?)p.BespokeContentPageSection})"))))] } --><!-- /ko -->
            @foreach (var pageSection in Model.PageSections.Select((section, index) => new { index, section }))
            {
                var section = pageSection.section;
                var index = pageSection.index;
                var sectionClass = section.PageSectionType.GetAttributeOfType<PageSectionClassAttribute>().ClassName;

                if (section.PageSection.PlatformSwitch == null ||
                   section.PageSection.PlatformSwitch == false && !dgFramework.IsMobileDevice() ||
                   section.PageSection.PlatformSwitch == true && dgFramework.IsMobileDevice())
                {
                    <div id="page-section-@(section.PageSection.PageSectionID)" class="@(section.PageSection.HalfWidth ? "g-col-12 g-col-lg-6" : "g-col-12") page-section @(sectionClass) @(section.PageSection.ViewportWidth ? "viewport-width" : "")">
                        <!-- ko with: pageSections[@(index)] -->
                        @if ((section.PageSection.TradeSwitch == null) ||
                         (section.PageSection.TradeSwitch == false && !tradeUser) ||
                         (section.PageSection.TradeSwitch == true && tradeUser))
                        {
                            var viewPath = section.PageSectionType.GetAttributeOfType<ViewPathAttribute>().ViewPath;

                            switch (section.PageSectionType)
                            {
                                case PageSectionType.Slideshow:
                                    @Html.Partial(viewPath, ((SlideshowPageSection)section.Definition).CarouselViewModel)
                                    break;
                                case PageSectionType.BespokeContent:
                                    if (section.BespokeContentPageSection != null)
                                    {
                                        var attr = section.BespokeContentPageSection.Value.GetAttributeOfType<ActionAttribute>();
                                        if (attr.RequiresBase)
                                        {
                                            @Html.Action(attr.Action, attr.Controller, Model)
                                        }
                                        else
                                        {
                                            @Html.Action(attr.Action, attr.Controller, Model.MasterDefinition)
                                        }
                                    }
                                    break;
                                default:
                                    @Html.Partial(viewPath, section)
                                    break;
                            }
                        }
                        <!-- /ko -->
                    </div>
                }
            }
        </div>
    }

    @if (Model.ContentID != (int)dgFixedPage.checkoutSinglePage)
    {
        if (Enum.TryParse<dgFixedPage>($"{objMaster.UrlBreakdown.ContentId}", out dgFixedPage dgFixedPage))
        {
            if (Enum.IsDefined(typeof(dgFixedPage), dgFixedPage))
            {
                if (dgFixedPage.HasAttributeOfType<PageSectionViewModelAttribute>())
                {
                    <!-- ko init: { field: fixedPage, value: pageSectionViewModel('@(dgFixedPage.GetAttributeOfType<PageSectionViewModelAttribute>().PageSectionType)', resources) } --><!-- /ko -->
                }
                if (dgFixedPage.HasAttributeOfType<ActionAttribute>())
                {
                    <!-- ko with: fixedPage -->
                    @Html.Action(dgFixedPage.GetAttributeOfType<ActionAttribute>().Action, dgFixedPage.GetAttributeOfType<ActionAttribute>().Controller, Model)
                    <!-- /ko -->
                }
            }
        }
    }
    else
    {
        if (Enum.TryParse<dgFixedPage>($"{objMaster.UrlBreakdown.ContentId}", out dgFixedPage dgFixedPage))
        {
            if (Enum.IsDefined(typeof(dgFixedPage), dgFixedPage))
            {
                if (dgFixedPage.HasAttributeOfType<ActionAttribute>())
                {
                    @Html.Action(dgFixedPage.GetAttributeOfType<ActionAttribute>().Action, dgFixedPage.GetAttributeOfType<ActionAttribute>().Controller, Model)
                }
            }
        }
    }
</div>
