    <script type="text/javascript">
        window.quickLookBusy = () => {
            let busyElement = document.getElementById('quick-look-loading');
            busyElement.style.display = 'flex';
            busyElement.classList.add('show');
        }
        window.quickLookUnbusy = () => {
            console.log('quickLookUnbusy')
