@if (!dgFramework.IsMobileDevice() && Model.SiteSectionID != 10 && Model.HasHeaderBanners && Model.ContentID != 0)
{
    <div class="grid header-banners mb-4">
        @foreach (var bl in Model.HeaderBanners)
        {
            var banner = bl.banners.OrderBy(b => b.sortOrder).FirstOrDefault();
            if (banner != null)
            {
                <div id="banner-@(banner.bannerId)"
                     class="g-col-4 banner banner-location-@(bl.id) text-center">
                    <a href="@banner.linkURL"
                       target="@(banner.newWindow ? "_blank" : "_self")"
                       title="@(banner.titleText)"
                       alt="@(banner.altText)"
                       class="header-banner @(banner.fontClass) btn btn-outline-light"
                       style="color: @(String.IsNullOrEmpty(banner.foregroundColour) ? "inherit" : banner.foregroundColour);
                              background-color: @(String.IsNullOrEmpty(banner.backgroundColour) ? "inherit" : banner.backgroundColour)">
                        @(banner.overlayText?.Replace(">", "").Trim())
                    </a>
                </div>
            }
            else
            {
                <div class="g-col-4 banner-location-@(bl.id)">

                </div>
            }
        }
    </div>
}
@if (!Request.QueryString.AllKeys.Contains("lifestyle"))
{
