@model LandingPageViewModel
@{
    var objMaster = Model.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var tradeUser = objMaster.TradeAllowed;
}
@section TemplateStyles {
    @if (Model.IncludesForm)
    {
        if (Model.RequiresKendoDatePicker)
        {
            @Render.StylesPreload("~/bundles/css/kendo-datepicker")
        }
        @Render.StylesPreload("~/bundles/css/forms")
    }
}
@section LateTemplateScripts {
    @Html.JsonLD("LandingPage", Model, Model.MasterDefinition.MetaDescription, Model.MasterDefinition.UrlBreakdown.countryDetails.CurrencyCode)

    @if (Model.IncludesForm)
    {
        @Render.ScriptDefer("~/bundles/js/jquery")
        @Render.Script("~/bundles/js/forms")
        if (Model.RequiresKendoDatePicker)
        {
            @Render.Script("~/bundles/js/kendo-datepicker")
        }
    }

    @Render.Script("~/bundles/js/landing-page")
}
