@model FixedPageViewModel_CheckoutLogin
@{
    var objMaster = Model.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;

    var tradeUser = objMaster.TradeAllowed;

    var nfi = new System.Globalization.CultureInfo(Model.CountryItem.DotNetCulture).NumberFormat;

    //var forceBusy = Model.OnlyShowTrade && Model.MasterDefinition.LoginStatus == dgLoginStatus.currentLogin;
}
@Render.Script("~/bundles/js/checkout-login-page")
<div id="ko-wrapper"
     class="container my-4">
    <div id="first-blocker"
         class="page-blocker"
         data-bind="
            flexVisible: checkoutLoginModel.busy,
            toggleOpacity: checkoutLoginModel.busy"
         @*style="display: @(forceBusy ? "flex" : "none");
                opacity: @(forceBusy ? "1.0" : "0.0")"*@
         >
        <div class="spinner-border"></div>
        <h4>
            @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
        </h4>
    </div>
    <h3 class="checkout-title text-center mb-4">
        @HtmlHelperExtra.Resource("TotalExcludingDelivery", l, c, d): @Model.SubTotal.ToString("C2", nfi)
    </h3>
    <p class="text-center my-3">
        @HtmlHelperExtra.Resource("HowWouldYouLikeToCheckout", l, c, d)
    </p>
    <div id="checkout-option-wrapper">
       @if (Model.OnlyShowTrade)
       {
            <div id="checkout-option-trade" class="checkout-option">
                <img width="512" height="37" title="@HtmlHelperExtra.Resource("DesignersGuild", l, c, d)" alt="@HtmlHelperExtra.Resource("DesignersGuildLogo", l, c, d)" 
                        src="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension)"
                        srcset="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension) 1x,
                                /Content/images/logo/dg-logo-b2b-1340-73@(Framework.WebpOrPngExtension) 2x,
                                /Content/images/logo/dg-logo-b2b-2680-145@(Framework.WebpOrPngExtension) 4x"
                        sizes="(max-width: 992px) 512px, (max-width: 1200px) 1024px, 2048px"/>
                <button class="btn btn-secondary proceed-btn" data-bind="click: checkoutLoginModel.invokeTradeLogin">
                    @HtmlHelperExtra.Resource("CheckoutTradeCheckout", l, c, d)
                </button>
            </div>
       }
       else
       {
           if (Model.PermitPayPal)
           {
                <div id="checkout-option-paypal" class="checkout-option">
                    <img src="https://www.paypalobjects.com/webstatic/mktg/Logo/pp-logo-200px.png" border="0" width="200" height="51" alt="@HtmlHelperExtra.Resource("PayWithPayPal", l, c, d)">
                    <a id="paypal-button" class="btn proceed-btn p-0"></a>
                </div>
           }
           if (Model.PermitAmazon)
           {
                <div id="checkout-option-amazon" class="checkout-option">
                    <img src="~/Content/images/checkout/amazon-pay.png" alt="@HtmlHelperExtra.Resource("PayWithAmazon", l, c, d)" />
                    <div id="amazon-button" class="btn proceed-btn p-0"></div>
                </div>
           }
           if (Model.PermitGuest || Model.PermitMember)
           {
                <div id="checkout-option-normal" class="checkout-option">
                    <img width="512" height="37" title="@HtmlHelperExtra.Resource("DesignersGuild", l, c, d)" alt="@HtmlHelperExtra.Resource("DesignersGuildLogo", l, c, d)" 
                        src="/Content/images/logo/dg-logo-512-37@(Framework.WebpOrPngExtension)"
                        srcset="/Content/images/logo/dg-logo-512-37@(Framework.WebpOrPngExtension) 1x,
                                /Content/images/logo/dg-logo-1024-73@(Framework.WebpOrPngExtension) 2x,
                                /Content/images/logo/dg-logo-2048-145@(Framework.WebpOrPngExtension) 4x"
                        sizes="(max-width: 992px) 512px, (max-width: 1200px) 1024px, 2048px"/>
                   @if (Model.MasterDefinition.LoginStatus == dgLoginStatus.currentLogin)
                    {
                        <a class="btn btn-lg btn-secondary proceed-btn"
                           href="javascript:;"
                           onclick="window.proceedToCheckout('@(dgCheckoutType.Member)')"
                           target="_self">
                            @HtmlHelperExtra.Resource("MemberCheckout", l, c, d)
                        </a>
                    } 
                    else 
                    {
                        <button class="btn btn-lg btn-secondary proceed-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#guest-member-login-modal">
                            @HtmlHelperExtra.Resource("CheckoutPayWithCard", l, c, d)
                        </button>
                    }
                </div>
           }
           if (Model.PermitTrade)
           {
                <div id="checkout-option-trade" class="checkout-option">
                    <img width="512" height="37" title="@HtmlHelperExtra.Resource("DesignersGuild", l, c, d)" alt="@HtmlHelperExtra.Resource("DesignersGuildLogo", l, c, d)" 
                            src="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension)"
                            srcset="/Content/images/logo/dg-logo-b2b-670-37@(Framework.WebpOrPngExtension) 1x,
                                    /Content/images/logo/dg-logo-b2b-1340-73@(Framework.WebpOrPngExtension) 2x,
                                    /Content/images/logo/dg-logo-b2b-2680-145@(Framework.WebpOrPngExtension) 4x"
                            sizes="(max-width: 992px) 512px, (max-width: 1200px) 1024px, 2048px"/>
                    <button class="btn btn-lg btn-secondary proceed-btn" data-bind="click: checkoutLoginModel.invokeTradeLogin">
                        @HtmlHelperExtra.Resource("CheckoutTradeCheckout", l, c, d)
                    </button>
                </div>
           }
       }
    </div>
    <p class="text-center mt-8">
        @HtmlHelperExtra.Resource("IfYouHaveAGiftVoucher", l, c, d)
    </p>
</div>

<div id="guest-member-login-modal"
     class="modal fade"
     tabindex="-1"
     data-bs-keyboard="false"
     data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="page-blocker" data-bind="toggleOpacity: checkoutLoginModel.busy()">
            <div class="spinner-border" role="status"></div>
            <h4>
                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
            </h4>
        </div>
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @HtmlHelperExtra.Resource("PayWithCard", l, c, d)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs nav-fill">
                    <li class="nav-item" role="presentation">
                        <button id="guest-tab-btn" 
                                class="nav-link active" 
                                type="button"
                                data-bs-toggle="tab"
                                data-bs-target="#guest-tab" 
                                role="tab"
                                aria-controls="guest-tab"
                                aria-selected="true">
                            @HtmlHelperExtra.Resource("Guest", l, c, d)
                        </button>
                        </li>
                    <li class="nav-item" role="presentation">
                        <button id="member-tab-btn" 
                                class="nav-link" 
                                type="button"
                                data-bs-toggle="tab"
                                data-bs-target="#member-tab" 
                                role="tab"
                                aria-controls="member-tab"
                                aria-selected="false">
                            @HtmlHelperExtra.Resource("Member", l, c, d)
                        </button>
                    </li>
                </ul>
                <div id="guest-or-member-tab-content"
                     class="tab-content">
                    <div id="guest-tab"
                         class="tab-pane fade show active"
                         role="tabpanel"
                         aria-labelledby="guest-tab-btn">
                        <div class="login-form-wrapper">
                            <div class="mb-3 w-100">
                                <label for="guest-email" class="form-label">
                                    @HtmlHelperExtra.Resource("RegistrationEmailLabel", l, c, d)
                                </label>
                                <input type="email"
                                       id="guest-email"
                                       name="guest-email"
                                       class="form-control"
                                       data-bind="keepElement: checkoutLoginModel.guestEmail,
                                                  textInput: checkoutLoginModel.guestEmail">
                            </div>
                        </div>
                        <a href="javascript:;"
                           class="btn btn-secondary w-100"
                           data-bind="css: { 'disabled': checkoutLoginModel.busy }, click: checkoutLoginModel.proceedAsGuest">
                            @HtmlHelperExtra.Resource("BasketProceedCheckout", l, c, d)
                        </a>
                    </div>
                    <div id="member-tab"
                         class="tab-pane fade show"
                         role="tabpanel"
                         aria-labelledby="member-tab-btn">
                        @Html.Partial("~/Views-New/LandingPages/FixedPages/_Login.cshtml", Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="address-failure-modal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @HtmlHelperExtra.Resource("Error", l, c, d)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="address-failure-text" class="mb-0"></p>
            </div>
        </div>
    </div>
</div>

<div id="amazon-failure-modal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @HtmlHelperExtra.Resource("Error", l, c, d)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    @HtmlHelperExtra.Resource("CheckoutAmazonFailureLogOut", l, c, d)
                </p>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    
    localStorage.removeItem('defaultToken'); @* Remove any previously saved card defaults *@
    localStorage.removeItem('selectedCard');

    $(document).ready(function () {

        if (getUrlParameter('a') == '0') {
            if (typeof (window.history.pushState) === 'function') {
                var url = [location.protocol, '//', location.host, location.pathname].join('');
                var stateObj = { path: url };
                history.pushState(stateObj, '', url);
            } else {
                window.location.href = url;
            }
            $("#amazon-failure-modal").modal('show');
        }

        if ($('.payment-type-selection').length == 1) {
            if ($('.payment-type-selection').first().hasClass('payment-type-selection-dg-trade')) {
                displayPaymentOptionTradeDialog();
            }
        }
    });

    function getUrlParameter(name) {
        name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
        var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
        var results = regex.exec(location.search);
        return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
    };

    function jumpToSessionExpired() {
        window.location.href = '@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.checkoutSessionExpired, ci)';
    }

    function resetTooltip(elementName) {
        $('#' + elementName).tooltip("close");
        $('#' + elementName).attr("title", "");
    }

    function setErrorTooltip(elementName, tooltipMessage) {
        $('#' + elementName).tooltip("option", "tooltipClass", "tooltip-input-error");
        $('#' + elementName).attr("title", tooltipMessage);
        $('#' + elementName).tooltip("open");
        window.setTimeout(function () { $('#' + elementName).tooltip("close"); resetTooltip(elementName); }, 5000);
    }

    function setSuccessTooltip(elementName, tooltipMessage) {
        $('#' + elementName).tooltip("option", "tooltipClass", "tooltip-input-okay");
        $('#' + elementName).attr("title", tooltipMessage);
        $('#' + elementName).tooltip("open");
        window.setTimeout(function () { $('#' + elementName).tooltip("close"); resetTooltip(elementName); }, 5000);
    }
    function requestPasswordReset() {

        if ($('#reset-email').val().length >= 5 && $('#reset-email').val().length <= 100) { }
        else {
            $("#reset-email").select();
            setErrorTooltip('reset-email', '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ManageAccountErrorEmail", l, c, d))');
            return;
        }

        $("#reset-busy").show();

        $.ajax({
            url: "/api/member/requestPasswordReset",
            type: "Post",
            cache: false,
            async: true,
            data: JSON.stringify({
                memberCountry: '@objMaster.UrlBreakdown.countryDetails.URL',
                Email: $('#reset-email').val()
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (data) {

                $("#reset-busy").hide();
                var dataElement = 'reset-email';
                resetTooltip(dataElement);

                if (data.handleErrorMessage === "EmailInvalidFormat") {
                    setErrorTooltip(dataElement, '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ManageAccountErrorEmailFormat", l, c, d))');
                    return;
                } else if (data.handleErrorMessage === "PasswordResetRequestEmailNotFound") {
                    setErrorTooltip(dataElement, '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("PasswordResetRequestEmailNotFound", l, c, d))');
                    return;
                }

                @*setSuccessTooltip(dataElement, '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("PasswordResetRequestEmailSent", l, c, d))');*@
                $('#reset-password-modal').modal('hide');
                $('#resetPasswordEmailWelcomeSuccess').show();
            },
            error: function (xhr, textStatus, errorThrown) {
                $("#reset-busy").hide();
                console.log('dg-passwordReset: ' + textStatus);
                alert('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("MajorError", l, c, d))');
            }
        });
    }



    //#region Pay by card
    function cardPaymentSelected() {
        @if (Session["loginStatus"].ToString() == dgLoginStatus.currentLogin.ToString())
        {
            @:proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Member)));
                                                }
        else
        {
            @:displayPaymentOptionDGDialog();
                                                }
    }

    function displayPaymentOptionDGDialog() {
        $('#paymentOptionDG').modal('show');
        window.setTimeout(function () {
            @if ((string)Session["loginStatus"] == dgLoginStatus.previousLogin.ToString())
            {
                @:window.setTimeout(function () { $('#pwcPassword').select(); }, 300);
            }
            else
            {
                @:$('#pwcGuestEmail').select();
            }
        }, 250);
    }

    function closePaymentOptionDGDialog() {
        $('#paymentOptionDG').modal('hide');
    }

    $("#closeOptionDGPopup").click(function () {
        closePaymentOptionDGDialog();
    });

    function payWithCard() {
        var password = $('#pwcPassword').val();

        var allowGuestCheckout = parseBool(@($"{Model.PermitGuest}"));

        if (allowGuestCheckout && !$('#pwcPassword').is(':visible')) {
            payAsGuest();
        }
        else {
            var email = $('#pwcEmail').val();

            if (email === null || email === "") {
                $('#spnEmailError').show();
                return;
            }

            payAsMember(@Html.Raw(Convert.ToInt32(webapiSignInAccountType.Member)));
        }
    }

    function payAsGuest() {
        $("#pwcLoginError").hide();

        // if checking out as a guest we check to see if the email address already belongs to a member
        var inputData = $('#pwcGuestEmail').val();
        $.ajax({
            url: "/api/member/doesEmailExist",
            type: "Post",
            cache: false,
            async: false,
            data: JSON.stringify({ memberEmail: inputData }),
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                if (data.handleErrorMessage === "checkoutBasketExpired") {
                    jumpToSessionExpired();
                    return;
                } else if (data.handleErrorMessage === "InvalidLogin") {
                    $("#pwcLoginError p").html('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("CheckoutLoginTradeInvalid", l, c, d))');
                    $("#pwcLoginError").show();
                    return;
                } else if (data.handleErrorMessage === "EmailInvalidFormat") {
                    $("#pwcLoginError p").html('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ManageAccountErrorEmailFormat", l, c, d))');
                    $("#pwcLoginError").show();
                    return;
                }

                closePaymentOptionDGDialog();
                proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Guest)), inputData);
            },
            error: function (xhr, textStatus, errorThrown) {
                console.log('dg-validateemail: ' + textStatus);
                alert('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("MajorError", l, c, d))');
            }
        });

    }

    function payAsMember(type) {
        var loginDetails = {
            countryId: getCountryID(),
            languageId: getLanguageID(),
            accountType: type
        }

        var isTrade = type === @Html.Raw(Convert.ToInt32(webapiSignInAccountType.Trade));
        if (isTrade) {
            loginDetails.memberEmail = $('#tradeEmail').val();
            loginDetails.memberPassword = $('#tradePassword').val();
            $("#tradeLoginError").hide();
        }
        else {
            loginDetails.memberEmail = $('#pwcEmail').val();
            loginDetails.memberPassword = $('#pwcPassword').val();
            $("#pwcLoginError").hide();
        }

        $.ajax({
            url: "/api/member/signin",
            type: "Post",
            cache: false,
            async: true,
            data: JSON.stringify(loginDetails),
            contentType: 'application/json; charset=utf-8',
            success: function (data) {

                if (data.handleErrorMessage === "InvalidLogin") {
                    if (isTrade) {
                        $("#tradeLoginError p").html('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("CheckoutLoginTradeInvalid", l, c, d))');
                        $("#tradeLoginError").show();
                    }
                    else {
                        $("#pwcLoginError p").html('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("CheckoutLoginTradeInvalid", l, c, d))');
                        $("#pwcLoginError").show();
                    }
                    return;
                } else if (data.handleErrorMessage === "checkoutBasketExpired") {
                    jumpToSessionExpired();
                    return;
                } else if (data.handleErrorMessage === "checkoutTradeInvalidPermission") {
                    var admins = $.map(data.tradeAccountModel.administrators, function (x) { return '<span class="display-block">' + x.FullName + '</span>';  })

                    $('#tradeLoginError .error-message').html('<span class="display-block">\
                            @HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("tradeLoginPermissionFailure1", l, c, d)):\
                    </span>\
                    <span id="trade-account-info" class="display-block">\
                        ' + data.tradeAccountModel.tradeAccountDetail.Code + ' - ' + data.tradeAccountModel.tradeAccountDetail.Name + '\
                    </span>\
                    <span class="display-block">\
                        @HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("tradeLoginPermissionFailure2", l, c, d)):\
                    </span>\
                    <span id="trade-account-admins">' + admins.join('') + '</span>');

                    $("#tradeLoginError").show();
                    return;
                }

                if (isTrade) {
                    closePaymentOptionTradeDialog();
                    proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Trade)));
                }
                else {
                    closePaymentOptionDGDialog();
                    proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Member)));
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                console.log('dg-checkoutsignin: ' + textStatus);
                alert('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("MajorError", l, c, d))');
            }
        });
    }

    //#endregion Pay by card

    //#region Pay by trade

    function displayPaymentOptionTradeDialog() {

       @if (Session["loginStatus"].ToString() == dgLoginStatus.currentLogin.ToString() && Session["memberTradeAccountID"] != null)
        {
            if (!Model.TradePermissionPlaceOrder)
            {

            }
            else 
            {
                @:proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Trade)));
            }
        }
        else
        {
            @:$('#paymentOptionTrade').modal('show');
        }
    }

    function closePaymentOptionTradeDialog() {
        $('#paymentOptionTrade').modal('hide');
    }

    $("#closeOptionTradePopup").click(function () {
        closePaymentOptionTradeDialog();
    });

    function payByTrade() {
        var email = $('#tradeEmail').val();

        if (email === null || email === "") {
            $('#spnTradeEmailError').show();
            return;
        }
        else
            $('#spnTradeEmailError').hide();

        var password = $('#tradePassword').val();

        payAsMember(@Html.Raw(Convert.ToInt32(webapiSignInAccountType.Trade)));
    }
    //#endregion Pay by trade

    function clickAmazonPayOption() {
        $("#amazon-button img").click();
    }

    function clickPayPalOption() {
        //$(".paypal-button").click();
    }

    function asyncCheckoutLog(type, detail) {
        $.ajax({
            url: '/api/checkout/asyncSaveCheckoutLog',
            type: 'POST',
            async: false,
            cache: false,
            data: {
                action: type,
                detail: detail || "no detail provided"
            },
            success: function (data) {
            },
            error: function (xhr, s, a) {
                console.log("braintree error logging failed");
            }
        });
    }

    function proceedToCheckout(checkoutType, email, token, shippingAddress) {
        $("#paymentSelectionLoading").show();

        if (document.querySelector('#guest-member-login-modal').style.display != 'block') {
            if (typeof window.pageModel === 'object' &&
                typeof window.pageModel.fixedPage === 'function' &&
                ko.unwrap(window.pageModel.fixedPage) != null) {
                window.pageModel.fixedPage().checkoutLoginModel.busy(true);
            } else {
                window.addFixedPageLoadFunction(() => {
                    window.pageModel.fixedPage().checkoutLoginModel.busy(true);
                });
            }
        }
        
        document.querySelectorAll('.proceed-btn').forEach(pb => {
            pb.setAttribute('disabled', true);
            pb.classList.add('disabled');
        });

        $.ajax({
            url: "/api/checkout/setCheckoutType",
            type: "Post",
            cache: false,
            async: true,
            data: JSON.stringify(
                {
                    checkoutType: checkoutType,
                    guestEmail: email,
                    token: token,
                    basketCountry: getSiteCountry(),
                    initialShippingAddress: shippingAddress
                }
            ),
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                if (data.error) {
                    switch (data.message) {
                        case 'checkoutBasketExpired':
                            window.showInfo(window.pageModel.fixedPage().resources['Sorry'], window.pageModel.fixedPage().resources['CheckoutExpired']);
                            break;
                        case 'invalidDeliveryAddress':

                            let message = '';

                            let siteCorrector = document.getElementById('site-corrector');

                            let pClasses = 'mb-3';
                            
                            if (siteCorrector) {

                                document.querySelector('#site-corrector p.d-flex').classList.add('flex-wrap');

                                document.querySelector('#site-corrector button.btn-close').remove();

                                siteCorrector.style.position = 'static';

                                siteCorrector.classList.add('mb-3');
                                 
                                ko.cleanNode(siteCorrector);

                                let siteCorrectorMarkup = siteCorrector.outerHTML;

                                document.querySelector('#body-inner').style['padding-top'] = 0;

                                siteCorrector.remove();

                                message += siteCorrectorMarkup;

                                pClasses = 'mt-5 mb-3';
                            }
                            
                            message += `<p class="${pClasses}">${window.pageModel.fixedPage().resources['CheckoutLoginInvalidDeliveryAddress'].replace('{siteCulture}', getSiteCountry().toUpperCase())}</p>`;

                            message += `<ul class="undotted-list mb-3"><li>${JSON.parse(data.additionalInfo).flatMap(c => c.Name).join('</li><li>')}</li></ul>`;

                            message += `${window.pageModel.fixedPage().resources['CheckoutLoginInvalidDeliveryAddress2']}`;

                            window.showInfo(window.pageModel.fixedPage().resources['Sorry'], message);

                            if (siteCorrector) {
                                ko.applyBindings(window.siteCorrectorModel, siteCorrector)
                            }
                            break;
                        default:
                            window.showError();
                            break;
                    }
                    document.querySelectorAll('.proceed-btn').forEach(pb => {
                        pb.removeAttribute('disabled');
                        pb.classList.remove('disabled');
                    });
                    window.pageModel.fixedPage().checkoutLoginModel.busy(false);
                } else {
                    window.location.href = data.redirect;
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                window.pageModel.fixedPage().checkoutLoginModel.busy(false);
                document.querySelectorAll('.proceed-btn').forEach(pb => {
                    pb.removeAttribute('disabled');
                    pb.classList.remove('disabled');
                });
                $("#paymentSelectionLoading").hide();
                console.log('dg-proceedToCheckout: ' + textStatus);
                window.showError();
            }
        });
    }

    function displayPaymentAddressError() {
        $("#paymentSelectionLoading").hide();

        var message = '@Html.Raw(HtmlHelperExtra.Resource("PaypalInvalidAddress", l, c, d).ToString())';

        var countries = getValidCountries();
        var countryStr = '';

        $.each(countries, function (i, country) {
            if (countries.length > 1 && i == countries.length - 1)
                countryStr += ' & '
            else if (i > 0) {
                countryStr += ', '
            }
            countryStr += country;
        });

        var error = message.replace('{Countries}', countryStr);

        $('#address-failure-text').html(error);
        $('#address-failure-modal').modal('show');
    }

    function hidePaymentAddressError() {
        $("#payment-address-error").hide('show');
    }

    function getValidCountries() {
        return @Html.Raw(Json.Encode(Model.CheckoutCountries));
    }

</script>

@if (Model.PermitPayPal && !Model.OnlyShowTrade)
{
    <script src="https://js.braintreegateway.com/web/3.68.0/js/client.min.js"></script>
    <script src="https://js.braintreegateway.com/web/3.68.0/js/paypal-checkout.min.js"></script>

    <script>
        braintree.client.create(
            {
                authorization: '@Model.BraintreeClientKey'
            },
            function (clientErr, clientInstance) {
                if (clientErr) {
                    notifyPaypalError(clientErr);
                    return;
                }
                braintree.paypalCheckout.create(
                    {
                        client: clientInstance
                    },
                    function (paypalCheckoutErr, paypalCheckoutInstance) {
                        if (paypalCheckoutErr) {
                            notifyPaypalError(paypalCheckoutErr);
                            return;
                        }

                        paypalCheckoutInstance.loadPayPalSDK({
                            intent: 'authorize',
                            currency: '@Model.Currency',
                            commit: false
                        }, function (loadPayPalSDKErr) {
                            if (loadPayPalSDKErr) {
                                notifyPayPalError(loadPayPalSDKErr);
                                return;
                            }

                            $("#paypal-button").empty();

                            paypal.Buttons({
                                fundingSource: paypal.FUNDING.PAYPAL,
                                commit: false,
                                createOrder: function () {
                                    return paypalCheckoutInstance.createPayment(
                                        {
                                            flow: 'checkout',
                                            intent: 'authorize',
                                            commit: false,
                                            amount: '@Model.SubTotal',
                                            currency: '@Model.Currency',
                                            enableShippingAddress: true
                                        }
                                    );
                                },
                                style: {
                                    label: 'paypal',
                                    color: 'gold',
                                    shape: 'rect',
                                    height: 50,
                                    tagline: true
                                },
                                onApprove: function (data) {
                                    return paypalCheckoutInstance.tokenizePayment(data, function (err, payload) {
                                        var details = payload.details;
                                        var ppAddress = details.shippingAddress;
                                        var address = {
                                            addressName: ppAddress.recipientName,
                                            addressLineOne: ppAddress.line1,
                                            addressLineTwo: ppAddress.line2,
                                            addressTown: ppAddress.city,
                                            addressCounty: ppAddress.state,
                                            addressPostCode: ppAddress.postalCode,
                                            addressCountryCode: ppAddress.countryCode,
                                            addressPhone: ""
                                        };
                                        proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Paypal)), details.email, payload.nonce, address);
                                    });
                                },
                                onCancel: function (data) {
                                },
                                onError: function (err) {
                                    notifyPaypalError(err);
                                }
                            }).render('#paypal-button');
                        });
                    });
            });

        function notifyPaypalError(error) {
            alert('@Html.Raw(HtmlHelperExtra.Resource("PayPalGenericError", l, c, d).ToString())');
        }
    </script>
}

@if (Model.PermitAmazon && !Model.OnlyShowTrade)
{
    <script>
        window.onAmazonLoginReady = function () {
            amazon.Login.setClientId('@Model.AmazonClientID');
        };

        window.onAmazonPaymentsReady = function () {
            // render the button here
            var authRequest;

            $("#amazon-button").empty();
            amazon.Login.logout(); // clear any cached data


            OffAmazonPayments.Button('amazon-button', '@Model.AmazonMerchantID', {
                type: "PwA",
                color: "Gold",
                size: "x-large",

                authorization: function () {
                    loginOptions = { scope: "profile payments:widget payments:shipping_address payments:billing_address", popup: true };
                    authRequest = amazon.Login.authorize(loginOptions, function (response) {
                        if (response.error) {
                            amazonSignInError();
                            return;
                        }

                        amazon.Login.retrieveProfile(response.access_token, function (profileResponse) {
                            if (profileResponse.success) {
                                var email = profileResponse.profile.PrimaryEmail;
                                proceedToCheckout(@Html.Raw(Convert.ToInt32(dgCheckoutType.Amazon)), email, response.access_token);
                            }
                            else
                                amazonSignInError();

                        });
                    });
                },
                onError: function (error) {
                    amazonSignInError();
                }
            });
        }

        function amazonSignInError()
        {
            alert('@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("AmazonSigninError", l, c, d))');
        }
    </script>

    <script type='text/javascript' src='@Html.Raw(Model.AmazonClientURL)' async></script>
}

@if (Model.OnlyShowTrade && Model.MasterDefinition.LoginStatus == dgLoginStatus.currentLogin)
{
    <script type="text/javascript">
        window.addLoadFunction(() => {
            window.proceedToCheckout('Trade');
        });
    </script>
} 