@model wwwDesignersGuild.Models.Checkout.CheckoutBraintreeParameters
@using wwwDesignersGuild.Models.Helper;
@{
    Layout = null;

    var l = Model.countryItem.LanguageID;
    var c = Model.countryItem.CountryID;
    var d = DateTime.Now;

    var acceptedCards = HtmlHelperExtra.Resource("BraintreeAcceptedCards", l, c, d);

    var postcode = HtmlHelperExtra.Resource("CheckoutBraintreePostalCode", l, c, d);

    var cardNumberLabel = HtmlHelperExtra.Resource("CheckoutBraintreeCardNumber", l, c, d);

    var cvvLabel = HtmlHelperExtra.Resource("CheckoutBraintreeCVV", l, c, d);

    var expiryDateLabel = HtmlHelperExtra.Resource("CheckoutBraintreeExpiry", l, c, d);

    var mm = HtmlHelperExtra.Resource("CheckoutBraintreeMM", l, c, d);

    var yyyy = HtmlHelperExtra.Resource("CheckoutBraintreeYYYY", l, c, d);
}

<div id="braintree-form-container" class="checkout-section-content" data-bind="with: paymentMethodFactory">
    <div id="braintree-checkout-credit-card-wrapper">
        <div class="d-flex mb-3">
            <label for="accepted-cards">
                @(acceptedCards)
            </label>
            <div id="accepted-cards">
                @if (Model.acceptVisa)
                {
                    <img src="~/Content/images/checkout/visa.png" class="braintree-accepted-card" />
                }
                @if (Model.acceptMasterCard)
                {
                    <img src="~/Content/images/checkout/mastercard.png" class="braintree-accepted-card" />
                }
                @if (Model.acceptAmex)
                {
                    <img src="~/Content/images/checkout/american_express.png" class="braintree-accepted-card" />
                }
                @if (Model.acceptDiscover)
                {
                    <img src="~/Content/images/checkout/discover.png" class="braintree-accepted-card" />
                }
                @if (Model.acceptMaestro)
                {
                    <img src="~/Content/images/checkout/maestro.png" class="braintree-accepted-card" />
                }
                @if (Model.acceptMaestroUK)
                {
                    <img src="~/Content/images/checkout/uk_maestro.png" class="braintree-accepted-card" />
                }
            </div>
        </div>
        <div class="d-flex mb-3">
            <label for="card-number">
                @(cardNumberLabel)
            </label>
            <div id="number" class="form-control"></div>
        </div>
        <div class="d-flex mb-3">
            <label for="expirationMonth">
                @(expiryDateLabel)</label>
            <div id="expirationMonth" class="form-control expiration"></div>
            <span class="mx-3">
                /
            </span>
            <div id="expirationYear" class="form-control expiration"></div>
        </div>
        <div class="d-flex mb-3">
            <label for="cvv">
                @(cvvLabel)
            </label>
            <div id="cvv" class="form-control"></div>
            <a class="material-icons cvv-hint pointer" title="@HtmlHelperExtra.Resource("CVVHintTitle", l, c, d)" data-bs-toggle="modal" href="#cvv-hint-modal">
                help_outline
            </a>
        </div>
        <div class="d-flex">
            <label for="postalCode">
                @(postcode)
            </label>
            <div id="postalCode" class="form-control"></div>
        </div>
        <!-- ko if: parent.checkoutType == 0 || parent.checkoutType == 2 -->
        <div class="form-check my-3">
            <input id="chkSaveCardForFuture"
                   class="form-check-input" 
                   type="checkbox"
                   data-bind="checked: saveCardDetails">
            <label for="chkSaveCardForFuture"
                   class="form-check-label">
                @HtmlHelperExtra.Resource("CheckoutSaveCardForFuture", l, c, d)
            </label>
        </div>
        <div class="form-check mb-3">
            <input id="lblMakeCardDefault"
                   class="form-check-input" 
                   type="checkbox"
                   data-bind="checked: makeCardDefault">
            <label for="lblMakeCardDefault"
                   class="form-check-label">
            @HtmlHelperExtra.Resource("CheckoutMyDefaultCard", l, c, d)
            </label>
        </div>
        <!-- /ko -->
    </div>
    <!-- ko if: parent.isMemberCheckout() -->
    <p class="mb-0">
        @HtmlHelperExtra.Resource("CheckoutWhySaveCard", l, c, d)
    </p>
    <!-- /ko -->

    <!-- ko if: braintreeFullyLoaded() --><!-- /ko -->
</div>