@model wwwDesignersGuild.Models.Classes.passCheckoutAddress
@{
    Layout = null;
    
    var l = Model.masterDefinition.UrlBreakdown.countryDetails.LanguageID;
    var c = Model.masterDefinition.UrlBreakdown.countryDetails.CountryID;
    var d = Model.masterDefinition.UrlBreakdown.ContentDate;
}

<div class="form-group">
    <div id="addressBookWidgetDiv"></div>
</div>
<div class="address-form" data-bind="with: deliveryAddressFactory.currentAddress">
    <div>
        <div class="grid mb-3"
             data-bind="validationOptions: { insertMessages: false }">
            <label for="delivery-phone"
                    class="g-col-12 g-col-lg-3 col-form-label">
                @HtmlHelperExtra.Resource("mobileNumber", l, c, d)
            </label>
            <div id="phone-container"
                 class="g-col-12 g-col-lg-6 gap-3 d-flex"
                 data-bind="css: { 'phone-confirmed': confirmed() }">
                <input name="delivery-phone"
                        x-name="addressPhone"
                        class="form-control"
                        data-bind="phoneInput, textInput: phone, keepElement: phone, css: controlClass, enable: deliveryOptionId() != 3" maxlength="20" />
                <button class="btn btn-success" style="text-transform: capitalize; display: none" data-bind="visible: parent.parent.paymentMethodFactory.amazonHappy() && phoneChanged(), click: phoneSave">
                    @HtmlHelperExtra.Resource("MoodboardSave", l, c, d)
                </button>
            </div>
        </div>
        <span class="validation-message text-danger" style="margin-top: 5px;" data-bind="validationMessage: phone"></span>
        <!-- ko if: initLateExtenders() --><!-- /ko -->
    </div>
    <div style="display: none;"
         class="phone-unsaved-changes mb-3"
         data-bind="visible: parent.parent.paymentMethodFactory.amazonHappy() && phoneChanged()">
        <span>
            @HtmlHelperExtra.Resource("MoodboardUnsavedChanges", l, c, d)
        </span>
    </div>
    <p id="phone-accuracy">
        @HtmlHelperExtra.Resource("ManagePhoneInstructions", l, c, d)
    </p>
</div>

<button id="amazon-address-book-edit" class="btn btn-flat pull-right" style="display: none; margin-top: 1em;" data-bind="click: paymentMethodFactory.amazonReturnToEdit">
    @HtmlHelperExtra.Resource("ManageAddressBookEdit", l, c, d)
</button>