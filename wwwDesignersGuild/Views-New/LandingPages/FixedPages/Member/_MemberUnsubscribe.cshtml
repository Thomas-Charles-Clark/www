@model FixedPageViewModel_MemberUnsubscribe
@{
    var objMaster = Model.MasterDefinition;

    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;
    var ci = objMaster.UrlBreakdown.countryDetails;
}
@Render.Script("~/bundles/js/member-unsubscribe")
@Render.StylesPreload("~/bundles/css/member-login-details")
@if (dgFramework.IsMobileDevice())
{
    @Render.StylesPreload("~/bundles/css/member-login-details-mobile")
}
@Html.Partial("~/Views-New/LandingPages/Shared/_KnockoutKendoComponents.cshtml", Model.BaseViewModel)
<script type="text/javascript">
    window.getUnsubscribeReasons = () => {
        return @(Html.Raw(JsonConvert.SerializeObject(Model.Definition.unsubscribeReasons)))
    }
    window.getEmail = () => {
        return '@(Model.Member?.Email)';
    }
    window.getEmailName = () => {
        return '@(Model.EmailName)';
    }
    window.getGuid = () => {
        return '@(Model.Guid)';
    }
</script>
<div data-bind="stopBinding">
    <div class="member-wrapper relative p-3 mt-4">
        <div class="page-blocker" style="display: flex; opacity: 1.0" data-bind="flexVisible: busy, toggleOpacity: busy">
            <div class="spinner-border"></div>
            <h4>
                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
            </h4>
        </div>
        <div style="display: none" data-bind="flexVisible: success" class="justify-content-center ">
            <div class="alert alert-success d-flex align-items-center mb-0">
                <i class="material-icons">
                    check
                </i>
                <p class="mb-0 ms-3">
                    @HtmlHelperExtra.Resource("UnsubscribeThankYou", l, c, d)
                </p>
            </div>
        </div>
        <div id="unsubscribe-wrapper" style="display: none;" class="justify-content-center" data-bind="flexVisible: !success()">
            <div class="section dark-grey-section">
                <h3 class="uppercase">
                    @HtmlHelperExtra.Resource("Unsubscribe", l, c, d)
                </h3>
                <div class="member-account-row section-body">
                    <div class="form-group" data-bind="with: email, validationOptions: { insertMessages: false }">
                        <label class="field-label">
                            @HtmlHelperExtra.Resource("FormsEmail", l, c, d)
                        </label>
                        <input id="email"
                               type="text"
                               class="form-control"
                               value="@(Model.Member?.Email)"
                               disabled
                               data-bind="enable: getEmail() == '', keepElement: observable, textInput: observable, charsRemaining: charsRemainingOptions, attr: { placeholder: $parent.resources.FormsEmail }" />
                    </div>
                    <div class="form-group">
                        <label class="field-label">
                            @HtmlHelperExtra.Resource("UnsubscribeYouDontHaveReason", l, c, d)
                        </label>
                        <select class="form-select" data-bind="value: unsubscribeReasonId, options: availableUnsubscribeReasons, optionsText: 'Reason', optionsValue: 'UnsubscribeReasonID', optionsCaption: resources.PleaseSelect"></select>
                    </div>
                    <span class="mt-3 d-flex justify-content-end">
                        <button class="btn btn-success" data-bind="click: () => { save(); }">
                            @HtmlHelperExtra.Resource("SubmitProperCase", l, c, d)
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>