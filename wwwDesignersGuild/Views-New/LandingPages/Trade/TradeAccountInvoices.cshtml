@model wwwDesignersGuild.Models.Trade.TradeAccountsInvoicesViewModel
@using wwwDesignersGuild.Models.Classes;
@using wwwDesignersGuild.Models.Helper;
@{
    var objMaster = Model.BaseViewModel.MasterDefinition;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var firstTab = 0;

    if (Request.QueryString.AllKeys.Contains("tab"))
    {
        switch (Request.QueryString["tab"])
        {
            case "outstandingInvoices":
                firstTab = 1;
                break;
            case "invoiceSearch":
                firstTab = 2;
                break;
            case "recentPayments":
                firstTab = 3;
                break;
            default:
                break;
        }
    }

    @* Checked 13/07/2022 *@
}

@*@Render.Script("~/bundles/js/datetimepicker")*@

@if (!String.IsNullOrEmpty(Model.heading))
{
    <div class="row">
        <div class="col-full header check">
            <h2>@(Model.heading)</h2>
        </div>
    </div>
}

@if (!Model.permission)
{
    <div class="alert alert-danger trade-message-warning">
        <h4>
            @HtmlHelperExtra.Resource("tradeLoginPermissionFailureAccounts", l, c, d)
            @(Model.tradeAccountModel.AccountDetails.Code) - @(Model.tradeAccountModel.AccountDetails.Name)
        </h4>
        <p>
            @HtmlHelperExtra.Resource("tradeLoginPermissionFailure2", l, c, d)
        </p>
        @foreach (var a in Model.tradeAccountModel.Administrators)
        {
            <p>
                @(a.FullName) <a href="mailto:@a.Email">@a.Email</a>
            </p>
        }
    </div>
}
else
{
    @Render.StylesPreload("~/bundles/css/trade")
    if (dgFramework.IsMobileDevice())
    {
        @Render.StylesPreload("~/bundles/css/trade-mobile")
    }
    @Html.Partial("~/Views-New/LandingPages/Shared/_KnockoutKendoComponents.cshtml", Model.BaseViewModel)

    <div data-bind="stopBinding">
        <div id="trade-wrapper">
            <div class="page-blocker" style="display: flex; opacity: 1.0" data-bind="remove">
                <div class="spinner-border"></div>
                <h4>
                    @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                </h4>
            </div>
            <div id="accounts-menu" style="display: none" data-bind="visible: true">
                <ul class="nav nav-pills"
                    role="tablist">
                    <li class="nav-item"
                        role="presentation">
                        <button type="button"
                                class="nav-link @(firstTab == 0 ? "active" : "")"
                                data-bs-toggle="tab"
                                data-bs-target="#account-balance"
                                role="tab">
                            @HtmlHelperExtra.Resource("AccountBalance", l, c, d)
                        </button>
                    </li>
                    <li class="nav-item"
                        role="presentation">
                        <button type="button"
                                class="nav-link @(firstTab == 1 ? "active" : "")"
                                data-bs-toggle="tab"
                                data-bs-target="#outstanding-invoices">
                            @HtmlHelperExtra.Resource("OutstandingInvoices", l, c, d)
                        </button>
                    </li>
                    <li class="nav-item"
                        role="presentation">
                        <button type="button"
                                class="nav-link @(firstTab == 2 ? "active" : "")"
                                data-bs-toggle="tab"
                                data-bs-target="#invoice-search">
                            @HtmlHelperExtra.Resource("InvoiceSearch", l, c, d)
                        </button>
                    </li>
                    <li class="nav-item"
                        role="presentation">
                        <button type="button"
                                class="nav-link @(firstTab == 3 ? "active" : "")"
                                data-bs-toggle="tab"
                                data-bs-target="#recent-payments">
                            @HtmlHelperExtra.Resource("RecentPayments", l, c, d)
                        </button>
                    </li>
                </ul>
                <div class="tab-content">
                    <div id="account-balance" class="tab-pane fade @(firstTab == 0 ? "show active" : "")">
                        <div class="page-blocker" data-bind="flexVisible: accountSummaryBusy, toggleOpacity: accountSummaryBusy">
                            <div class="spinner-border"></div>
                            <h6>
                                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                            </h6>
                        </div>
                        <select class="value-display" data-bind="value: valueDisplay, visible: accountSummary().ColumnHeadings.length > 1">
                            <option value="0">
                                @HtmlHelperExtra.Resource("Sterling", l, c, d)
                            </option>
                            <option value="1">
                                @HtmlHelperExtra.Resource("AccountCurrency", l, c, d)
                            </option>
                        </select>
                        <div id="account-summary-grid"
                             class="grid"
                             data-bind="with: accountSummary">
                            <div class="accounts-panel-inner">
                                <ul class="undotted-list">
                                    <li>
                                        <h5 class="accounts-title">
                                            @HtmlHelperExtra.Resource("AgeAnalysisByDocument", l, c, d)
                                        </h5>
                                        <h5 class="accounts-title" data-bind="text: ColumnHeadings[0]"></h5>
                                    </li>
                                    <!-- ko foreach: MonthsDocumentDate-->
                                    <li>
                                        <a href="javascript:;" data-bind="click: function () { $parentContext.$parent.accountSummaryDrilldown($parent.MonthsDocDateSelectionCriteria[$index()],
                                            '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ByDocumentDate", l, c, d)) - ' + $data, 'DocumentNumber') }">
                                            <span data-bind="text: $data"></span>
                                            <!-- ko if: $index() == $parent.MonthsDocumentDate.length - 2 -->
                                            *
                                            <!-- /ko -->
                                        </a>
                                        <span data-bind="text: formatNumber($parent.AmountBaseDocDate[$index()], 2), css: { 'text-danger': $parent.AmountBaseDocDate[$index()] < 0 }"></span>
                                    </li>
                                    <!-- ko if: $index() == $parent.MonthsDocumentDate.length - 1 -->
                                    <li>
                                        @HtmlHelperExtra.Resource("SummaryTotal", l, c, d):
                                        <span data-bind="text: formatNumber($parent.TotalBaseDoc, 2)"></span>
                                    </li>
                                    <!-- /ko -->
                                    <!-- /ko -->
                                </ul>
                                <i>
                                    * @HtmlHelperExtra.Resource("IncludesPriorInvoices", l, c, d)
                                </i>
                            </div>
                            <div class="accounts-panel-inner">
                                <ul class="undotted-list">
                                    <li>
                                        <h5 class="accounts-title">
                                            @HtmlHelperExtra.Resource("AgeAnalysisByDue", l, c, d)
                                        </h5>
                                        <h5 class="accounts-title" data-bind="text: ColumnHeadings[0]"></h5>
                                    </li>
                                    <!-- ko foreach: MonthsDueDate -->
                                    <li>
                                        <a href="javascript:;" data-bind="click: function () { $parentContext.$parent.accountSummaryDrilldown($parent.MonthsDueDateSelectionCriteria[$index()],
                                            '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("ByDueDate", l, c, d)) - ' + $data, 'DueDate') }">
                                            <span data-bind="text: $data"></span>
                                            <!-- ko if: $index() == 0 -->
                                            *
                                            <!-- /ko -->
                                        </a>
                                        <span data-bind="text: formatNumber($parent.AmountBaseDueDate[$index()], 2), css: { 'text-danger': $parent.AmountBaseDocDate[$index()] < 0 }"></span>
                                    </li>
                                    <!-- ko if: $index() == $parent.MonthsDueDate.length - 1 -->
                                    <li>
                                        @HtmlHelperExtra.Resource("SummaryTotal", l, c, d):
                                        <span data-bind="text: formatNumber($parent.TotalBaseDoc, 2)"></span>
                                    </li>
                                    <!-- /ko -->
                                    <!-- /ko -->
                                </ul>
                                <i>
                                    * @HtmlHelperExtra.Resource("IncludesSubsequentInvoices", l, c, d)
                                </i>
                            </div>
                        </div>
                        <!-- ko if: showAccountSummaryInvoicesResult() -->
                        <h6 class="accounts-title">
                            <span data-bind="text: accountSummaryGridTitle"></span>
                            <a data-bind="attr: { href: 'javascript:;' }, text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("DownloadToExcel", l, c, d))',
                                click: function () { accountSummaryDrilldownGrid.widget().saveAsExcel(); }"></a>
                        </h6>
                        <div class="accounts-grid" data-bind="kendoGrid: accountSummaryDrilldownGrid"></div>
                        <!-- /ko -->
                        <!-- ko if: showAccountSummaryOnAccountResult() -->
                        <h6 class="accounts-title">
                            <span data-bind="text: accountSummaryGridTitle"></span>
                            <a data-bind="attr: { href: 'javascript:;' }, text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("DownloadToExcel", l, c, d))',
                                click: function () { accountSummaryOnAccountDrilldownGrid.widget().saveAsExcel(); }"></a>
                        </h6>
                        <div class="accounts-grid" data-bind="kendoGrid: accountSummaryOnAccountDrilldownGrid"></div>
                        <!-- /ko -->
                    </div>
                    <div id="outstanding-invoices" class="tab-pane fade @(firstTab == 1 ? "show active" : "")" data-refresh="summary">
                        <div class="page-blocker" data-bind="flexVisible: outstandingInvoicesBusy, toggleOpacity: outstandingInvoicesBusy">
                            <div class="spinner-border"></div>
                            <h4>
                                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                            </h4>
                        </div>
                        <h6 class="accounts-title mt-0">
                            @HtmlHelperExtra.Resource("OutstandingInvoices", l, c, d)
                            <a data-bind="attr: { href: 'javascript:;' }, text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("DownloadToExcel", l, c, d))',
                                click: function () { outstandingInvoicesGrid.widget().saveAsExcel(); }"></a>
                        </h6>
                        <div data-bind="kendoGrid: outstandingInvoicesGrid"></div>
                    </div>
                    <div id="invoice-search" class="tab-pane fade @(firstTab == 2 ? "show active" : "")" data-refresh="invoice">
                        <div class="page-blocker" data-bind="flexVisible: invoiceSearchBusy, toggleOpacity: invoiceSearchBusy">
                            <div class="spinner-border"></div>
                            <h4>
                                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                            </h4>
                        </div>
                        <div class="invoice-search-controls" data-refresh="invoice">
                            <div>
                                <div class="select-group">
                                    <select class="form-select" data-bind="value: dateRangeType, options: dateRangeTypes, optionsValue: 'dateRangeTypeId', optionsText: 'name'"></select>
                                    <select class="form-select" data-bind="value: dateRange, options: dateRanges, optionsValue: 'dateRangeId', optionsText: 'name'"></select>
                                </div>
                                <!-- ko if: dateRange() == -1 -->
                                <div class="custom-date-wrapper">
                                    <label>
                                        @HtmlHelperExtra.Resource("FromProperCase", l, c, d)
                                    </label>
                                    <input id="custom-from-date" class="date-picker" data-bind="kendoDatePicker: customFromDatePicker, click: function () { customFromDatePicker.widget().open(); }" />
                                    <button type="button" class="btn btn-close" data-bind="click: function () { customFromDatePicker.clear(); }">
                                        <span class="visually-hidden">
                                            @HtmlHelperExtra.Resource("Clear", l, c, d)
                                        </span>
                                    </button>
                                    <span class="validation-message text-danger" data-bind="validationMessage: customFromDate"></span>
                                    <span class="validation-message text-danger" data-bind="validationMessage: fromPreceedsTo"></span>
                                </div>
                                <div class="custom-date-wrapper">
                                    <label>
                                        @HtmlHelperExtra.Resource("ToProperCase", l, c, d)
                                    </label>
                                    <input id="custom-to-date" class="date-picker" data-bind="kendoDatePicker: customToDatePicker, click: function () { customToDatePicker.widget().open(); }" />
                                    <button type="button" class="btn btn-close" data-bind="click: function () { customToDatePicker.clear(); }">
                                        <span class="visually-hidden">
                                            @HtmlHelperExtra.Resource("Clear", l, c, d)
                                        </span>
                                    </button>
                                    <span class="validation-message text-danger" data-bind="validationMessage: customToDate"></span>
                                    <span class="validation-message text-danger" data-bind="validationMessage: toFollowsFrom"></span>
                                </div>
                                <!-- /ko -->
                            </div>
                            <div>
                                <div class="input-group">
                                    <input type="text" class="form-control" data-bind="enterKey: performInvoiceSearch, textInput: searchTerm,
                                            attr: { placeholder: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("SearchByInvoice", l, c, d))' }" />

                                    <button class="btn btn-outline-secondary" data-bind="click: performInvoiceSearch">
                                        <span class="visually-hidden">
                                            @HtmlHelperExtra.Resource("EnterSearch", l, c, d)
                                        </span>
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <h6 class="accounts-title">
                            @HtmlHelperExtra.Resource("InvoiceSearch", l, c, d)
                            <a data-bind="attr: { href: 'javascript:;' }, text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("DownloadToExcel", l, c, d))',
                                click: function () { invoiceSearchGrid.widget().saveAsExcel(); }"></a>
                        </h6>
                        <div data-bind="kendoGrid: invoiceSearchGrid"></div>
                    </div>
                    <div id="recent-payments" class="tab-pane fade @(firstTab == 3 ? "show active" : "")" data-refresh="recent">
                        <div class="page-blocker" data-bind="flexVisible: recentPaymentsBusy, toggleOpacity: recentPaymentsBusy">
                            <div class="spinner-border"></div>
                            <h4>
                                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                            </h4>
                        </div>
                        <h6 class="accounts-title mt-0">
                            @HtmlHelperExtra.Resource("RecentPayments", l, c, d)
                            <a data-bind="attr: { href: 'javascript:;' }, text: '@HtmlHelperExtra.EscapeForJS(HtmlHelperExtra.Resource("DownloadToExcel", l, c, d))',
                                click: function () { invoiceSearchGrid.widget().saveAsExcel(); }"></a>
                        </h6>
                        <div data-bind="kendoGrid: recentPaymentsGrid"></div>
                    </div>
                </div>
            </div>
            <div id="order-detail-modal" class="modal fade">
                <div class="modal-dialog modal-lg modal-xl modal-fullscreen-lg-down">
                    <div class="modal-content">
                        <div class="page-blocker" data-bind="flexVisible: panBusy, toggleOpacity: panBusy">
                            <div class="spinner-border"></div>
                            <h4>
                                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                            </h4>
                        </div>
                        <div class="modal-header">
                            <h4 class="modal-title">
                                @HtmlHelperExtra.Resource("OrderDetails", l, c, d):
                                <span data-bind="text: orderDetailsOrderNumber"></span>
                            </h4>
                            <button type="button" class="btn btn-close" aria-label="Close" data-bind="click: hideOrderDetailModal"></button>
                        </div>
                        <div class="modal-body">
                            <dl class="grid">
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("OrderDate", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="with: orderDetailsOrderDate">
                                    <span data-bind="text: kendo.toString(new Date($data), 'D')"></span>
                                </dd>
                            </dl>
                            <dl class="grid" data-bind="with: orderDetailsDeliveryInfo">
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("DeliveryName", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="text: DeliveryName || '&nbsp;'"></dd>
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("FormsAddressLineOne", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="text: AddressLine1 || '&nbsp;'"></dd>
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("FormsAddressLineTwo", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="text: AddressLine2 || '&nbsp;'"></dd>
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("FormsTown", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="text: AddressLine3 || '&nbsp;'"></dd>
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("FormsCounty", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="text: AddressLine4 || '&nbsp;'"></dd>
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("FormsPostCode", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="text: PostalCode || '&nbsp;'"></dd>
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("FormsPhoneNumber", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="text: PhoneNumber || '&nbsp;'"></dd>
                                <dt class="g-col-3">
                                    @HtmlHelperExtra.Resource("Haulier", l, c, d)
                                </dt>
                                <dd class="g-col-9"
                                    data-bind="text: HaulierDescription"></dd>
                            </dl>
                            <div data-bind="kendoGrid: ordersDetailsGrid"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="tracking-modal" class="modal fade">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="page-blocker" data-bind="flexVisible: trackingBusy, toggleOpacity: trackingBusy">
                            <div class="spinner-border"></div>
                            <h4>
                                @HtmlHelperExtra.Resource("PleaseWait", l, c, d)
                            </h4>
                        </div>
                        <div class="modal-header">
                            <button type="button" class="close" aria-label="Close" data-bind="click: hideTrackingModal">
                                <span aria-hidden="true">&times;</span>
                            </button>
                            <h4 class="modal-title">
                                @HtmlHelperExtra.Resource("Order", l, c, d):
                                <span data-bind="text: trackingOrderNumber"></span>
                                -
                                @HtmlHelperExtra.Resource("TrackingInformation", l, c, d)
                            </h4>
                        </div>
                        <div class="modal-body">
                            <ul class="list-group margin-bottom-0">
                                <!-- ko foreach: trackingResults -->
                                <li class="list-group-item">
                                    <label class="display-block" data-bind="text: Parcel"></label>
                                    <span class="display-block" data-bind="text: ProductCodes"></span>
                                    <span class="display-block" data-bind="text: Descriptions"></span>
                                    <a class="display-block" data-bind="attr: { href: TrackingURL }, text: TrackingURL"></a>
                                </li>
                                <!-- /ko -->
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function getAccountSummary() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.accountSummary));
        }

        function getOutstandingInvoices() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.outstandingInvoices.Invoices));
        }

        function getAccountBalance() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.outstandingInvoices.OnAccountTotal));
        }

        function getRecentPayments() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.recentPayments.PaymentsOnAccount));
        }
    </script>

    @Render.Script("~/bundles/js/trade-invoices")
}