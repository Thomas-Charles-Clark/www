<script id="trade-address-template" type="text/html">
    <!-- ko if: displayHeading -->
    <h4>
        @HtmlHelperExtra.Resource("Addresses", l, c, d)
    </h4>
    <!-- /ko -->
    <!-- ko if: displayInvoice -->
    <div class="form-group">
        <label class="field-label">
            @HtmlHelperExtra.Resource("ManageAccountTradeInvoiceAddress", l, c, d)
            <a href="javascript:;" class="pull-right" data-bind="click: requestInvoiceAddressChange">
                @HtmlHelperExtra.Resource("ManageAccountTradeInvoiceAddressRequestChange", l, c, d)
            </a>
        </label>
        <div data-bind="with: invoiceAddress">
            <div data-bind="html: displayBlock"></div>
            <!-- ko if: typeof $parent.selectFunction === 'function' -->
            <!-- ko if: $parent.selectPermitted($data) -->
            <button class="btn btn-secondary address-select-button" data-bind="click: $parent.selectFunction">
                @HtmlHelperExtra.Resource("FindAddressSelectAddress", l, c, d)
            </button>
            <!-- /ko -->
            <!-- /ko -->
        </div>
        <div id="invoice-address-change-requested" style="display: none" class="alert alert-success">
            <h4 class="alert-title">
                @HtmlHelperExtra.Resource("ThankYou", l, c, d)
            </h4>
            <p class="mb-0">
                @HtmlHelperExtra.Resource("YourRequestHasBeenRecorded", l, c, d)
            </p>
        </div>
        <div style="display: none;" data-bind="component: { name: 'mdc-address-search-component', params: invoiceAddressSearch }"></div>
    </div>
    <!-- /ko -->
    <div class="form-group">
        <button class="btn btn-secondary d-block w-100 mb-3" data-bind="click: function () { addressSearch.showEditModal(true); }">
            @HtmlHelperExtra.Resource("ManageAccountTradeAddDeliveryAddress", l, c, d)
        </button>
        @*<label class="d-block my-3">
                @HtmlHelperExtra.Resource("ManageAccountTradeDeliveryAddresses", l, c, d)
            </label>*@
        <div class="relative">
            <div data-bind="component: { name: 'mdc-address-search-component', params: addressSearch }"></div>
        </div>
    </div>
</script>

