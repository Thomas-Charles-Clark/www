    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var tradeUser = false;

    if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) &&
        Convert.ToBoolean(Session["tradeOrderingAllowed"]))
    {
        tradeUser = true;
    }

}<script type="text/javascript" defer>
    document.querySelectorAll('.carousel').forEach(c => {
        c.addEventListener('slide.bs.carousel', (event) => {
            document.querySelectorAll(`[data-bs-target="#${event.target.id}"]`).forEach(b => {
                b.classList.remove('active');
            });
            let active = document.querySelector(`[data-bs-target="#${event.target.id}"][data-bs-slide-to="${event.to}"]`);
            if (active)
                active.classList.add('active');
        });
    });
