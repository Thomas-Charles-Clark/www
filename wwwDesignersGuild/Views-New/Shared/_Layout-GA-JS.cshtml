@{
    var tradeOrderingAllowed = Convert.ToBoolean(Session["tradeOrderingAllowed"]);
    var tradeUser = false;

    var objMaster = Model.MasterDefinition;
    var cd = objMaster.UrlBreakdown.countryDetails;
    var contentId = objMaster.UrlBreakdown.ContentId;
    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) == true && tradeOrderingAllowed)
    {
        tradeUser = true;
    }
}

<script type="text/javascript">
    window.addLoadFunction(() => {
        let home = window.location.pathname == '/',
            product = document.querySelector('#product-page-main') != null,
            cart = window.location.pathname.endsWith('/l201'),
            category = document.querySelectorAll('.product-page-grid-section').length > 0,
            id = '',
            price = '',
            pagetype = 'other';

        if (home) {
            pagetype = "home"

        } else if (category) {
            pagetype = "category"

        } else if (product) {
            pagetype = "product"
            if (document.querySelector('#product-page-order-form-wrappper')) {
                id = [...document.querySelector('#product-page-order-form-wrapper').querySelectorAll('.product-code')].map(e => e.innerHTML.trim());

                price = [...document.querySelector('#product-page-order-form-wrapper').querySelectorAll('.product-price')].map(e => {
                    let result = Number((e.innerHTML.trim().replace(/\s*[^\s\-0-9.]/g, '') / 100) * 100).toFixed(2);

                    if (result == 0) {
                        let f = -1;
                    }

                    return result;
                });
            }
        }

        if (cart) {
            if (typeof window.basketMaintenanceModel === 'object') {
                function basketPageVisit () {
                    pagetype = "cart"

                    id = [...document.querySelectorAll('.product-code')].map(e => e.innerHTML.trim());

                    price = Number((document.querySelector('#basket-subtotal').innerHTML.trim().replace(/\s*[^\s\-0-9.]/g, '') / 100) * 100).toFixed(2);

                    let google_tag_params = {
                        ecomm_prodid: id,
                        ecomm_pagetype: pagetype,
                        ecomm_totalvalue: price
                    };

                    if (typeof gtag === 'function') {
                        let data = {
                            'send_to': 'default',
                            'event_label': google_tag_params.ecomm_pagetype,
                            'dimension1': google_tag_params.ecomm_prodid,
                            'dimension2': google_tag_params.ecomm_pagetype,
                            'dimension3': google_tag_params.ecomm_totalvalue,
                            'retail_or_trade': '@(tradeUser ? "trade" : "retail")',
                            'non_interaction': true
                        };
                        console.log('gtag is pushing page_visit with', data);
                        gtag('event', 'page_visit', data);
                    }
                }

                if (window.basketMaintenanceModel.ready()) {
                    basketPageVisit()
                } else {
                    window.basketMaintenanceModel.ready.subscribe(nv => basketPageVisit());
                }
            }
        } else {
            let google_tag_params = {
                ecomm_prodid: id,
                ecomm_pagetype: pagetype,
                ecomm_totalvalue: price
            };

            if (typeof gtag === 'function') {
                let data = {
                    'send_to': 'default',
                    'event_label': google_tag_params.ecomm_pagetype,
                    'dimension1': google_tag_params.ecomm_prodid,
                    'dimension2': google_tag_params.ecomm_pagetype,
                    'dimension3': google_tag_params.ecomm_totalvalue,
                    'retail_or_trade': '@(tradeUser ? "trade" : "retail")',
                    'non_interaction': true
                };
                console.log('gtag is pushing page_visit with', data);
                gtag('event', 'page_visit', data);
            }
        }
    });

    window.gTagAddToCart = (basketItem, quantity) => {
        if (typeof gtag === 'function') {
            let price = ko.unwrap(basketItem.priceOverride);

            if (price == null) {
                price = ko.unwrap(basketItem.displaySalePrice);
                if (price == null) {
                    price = ko.unwrap(basketItem.displayPrice);
                    if (price == null) {
                        price = ko.unwrap(basketItem.Price);
                    }
                }
            }

            var data = {
                "currency": getCurrencyCode(),
                "value": +(+ko.unwrap(price) * +ko.unwrap(basketItem.quantity)),
                "items": [{
                    "item_id": ko.unwrap(basketItem.code) || ko.unwrap(basketItem.Code),
                    "item_name": ko.unwrap(basketItem.name || basketItem.BasketName),
                    "quantity": ko.unwrap(quantity),
                    "price": +ko.unwrap(price)
                }]
            };
            console.log('gtag is pushing add_to_cart with', data);
            gtag('event', 'add_to_cart', data);
        }
    }

    window.gTagRemoveFromCart = (basketItem, quantity, onComplete) => {
        if (typeof gtag === 'function') {

            let price = ko.unwrap(basketItem.displaySalePrice);

            if (price == null) {
                price = ko.unwrap(basketItem.displayPrice);
                if (price == null) {
                    price = ko.unwrap(basketItem.Price);
                }
            }

            var data = {
                "items": [{
                    "item_id": ko.unwrap(basketItem.code) || ko.unwrap(basketItem.Code),
                    "item_name": ko.unwrap(basketItem.name || basketItem.BasketName),
                    "quantity": ko.unwrap(quantity),
                    "price": +ko.unwrap(price)
                }],
                "value": +(+ko.unwrap(price) * +ko.unwrap(quantity)),
                'event_callback': onComplete
            };
            console.log('gtag is pushing remove_from_cart with', data);
            gtag('event', 'remove_from_cart', data);
        }
    }

    window.gTagViewList = (definition, items, onComplete) => {
        if (typeof gtag === 'function') {
            var data = {
                'item_list_id': `PageSectionID: ${definition.PageSectionID}`,
                'item_list_name': `${definition.Name}`,
                'items': items.map((i, index) => {
                    let item = {
                        'item_id': `ProductPageID: ${i.ProductPageID}`,
                        'item_name': i.Heading,
                        'index': index,
                        'price': i.ProductPagePrice?.PriceMax,
                        'quantity': 1
                    }
                    if (i.ProductPagePrice?.SalePriceMax) {
                        item.discount = i.ProductPagePrice.SalePriceMax
                    }
                    return item;
                })
            }

            console.log('gtag is pushing view_item_list with', data);
            gtag('event', 'view_item_list', data);
        }
    }
</script>

