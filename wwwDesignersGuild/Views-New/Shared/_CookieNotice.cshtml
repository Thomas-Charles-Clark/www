@model BaseViewModel
@{ 
    var objMaster = Model.MasterDefinition;
    var cd = objMaster.UrlBreakdown.countryDetails;
    var contentId = objMaster.UrlBreakdown.ContentId;
    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var tradeUser = false;

    if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) &&
        Convert.ToBoolean(Session["tradeOrderingAllowed"]))
    {
        tradeUser = true;
    }
}
<div id="cookie-notice"
     class="d-none p-3"
     data-bind="toggleOpacity: visible">
    <p class="p-3">
        <span>
            @HtmlHelperExtra.Resource("CookieNoticeBlunt", l, c, d)
        </span>
        <span class="small d-block">
            <span>
                @HtmlHelperExtra.Resource("CookieNoticeLearnMore", l, c, d)
            </span>
            <a href="@dgFramework.buildUrl(dgContentType.landingPage, (int)dgFixedPage.privacyPolicy, cd)">
                @HtmlHelperExtra.Resource("ByReadingOurPrivacyPolicyHere", l, c, d)
            </a>
        </span>
    </p>
    <button class="btn btn-secondary"
            data-bind="click: accept">
        @HtmlHelperExtra.Resource("OkCapitalised", l, c, d)
    </button>
</div>
@Render.ScriptDefer("~/bundles/js/cookie-notice")