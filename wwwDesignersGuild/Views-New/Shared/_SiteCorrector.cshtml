@model BaseViewModel
@{ 
    var objMaster = Model.MasterDefinition;
    var cd = objMaster.UrlBreakdown.countryDetails;
    var contentId = objMaster.UrlBreakdown.ContentId;
    var l = objMaster.UrlBreakdown.countryDetails.LanguageID;
    var c = objMaster.UrlBreakdown.countryDetails.CountryID;
    var d = objMaster.UrlBreakdown.ContentDate;

    var tradeUser = false;

    if (Convert.ToBoolean(Session["memberTradeChecksPassed"]) &&
        Convert.ToBoolean(Session["tradeOrderingAllowed"]))
    {
        tradeUser = true;
    }
}
@if (!Model.UserInCorrectSite && !Model.CountryCorrectorDismissed && String.IsNullOrEmpty(Model.Partial))
{
    <div id="site-corrector"
         class="alert alert-primary p-0 mb-0">
        <div class="container">
            <p class="d-flex align-items-center justify-content-center px-1 py-3 gap-3 mb-0">
                <span class="d-block">
                    @HtmlHelperExtra.Resource("SiteCorrectorNoticeOne", l, c, d)
                </span>
                <select class="form-select"
                        data-bind="init: { convert: parseString }, value: siteSelection">
                   @foreach(var item in Model.CorrectSitesForUser.Select((s, i) => new { site = s, index = i }))
                    {
                        <option value="@item.site.URL" @(item.index == 0 ? "selected" : "")>
                            @item.site.Name - @item.site.LanguageCode.ToUpperInvariant()
                        </option>
                    }
                    <option value="country-picker">
                        @HtmlHelperExtra.Resource("OtherCountryOrRegion", l, c, d)
                    </option>
                </select>
                <button class="btn btn-secondary" data-bind="click: changeSite">
                    @HtmlHelperExtra.Resource("ContinueProperCase", l, c, d)
                </button>
                <button class="btn-close"
                        data-bind="click: dismiss">
                </button>
            </p>
        </div>
    </div>
    @Render.Script("~/bundles/js/site-corrector")
}